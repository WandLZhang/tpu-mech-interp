index 00000000..32975ca4
--- /dev/null
+++ b/test/srt/test_return_hidden_states_cpu.py
@@ -0,0 +1,1044 @@
+"""--enable-return-hidden-states through the real Engine, on CPU, with a tiny random model.
+
+    JAX_PLATFORMS=cpu python3 test/srt/test_return_hidden_states_cpu.py
+
+The model is a four-layer Qwen3 with random weights, written into a temporary directory, so the
+test needs no download and no chip. Each scenario starts its own Engine in a child process. A
+request that stops the server then fails its own test and not the whole run, and the test can
+read the scheduler's log.
+
+The contract under test: row i of a request's hidden states is position i. Prefill chunks
+arrive as [tokens, layers, hidden] and cover the prompt. Each decode step adds one
+[layers, hidden] chunk. A request returns prompt_tokens + completion_tokens - 1 rows, because
+no forward pass reads the last token it generates. Where a check compares values, it compares
+against the same prompt run alone, so a row filed under the wrong position fails even when the
+count is right. With --return-hidden-states-layers the layer axis holds the slots it names, in
+ascending order, and each equals the same slot of a server that returns every slot.
+"""
+
+import argparse
+import asyncio
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+import numpy as np
+
+HERE = os.path.abspath(__file__)
+LAYERS = 4
+VOCAB = 512
+# Rows computed in different batches go through different padded shapes, which moves a float32
+# sum by a few ulp. A row filed under the wrong position misses by far more.
+ROW_TOL = 1e-4
+# The slots the filter test keeps: slot 0, where residual is None, and the last slot.
+KEPT_SLOTS = [0, 3]
+
+
+# --------------------------------------------------------------------------------------
+# the tiny model
+# --------------------------------------------------------------------------------------
+
+
+def write_tiny_model(path, arch="qwen3", seed=0):
+    """A random-weight checkpoint in the HuggingFace layout the loader reads.
+
+    qwen3 carries the layers_to_capture hook and qwen2 doesn't.
+    """
+    from safetensors.numpy import save_file
+    from transformers import Qwen2Config, Qwen3Config
+
+    # qwen2 has no head_dim field, so its head is hidden_size / heads. Two heads over 256 keep it
+    # at 128, the width the attention backend works in.
+    heads, kv_heads, head_dim, hidden = (4, 2, 128, 128) if arch == "qwen3" else (2, 2, 128, 256)
+    common = dict(
+        vocab_size=VOCAB,
+        hidden_size=hidden,
+        intermediate_size=256,
+        num_hidden_layers=LAYERS,
+        num_attention_heads=heads,
+        num_key_value_heads=kv_heads,
+        max_position_embeddings=2048,
+        rms_norm_eps=1e-6,
+        rope_theta=10000.0,
+        tie_word_embeddings=False,
+        bos_token_id=1,
+        eos_token_id=2,
+    )
+    if arch == "qwen3":
+        config = Qwen3Config(head_dim=head_dim, **common)
+        config.architectures = ["Qwen3ForCausalLM"]
+    else:
+        config = Qwen2Config(**common)
+        config.architectures = ["Qwen2ForCausalLM"]
+    os.makedirs(path, exist_ok=True)
+    config.save_pretrained(path)
+
+    rng = np.random.default_rng(seed)
+    q_width, kv_width = heads * head_dim, kv_heads * head_dim
+
+    def normal(*shape):
+        return (rng.normal(size=shape) * 0.08).astype(np.float32)
+
+    tensors = {
+        "model.embed_tokens.weight": normal(VOCAB, hidden),
+        "model.norm.weight": np.ones(hidden, np.float32),
+        "lm_head.weight": normal(VOCAB, hidden),
+    }
+    for i in range(LAYERS):
+        p = f"model.layers.{i}"
+        tensors.update(
+            {
+                f"{p}.self_attn.q_proj.weight": normal(q_width, hidden),
+                f"{p}.self_attn.k_proj.weight": normal(kv_width, hidden),
+                f"{p}.self_attn.v_proj.weight": normal(kv_width, hidden),
+                f"{p}.self_attn.o_proj.weight": normal(hidden, q_width),
+                f"{p}.mlp.gate_proj.weight": normal(256, hidden),
+                f"{p}.mlp.up_proj.weight": normal(256, hidden),
+                f"{p}.mlp.down_proj.weight": normal(hidden, 256),
+                f"{p}.input_layernorm.weight": np.ones(hidden, np.float32),
+                f"{p}.post_attention_layernorm.weight": np.ones(hidden, np.float32),
+            }
+        )
+        if arch == "qwen3":
+            tensors[f"{p}.self_attn.q_norm.weight"] = np.ones(head_dim, np.float32)
+            tensors[f"{p}.self_attn.k_norm.weight"] = np.ones(head_dim, np.float32)
+        else:
+            tensors[f"{p}.self_attn.q_proj.bias"] = normal(q_width)
+            tensors[f"{p}.self_attn.k_proj.bias"] = normal(kv_width)
+            tensors[f"{p}.self_attn.v_proj.bias"] = normal(kv_width)
+    save_file(tensors, os.path.join(path, "model.safetensors"), metadata={"format": "pt"})
+    with open(os.path.join(path, "generation_config.json"), "w") as fh:
+        json.dump({"bos_token_id": 1, "eos_token_id": 2}, fh)
+
+
+def engine_args(model, **overrides):
+    args = dict(
+        model_path=model,
+        skip_tokenizer_init=True,
+        device="cpu",
+        tp_size=1,
+        dtype="float32",
+        attention_backend="fa",
+        max_total_tokens=2048,
+        max_running_requests=4,
+        chunked_prefill_size=64,
+        disable_precompile=True,
+        skip_server_warmup=True,
+        grammar_backend="none",
+        mem_fraction_static=0.3,
+        random_seed=3,
+        log_level="info",
+        enable_return_hidden_states=True,
+        # On CPU the overlap scheduler gives a batched greedy request other tokens than the
+        # same request alone, capture or no capture, so the value checks run without it.
+        disable_overlap_schedule=True,
+    )
+    args.update(overrides)
+    return args
+
+
+# --------------------------------------------------------------------------------------
+# the child process
+# --------------------------------------------------------------------------------------
+
+
+def report(**fields):
+    print("RESULT " + json.dumps(fields), flush=True)
+
+
+def rows_of(output):
+    """A reply's chunks stacked to [rows, layers, hidden], and the rows prefill returned."""
+    chunks = [np.asarray(c, np.float32) for c in output["meta_info"].get("hidden_states", [])]
+    if not chunks:
+        return np.zeros((0,), np.float32), 0
+    prompt = sum(c.shape[0] for c in chunks if c.ndim == 3)
+    return np.concatenate([c if c.ndim == 3 else c[None] for c in chunks]), prompt
+
+
+def describe(output):
+    stacked, prompt_rows = rows_of(output)
+    meta = output["meta_info"]
+    return {
+        "rows": int(stacked.shape[0]),
+        "prompt_rows": int(prompt_rows),
+        "prompt_tokens": int(meta["prompt_tokens"]),
+        "completion_tokens": int(meta["completion_tokens"]),
+        "cached_tokens": int(meta.get("cached_tokens") or 0),
+        "chunk_shapes": [list(np.shape(c)) for c in meta.get("hidden_states", [])],
+        "has_key": "hidden_states" in meta,
+        "output_ids": [int(t) for t in output.get("output_ids", [])],
+    }
+
+
+def max_rel(a, b):
+    a, b = np.asarray(a, np.float64), np.asarray(b, np.float64)
+    if a.shape != b.shape or not b.size:
+        return float("inf")
+    return float(np.abs(a - b).max() / max(np.abs(b).max(), 1e-12))
+
+
+def prompt_ids(seed, length):
+    return np.random.default_rng(seed).integers(3, VOCAB, size=length).tolist()
+
+
+GREEDY = {"temperature": 0.0, "ignore_eos": True}
+
+
+def scenario_main(engine):
+    """A cached prefix, a mixed batch, logprobs, HTTP /generate, and what each output sends."""
+    # A cached prefix: `first` fills the radix cache and `second` shares its first 10 tokens.
+    first = prompt_ids(1, 16)
+    second = first[:10] + prompt_ids(2, 6)
+    one = {**GREEDY, "max_new_tokens": 1}
+    engine.generate(input_ids=first, sampling_params=one)
+    control = engine.generate(input_ids=first[:10] + prompt_ids(3, 6), sampling_params=one)
+    hit = engine.generate(input_ids=second, sampling_params=one, return_hidden_states=True)
+    engine.flush_cache()
+    alone = engine.generate(input_ids=second, sampling_params=one, return_hidden_states=True)
+    report(
+        case="cached_prefix",
+        control_cached_tokens=int(control["meta_info"]["cached_tokens"]),
+        hit=describe(hit),
+        rel_to_alone=max_rel(rows_of(hit)[0], rows_of(alone)[0]),
+    )
+
+    # A request for hidden states beside one that doesn't ask. The plain one streams a chunk
+    # every step, so while it runs, the step the other finishes on sends both in one output.
+    plain_ids, asker_ids = prompt_ids(4, 12), prompt_ids(5, 9)
+    three = {**GREEDY, "max_new_tokens": 3}
+
+    async def mixed():
+        asker_task = asyncio.ensure_future(
+            engine.async_generate(
+                input_ids=asker_ids, sampling_params=three, return_hidden_states=True
+            )
+        )
+        plain = await engine.async_generate(
+            input_ids=plain_ids, sampling_params={**GREEDY, "max_new_tokens": 48}, stream=True
+        )
+        chunks, after = [], 0
+        async for chunk in plain:
+            chunks.append(chunk)
+            after += asker_task.done()
+        return chunks, await asker_task, after
+
+    plain_chunks, asker, streamed_after = engine.loop.run_until_complete(mixed())
+    asker_alone = engine.generate(
+        input_ids=asker_ids, sampling_params=three, return_hidden_states=True
+    )
+    report(
+        case="mixed_batch",
+        plain_chunks=len(plain_chunks),
+        plain_chunks_after_asker=streamed_after,
+        plain_got_key=any("hidden_states" in c["meta_info"] for c in plain_chunks),
+        asker=describe(asker),
+        rel_to_alone=max_rel(rows_of(asker)[0], rows_of(asker_alone)[0]),
+    )
+
+    # Logprobs and hidden states in one request, then in two requests of one batch.
+    ids = prompt_ids(6, 10)
+    four = {**GREEDY, "max_new_tokens": 4}
+    both = engine.generate(
+        input_ids=ids,
+        sampling_params=four,
+        return_logprob=True,
+        logprob_start_len=0,
+        return_hidden_states=True,
+    )
+    hidden_only = engine.generate(input_ids=ids, sampling_params=four, return_hidden_states=True)
+
+    async def logprob_beside_hidden():
+        # The logprob request streams, so a chunk that arrives after the other request finished
+        # shows the two decoded in one batch.
+        hidden = asyncio.ensure_future(
+            engine.async_generate(input_ids=ids, sampling_params=four, return_hidden_states=True)
+        )
+        logprob = await engine.async_generate(
+            input_ids=prompt_ids(7, 11),
+            sampling_params={**GREEDY, "max_new_tokens": 24},
+            return_logprob=True,
+            logprob_start_len=0,
+            stream=True,
+        )
+        after = 0
+        async for _ in logprob:
+            after += hidden.done()
+        return await hidden, after
+
+    beside, logprob_after = engine.loop.run_until_complete(logprob_beside_hidden())
+    report(
+        case="logprobs",
+        both=describe(both),
+        input_logprobs=len(both["meta_info"].get("input_token_logprobs") or []),
+        rel_to_hidden_only=max_rel(rows_of(both)[0], rows_of(hidden_only)[0]),
+        beside=describe(beside),
+        beside_rel=max_rel(rows_of(beside)[0], rows_of(hidden_only)[0]),
+        logprob_chunks_after_hidden=logprob_after,
+    )
+
+    # HTTP /generate through the real FastAPI app, bound to this engine's tokenizer manager.
+    body = {"input_ids": ids, "sampling_params": {**GREEDY, "max_new_tokens": 2}}
+    plain_http = post_generate(engine, {**body, "return_hidden_states": True})
+    streamed = post_generate(engine, {**body, "return_hidden_states": True, "stream": True})
+    events = [
+        json.loads(line[len("data: ") :])
+        for line in streamed.text.splitlines()
+        if line.startswith("data: {")
+    ]
+    report(
+        case="http",
+        status=plain_http.status_code,
+        shapes=(
+            [list(np.shape(c)) for c in plain_http.json()["meta_info"]["hidden_states"]]
+            if plain_http.status_code == 200
+            else plain_http.text
+        ),
+        stream_status=streamed.status_code,
+        stream_shapes=(
+            [list(np.shape(c)) for c in events[-1]["meta_info"]["hidden_states"]]
+            if events
+            else None
+        ),
+    )
+
+    # What each output carries. The request that doesn't stream decodes past the output the
+    # scheduler forces every 50 tokens, and only the output that finishes it carries rows. Each
+    # chunk of the streamed request carries every row so far.
+    sends = record_sends(engine)
+    quiet = engine.generate(
+        input_ids=prompt_ids(8, 10),
+        sampling_params={**GREEDY, "max_new_tokens": 60},
+        return_hidden_states=True,
+    )
+
+    async def streamed_request():
+        stream = await engine.async_generate(
+            input_ids=prompt_ids(9, 7),
+            sampling_params={**GREEDY, "max_new_tokens": 4},
+            return_hidden_states=True,
+            stream=True,
+        )
+        return [chunk async for chunk in stream]
+
+    chunks = engine.loop.run_until_complete(streamed_request())
+    report(
+        case="sends",
+        quiet=describe(quiet),
+        quiet_sends=[n for rid, n in sends if rid == quiet["meta_info"]["id"]],
+        streamed=describe(chunks[-1]),
+        streamed_sends=[n for rid, n in sends if rid == chunks[-1]["meta_info"]["id"]],
+        streamed_chunks=[len(c["meta_info"].get("hidden_states", [])) for c in chunks],
+    )
+
+
+def record_sends(engine):
+    """(rid, chunks) for every request an output that reaches the tokenizer manager sends rows for.
+
+    Wraps the manager's result dispatcher, which its handle loop looks up for every output.
+    """
+    manager = engine.tokenizer_manager
+    dispatch = manager._result_dispatcher
+    sends = []
+
+    def recording(recv_obj):
+        entries = getattr(recv_obj, "output_hidden_states", None) or []
+        for rid, entry in zip(getattr(recv_obj, "rids", None) or [], entries):
+            if len(entry):
+                sends.append((rid, len(entry)))
+        return dispatch(recv_obj)
+
+    manager._result_dispatcher = recording
+    return sends
+
+
+def post_generate(engine, body):
+    """POST /generate to the real app in this process, on the engine's event loop."""
+    import httpx
+
+    from sgl_jax.srt.entrypoints import http_server
+
+    http_server.set_global_state(
+        http_server._GlobalState(
+            tokenizer_manager=engine.tokenizer_manager,
+            template_manager=engine.template_manager,
+            scheduler_info=engine.scheduler_info,
+        )
+    )
+
+    async def post():
+        # An error in the app comes back as the 500 a real server would send.
+        transport = httpx.ASGITransport(app=http_server.app, raise_app_exceptions=False)
+        async with httpx.AsyncClient(transport=transport, base_url="http://engine") as client:
+            return await client.post("/generate", json=body, timeout=300)
+
+    return engine.loop.run_until_complete(post())
+
+
+def scenario_retract(engine):
+    """Two requests that outgrow a small KV pool, so the scheduler retracts one during decode.
+
+    The test runs this with SGLANG_CLIP_MAX_NEW_TOKENS_ESTIMATION=1, so admission counts one new
+    token per request and lets both in, and they outgrow the pool before they finish. The
+    retracted request prefills its prompt and its output again, then decodes the rest.
+    """
+    prompts = [prompt_ids(10, 4), prompt_ids(11, 5)]
+    greedy = {"temperature": 0.0, "max_new_tokens": 16}
+    # One call sends both, so they reach the same scheduling round.
+    crowded = engine.generate(input_ids=prompts, sampling_params=greedy, return_hidden_states=True)
+    for i, (ids, out) in enumerate(zip(prompts, crowded)):
+        alone = engine.generate(input_ids=ids, sampling_params=greedy, return_hidden_states=True)
+        report(
+            case="retract",
+            index=i,
+            crowded=describe(out),
+            alone=describe(alone),
+            rel_to_alone=max_rel(rows_of(out)[0], rows_of(alone)[0]),
+        )
+
+
+def scenario_retract_in_flight(engine):
+    """A request retracted while its own prefill still runs, under the overlap scheduler.
+
+    Two prompts fill both 64-token pages of the pool. The overlap scheduler builds the next
+    decode batch before the prefill result lands, finds no page for the next token, and
+    retracts a request whose rows are still in flight.
+    """
+    one = {"temperature": 0.0, "max_new_tokens": 1}
+
+    async def behind_a_warmup():
+        # The warm-up takes a page, so neither prompt fits beside it, and its first compile
+        # holds the scheduler for seconds. Both prompts wait in the queue meanwhile and reach
+        # the same scheduling round once the warm-up's page frees up.
+        warmup = asyncio.ensure_future(
+            engine.async_generate(input_ids=prompt_ids(42, 3), sampling_params=one)
+        )
+        prompts = asyncio.ensure_future(
+            engine.async_generate(
+                input_ids=[prompt_ids(40, 64), prompt_ids(41, 60)],
+                sampling_params=one,
+                return_hidden_states=True,
+            )
+        )
+        await warmup
+        return await prompts
+
+    for i, out in enumerate(engine.loop.run_until_complete(behind_a_warmup())):
+        report(case="retract_in_flight", index=i, crowded=describe(out))
+
+
+def leading_agreement(a, b):
+    """How many leading tokens two outputs share."""
+    n = 0
+    for x, y in zip(a, b):
+        if x != y:
+            break
+        n += 1
+    return n
+
+
+def scenario_mixed_chunk(engine):
+    """A request that decodes inside another request's prefill chunks, under the overlap scheduler.
+
+    With enable_mixed_chunk, each extend batch that carries a prefill chunk also carries one decode
+    step for every running request. A streams, and B arrives once A has three tokens, so B's four
+    chunks carry A's decode steps. Under the overlap scheduler, A's input token for such a step
+    isn't in its output_ids yet.
+    """
+    a_ids, b_ids = prompt_ids(50, 6), prompt_ids(51, 60)
+    a_params = {**GREEDY, "max_new_tokens": 40}
+    b_params = {**GREEDY, "max_new_tokens": 3}
+
+    async def crowded():
+        a_stream = await engine.async_generate(
+            input_ids=a_ids, sampling_params=a_params, return_hidden_states=True, stream=True
+        )
+        b_task, last, seen = None, None, 0
+        async for chunk in a_stream:
+            last, seen = chunk, seen + 1
+            if seen == 3:
+                b_task = asyncio.ensure_future(
+                    engine.async_generate(
+                        input_ids=b_ids, sampling_params=b_params, return_hidden_states=True
+                    )
+                )
+        return last, await b_task
+
+    a_out, b_out = engine.loop.run_until_complete(crowded())
+    for label, ids, params, out in (("A", a_ids, a_params, a_out), ("B", b_ids, b_params, b_out)):
+        alone = engine.generate(input_ids=ids, sampling_params=params, return_hidden_states=True)
+        got, ref = describe(out), describe(alone)
+        # On CPU the overlap scheduler sometimes computes a step of a batched request wrong, with
+        # or without this patch. The row for that step and the token it picks differ from the
+        # same request alone, and so does every step after it. Row i picks the token at i + 1,
+        # so compare the rows before the one that picked the first token that differs.
+        agree = leading_agreement(got["output_ids"], ref["output_ids"])
+        compared = len(ids) + agree - 1 if agree < len(ref["output_ids"]) else ref["rows"]
+        report(
+            case="mixed_chunk",
+            req=label,
+            rid=out["meta_info"]["id"],
+            crowded=got,
+            alone=ref,
+            rows_compared=compared,
+            rel_to_alone=max_rel(rows_of(out)[0][:compared], rows_of(alone)[0][:compared]),
+        )
+
+
+def scenario_flag_off(engine):
+    """A server without the flag refuses the request, tells the caller why, and stays up."""
+    ids = prompt_ids(20, 8)
+    try:
+        engine.generate(
+            input_ids=ids, sampling_params={"max_new_tokens": 2}, return_hidden_states=True
+        )
+        refused = None
+    except ValueError as exc:
+        refused = str(exc)
+    over_http = post_generate(
+        engine,
+        {"input_ids": ids, "sampling_params": {"max_new_tokens": 2}, "return_hidden_states": True},
+    )
+    after = engine.generate(input_ids=ids, sampling_params={"max_new_tokens": 2})
+    report(
+        case="flag_off",
+        refused=refused,
+        http_status=over_http.status_code,
+        http_body=over_http.text,
+        served_after=len(after["output_ids"]),
+    )
+
+
+def scenario_start(engine):
+    """Start, serve one request, and describe what came back."""
+    out = engine.generate(
+        input_ids=prompt_ids(30, 8),
+        sampling_params={"max_new_tokens": 2},
+        return_hidden_states=engine.server_args.enable_return_hidden_states,
+    )
+    report(case="start", served=describe(out))
+
+
+def scenario_rows(engine):
+    """Serve one prompt with decode steps, and save its rows where ROWS_OUT names."""
+    out = engine.generate(
+        input_ids=prompt_ids(60, 12),
+        sampling_params={**GREEDY, "max_new_tokens": 3},
+        return_hidden_states=True,
+    )
+    np.save(os.environ["ROWS_OUT"], rows_of(out)[0])
+    report(case="rows", served=describe(out))
+
+
+DP_RANKS = [0, 1, 1]
+
+
+def scenario_dp(engine):
+    """Three requests pinned to two DP ranks, one split across prefill passes, with decode steps.
+
+    Rank 1 holds two requests of different lengths, and the longer one's 90 tokens take two
+    64-token passes. Slot 0 is the embedding output, so each row's slot 0 has to be the
+    embedding of the token at its position: the prompt, then every generated token but the
+    last, which no pass reads. That holds whatever attention computes, so a row filed under
+    another request, or a padding row, can't pass it.
+    """
+    from safetensors.numpy import load_file
+
+    from sgl_jax.srt.managers.io_struct import GenerateReqInput
+
+    embed = load_file(os.path.join(engine.server_args.model_path, "model.safetensors"))[
+        "model.embed_tokens.weight"
+    ]
+    steps = {**GREEDY, "max_new_tokens": 4}
+    prompts = [prompt_ids(21, 12), prompt_ids(22, 90), prompt_ids(23, 20)]
+    obj = GenerateReqInput(
+        input_ids=prompts,
+        sampling_params=[dict(steps) for _ in prompts],
+        return_hidden_states=True,
+        dp_rank=DP_RANKS,
+    )
+    batched = engine.loop.run_until_complete(
+        engine.tokenizer_manager.generate_request(obj, None).__anext__()
+    )
+    for prompt, out in zip(prompts, batched):
+        rows = rows_of(out)[0]
+        tokens = list(prompt) + [int(t) for t in out["output_ids"][:-1]]
+        slot0 = rows[:, 0, :] if rows.ndim == 3 else rows
+        report(
+            case="dp",
+            meta_rank=out["meta_info"].get("dp_rank"),
+            batched=describe(out),
+            slot0_rel=max_rel(slot0, embed[tokens]),
+        )
+
+
+def install_single_block_mutant():
+    """The output processor as it read before the per-rank offsets: one packed run of rows.
+
+    Prefill drops the per-rank start, and decode reads row i for request i of every rank.
+    The engine runs in one process here, so the patched methods are the ones it calls.
+    """
+    import __future__
+    import ast
+    import inspect
+    import textwrap
+
+    from sgl_jax.srt.managers import scheduler_output_processor_mixin as module
+
+    mixin = module.SchedulerOutputProcessorMixin
+    for name, rewrite in (
+        ("process_batch_result_prefill", "drop_rank_start"),
+        ("process_batch_result_decode", "row_i"),
+    ):
+        tree = ast.parse(textwrap.dedent(inspect.getsource(getattr(mixin, name))))
+        found = 0
+        for node in ast.walk(tree):
+            if rewrite == "drop_rank_start" and isinstance(node, ast.If):
+                body = node.body
+                if (len(body) == 1 and isinstance(body[0], ast.Assign)
+                        and ast.unparse(body[0].targets[0]) == "hidden_state_offset"):
+                    node.test = ast.Constant(value=False)
+                    found += 1
+            if rewrite == "row_i" and isinstance(node, ast.Assign):
+                if ast.unparse(node.targets[0]) == "row" and "per_dp_bs_size" in ast.unparse(node):
+                    node.value = ast.Name(id="i", ctx=ast.Load())
+                    found += 1
+        if found != 1:
+            raise SystemExit(f"the mutant found {found} targets in {name}")
+        namespace = dict(vars(module))
+        # The module postpones its annotations, and `self: Scheduler` names a class it imports
+        # only for type checking, so the mutant compiles the same way.
+        code = compile(
+            ast.fix_missing_locations(tree),
+            f"<mutant {name}>",
+            "exec",
+            flags=__future__.annotations.compiler_flag,
+            dont_inherit=True,
+        )
+        exec(code, namespace)
+        setattr(mixin, name, namespace[name])
+
+
+SCENARIOS = {
+    "main": scenario_main,
+    "dp": scenario_dp,
+    "retract": scenario_retract,
+    "retract_in_flight": scenario_retract_in_flight,
+    "mixed_chunk": scenario_mixed_chunk,
+    "flag_off": scenario_flag_off,
+    "start": scenario_start,
+    "rows": scenario_rows,
+}
+
+
+def child(argv):
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--scenario", required=True)
+    parser.add_argument("--engine-args", required=True)
+    args = parser.parse_args(argv)
+    kwargs = json.loads(args.engine_args)
+    if isinstance(kwargs, dict) and kwargs.pop("_mutant", None) == "single_block":
+        install_single_block_mutant()
+
+    if args.scenario == "check_args":
+        # What Engine runs first, before it starts any process.
+        from sgl_jax.srt.server_args import ServerArgs
+
+        try:
+            ServerArgs(**kwargs).check_server_args()
+            report(case="check_args", error=None)
+        except (ValueError, AssertionError) as exc:
+            report(case="check_args", error=str(exc))
+        return 0
+
+    if args.scenario == "command_line":
+        # What launch_server does with its argv. Here the engine args are that argv.
+        from sgl_jax.srt.server_args import ServerArgs
+
+        try:
+            parsed = ServerArgs.from_cli(kwargs)
+            report(case="command_line", layers=parsed.return_hidden_states_layers, error=None)
+        except SystemExit as exc:
+            report(case="command_line", layers=None, error=f"argparse exited {exc.code}")
+        return 0
+
+    from sgl_jax.srt.entrypoints.engine import Engine
+
+    try:
+        engine = Engine(**kwargs)
+    except ValueError as exc:
+        report(case="refused_at_start", error=str(exc))
+        return 0
+    SCENARIOS[args.scenario](engine)
+    engine.shutdown()
+    return 0
+
+
