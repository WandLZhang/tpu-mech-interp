+    def test_layer_filter_command_line(self):
+        # launch_server takes the slots as separate integers after the flag, the way
+        # --precompile-token-paddings takes its list.
+        base = ["--model-path", self.qwen3, "--device", "cpu", "--enable-return-hidden-states"]
+        run = run_child("command_line", argv=base + ["--return-hidden-states-layers", "0", "3"])
+        (r,) = self.result(run, "command_line")
+        self.assertEqual(r, {"case": "command_line", "layers": [0, 3], "error": None})
+        # Unset means every slot, which the model runner reads as None.
+        (r,) = self.result(run_child("command_line", argv=base), "command_line")
+        self.assertEqual(r["layers"], None, r)
+        self.assertIsNone(r["error"], r)
+        # Control: a comma list isn't an integer, and argparse refuses it before anything loads.
+        run = run_child("command_line", argv=base + ["--return-hidden-states-layers", "0,3"])
+        (r,) = self.result(run, "command_line")
+        self.assertEqual(r["error"], "argparse exited 2", r)
+        self.assertIn("invalid int value: '0,3'", run[2])
