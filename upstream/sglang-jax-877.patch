+def _captured_slots(server_args, model_config) -> int | None:
+    """How many slots each row splits into, or None on a server without the flag.
+
+    The model runner captures the slots --return-hidden-states-layers names, or every slot when
+    it's unset, and the logits processor joins them along the last axis.
+    """
+    if not server_args.enable_return_hidden_states:
+        return None
+    layers = server_args.return_hidden_states_layers
+    return model_config.num_hidden_layers if layers is None else len(layers)
+
+
+def _keep_hidden_state_rows(req: Req, hs: np.ndarray, first: int, num_layers: int | None) -> None:
+    """Append the rows for positions first, first + 1, ... to req.hidden_states.
+
+    Prompt positions go in as one chunk. Each position past the prompt goes in as a chunk of its
+    own, the shape a decode step appends. A retracted request prefills its output again, so this
+    is what gives it the chunk list it would have had without the retraction.
+    """
+    if first > req.hidden_state_rows:
+        logger.warning(
+            "hidden states for request %s skip positions %d to %d",
+            req.rid,
+            req.hidden_state_rows,
+            first - 1,
+        )
+    if num_layers is not None:
+        hs = hs.reshape(hs.shape[0], num_layers, -1)
+    prompt = min(max(len(req.origin_input_ids) - first, 0), hs.shape[0])
+    if prompt:
+        req.hidden_states.append(hs[:prompt])
+    req.hidden_states.extend(hs[prompt:])
+    req.hidden_state_rows = first + hs.shape[0]
+
+
+def _rows_to_slice(hidden_states, dp_size):
+    """The batch's hidden states in a form each request's slice can index.
+
+    Above one DP rank the rows shard over the data axis, and JAX won't slice a sharded array per
+    request, so the batch's rows come to the host once. At one rank each request slices its
+    own rows on the device, which moves no padding rows.
+    """
+    if hidden_states is None or dp_size <= 1:
+        return hidden_states
+    return np.asarray(jax.device_get(hidden_states))
+
+
