+        run = run_child("check_args", **engine_args(self.qwen3, return_hidden_states_layers=[0, 3]))
+        (c,) = self.result(run, "check_args")
+        self.assertIsNone(c["error"], c)
+        # A slot at the layer count passes that check, and the model runner refuses it at
+        # startup, where the layer count is known. The control is the filter test above, where
+        # slot 3, the last one, starts and serves.
+        code, results, log = run_child(
+            "start", **engine_args(self.qwen3, return_hidden_states_layers=[1, LAYERS])
+        )
+        self.assertFalse(any(r.get("case") == "start" for r in results), results)
+        self.assertIn(
+            f"--return-hidden-states-layers asks for slot {LAYERS}, and Qwen3ForCausalLM has "
+            f"{LAYERS} slots, 0 to {LAYERS - 1}",
