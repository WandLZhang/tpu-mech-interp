+    def test_layer_filter_refuses_bad_slot_lists(self):
+        for overrides, message in (
+            ({"return_hidden_states_layers": []}, "needs at least one slot"),
+            ({"return_hidden_states_layers": [1, 1]}, "lists slot 1 twice"),
+            ({"return_hidden_states_layers": [-1]}, "got slot -1"),
+            ({"return_hidden_states_layers": [3, 1]}, "lists slot 1 after slot 3"),
+            (
+                {"return_hidden_states_layers": [1], "enable_return_hidden_states": False},
+                "needs --enable-return-hidden-states",
+            ),
+        ):
+            with self.subTest(**overrides):
