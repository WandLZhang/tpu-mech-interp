+    def result(self, run, case):
+        code, results, log = run
+        found = [r for r in results if r.get("case") == case]
+        self.assertTrue(found, f"no {case} result; the child exited {code}. Log:\n{log}")
+        return found
+
+    def assertContract(self, got):
+        """One row per position: every prompt token from prefill, then one per decode step."""
+        self.assertEqual(got["prompt_rows"], got["prompt_tokens"], got)
+        self.assertEqual(got["rows"], got["prompt_tokens"] + got["completion_tokens"] - 1, got)
+        decode_chunks = [s for s in got["chunk_shapes"] if len(s) == 2]
+        self.assertEqual(len(decode_chunks), got["completion_tokens"] - 1, got)
+
+    def assertNoMisfiledRows(self, log):
+        """The output processor warns when a pass skips a position or covers one twice."""
+        for warning in ("skip positions", "repeat positions"):
+            misfiled = [line for line in log.splitlines() if warning in line]
+            self.assertFalse(misfiled, misfiled)
