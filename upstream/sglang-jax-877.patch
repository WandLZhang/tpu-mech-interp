+        results = {r["req"]: r for r in self.result(run, "mixed_chunk")}
+        self.assertEqual(sorted(results), ["A", "B"], results)
+        a = results["A"]
+        # Control: A's prompt fits one pass, so every extend pass for A after that one is a
+        # decode step that one of B's chunks carried, or this reads nothing.
+        a_passes = [
