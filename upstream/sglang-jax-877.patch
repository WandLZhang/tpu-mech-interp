+    def test_layer_filter_returns_the_named_slots(self):
+        # --return-hidden-states-layers 0 3: a reply holds those two slots, in that order.
+        with tempfile.TemporaryDirectory() as tmp:
+            full_out, kept_out = os.path.join(tmp, "full.npy"), os.path.join(tmp, "kept.npy")
+            full_run = run_child("rows", env={"ROWS_OUT": full_out}, **engine_args(self.qwen3))
+            kept_run = run_child(
+                "rows",
+                env={"ROWS_OUT": kept_out},
+                **engine_args(self.qwen3, return_hidden_states_layers=KEPT_SLOTS),
+            )
+            (full,) = self.result(full_run, "rows")
+            (kept,) = self.result(kept_run, "rows")
+            full_rows, kept_rows = np.load(full_out), np.load(kept_out)
+        self.assertIn(f"capture enabled for 2 of {LAYERS} slots: {KEPT_SLOTS}", kept_run[2])
+        # The reply shape: prefill chunks [tokens, 2, hidden], decode chunks [2, hidden], and the
+        # same rows the unfiltered run returns. Control: the unfiltered run carries every slot.
+        hidden = full["served"]["chunk_shapes"][0][-1]
+        self.assertContract(kept["served"])
+        self.assertEqual(kept["served"]["output_ids"], full["served"]["output_ids"], kept)
+        for shape in kept["served"]["chunk_shapes"]:
+            self.assertEqual(shape[-2:], [len(KEPT_SLOTS), hidden], kept)
+        for shape in full["served"]["chunk_shapes"]:
+            self.assertEqual(shape[-2:], [LAYERS, hidden], full)
+        self.assertEqual(kept_rows.shape, (full_rows.shape[0], len(KEPT_SLOTS), hidden))
+        # Position j of the reply holds slot KEPT_SLOTS[j], equal to that slot of the unfiltered
+        # run. Control: every other slot of the unfiltered run misses by far more, so a slot filed
+        # at the wrong position, or read from the wrong layer, fails.
+        for position, slot in enumerate(KEPT_SLOTS):
+            with self.subTest(position=position, slot=slot):
+                self.assertLess(max_rel(kept_rows[:, position], full_rows[:, slot]), ROW_TOL)
+                for other in range(LAYERS):
+                    if other != slot:
+                        miss = max_rel(kept_rows[:, position], full_rows[:, other])
+                        self.assertGreater(miss, 100 * ROW_TOL, (other, miss))
