+# the tests
+# --------------------------------------------------------------------------------------
+
+
+def run_child(scenario, env=None, argv=None, **kwargs):
+    """Run one scenario in a child process. Returns (returncode, results, log).
+
+    The child gets kwargs as Engine keywords, or argv as a command line when argv is set.
+    """
+    child_env = dict(os.environ)
+    child_env.setdefault("JAX_PLATFORMS", "cpu")
+    # tp_size 1 wants one device, whatever device count the caller forced for itself.
+    child_env["XLA_FLAGS"] = "--xla_force_host_platform_device_count=1"
+    child_env.update(env or {})
+    proc = subprocess.run(
+        [
+            sys.executable,
+            HERE,
+            "--scenario",
+            scenario,
+            "--engine-args",
+            json.dumps(kwargs if argv is None else argv),
+        ],
+        capture_output=True,
+        text=True,
+        env=child_env,
+        timeout=900,
+    )
+    results = [
+        json.loads(line[len("RESULT ") :])
+        for line in proc.stdout.splitlines()
+        if line.startswith("RESULT ")
+    ]
+    return proc.returncode, results, proc.stdout + proc.stderr
