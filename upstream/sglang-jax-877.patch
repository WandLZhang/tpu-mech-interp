diff --git a/test/srt/test_capture_mode_propagation.py b/test/srt/test_capture_mode_propagation.py
new file mode 100644
index 00000000..dc067a84
--- /dev/null
+++ b/test/srt/test_capture_mode_propagation.py
@@ -0,0 +1,225 @@
+"""Every per-request capture flag must reach the batch that consumes it.
+
+This catches a class of bug the source-inspection tests miss. A field can exist
+on Req, exist on ScheduleBatch, be read correctly downstream, and still never be
+populated, because nothing aggregates it in init_new. The chain then looks whole
+in every file and produces nothing at runtime.
+
+The same holds on the way out. merge_batch ORs a flag in from the batch it
+merges, and filter_batch has to derive it again from the requests it keeps. A
+flag it skips stays set after the last request that asked leaves, and every
+later step of the running batch pays for a mode nobody reads.
+
+    python3 test/srt/test_capture_mode_propagation.py
+"""
+
+import ast
+import copy
+import pathlib
+import sys
+
+SRC = pathlib.Path(__file__).resolve().parents[2] / "python/sgl_jax/srt/managers/schedule_batch.py"
+
+
+def _tree():
+    return ast.parse(SRC.read_text())
+
+
+def _class(tree, name):
+    for n in ast.walk(tree):
+        if isinstance(n, ast.ClassDef) and n.name == name:
+            return n
+    raise AssertionError(f"class {name} not found")
+
+
+def _annotated_fields(cls):
+    return {
+        n.target.id
+        for n in cls.body
+        if isinstance(n, ast.AnnAssign) and isinstance(n.target, ast.Name)
+    }
+
+
+def _init_new_kwargs(cls):
+    """kwargs of the cls(...) call in init_new, with local names resolved once.
+
+    `return_logprob=return_logprob` is just as valid an aggregation as an inline
+    generator, so resolve a local binding before judging the expression.
+    """
+    for fn in cls.body:
+        if isinstance(fn, ast.FunctionDef) and fn.name == "init_new":
+            locals_ = {}
+            for n in fn.body:
+                if (
+                    isinstance(n, ast.Assign)
+                    and len(n.targets) == 1
+                    and isinstance(n.targets[0], ast.Name)
+                ):
+                    locals_[n.targets[0].id] = ast.unparse(n.value)
+            for n in ast.walk(fn):
+                if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == "cls":
+                    out = {}
+                    for kw in n.keywords:
+                        if not kw.arg:
+                            continue
+                        expr = ast.unparse(kw.value)
+                        out[kw.arg] = locals_.get(expr, expr)
+                    return out
+    raise AssertionError("init_new cls(...) call not found")
+
+
+def _judge(batch, flags):
+    """Per flag, the expression init_new passes and whether it derives the flag from the reqs."""
+    kwargs = _init_new_kwargs(batch)
+    out = {}
+    for f in flags:
+        expr = kwargs.get(f)
+        out[f] = (expr, expr is not None and "all_reqs" in expr)
+    return out
+
+
+def _mutated(tree, flag, value):
+    """A copy of the tree whose init_new cls(...) call drops `flag`, or passes `value` for it."""
+    tree = copy.deepcopy(tree)
+    for fn in _class(tree, "ScheduleBatch").body:
+        if isinstance(fn, ast.FunctionDef) and fn.name == "init_new":
+            for n in ast.walk(fn):
+                if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == "cls":
+                    if value is None:
+                        n.keywords = [kw for kw in n.keywords if kw.arg != flag]
+                    else:
+                        for kw in n.keywords:
+                            if kw.arg == flag:
+                                kw.value = value
+                    return tree
+    raise AssertionError("init_new cls(...) call not found")
+
+
+def _method(cls, name):
+    for fn in cls.body:
+        if isinstance(fn, ast.FunctionDef) and fn.name == name:
+            return fn
+    raise AssertionError(f"{name} not found")
+
+
+def _is_self_attr(node):
+    return (
+        isinstance(node, ast.Attribute)
+        and isinstance(node.value, ast.Name)
+        and node.value.id == "self"
+    )
+
+
+def _ored_in_merge(batch):
+    """The flags merge_batch ORs in from the other batch: `self.flag |= other.flag`."""
+    return sorted(
+        n.target.attr
+        for n in ast.walk(_method(batch, "merge_batch"))
+        if isinstance(n, ast.AugAssign) and isinstance(n.op, ast.BitOr) and _is_self_attr(n.target)
+    )
+
+
+def _recomputed_in_filter(batch):
+    """The flags filter_batch assigns from the requests it keeps, the `all_reqs` it builds."""
+    return {
+        t.attr
+        for n in ast.walk(_method(batch, "filter_batch"))
+        if isinstance(n, ast.Assign) and "all_reqs" in ast.unparse(n.value)
+        for t in n.targets
+        if _is_self_attr(t)
+    }
+
+
+class _DropAssign(ast.NodeTransformer):
+    """Drops every `self.<flag> = ...` statement."""
+
+    def __init__(self, flag):
+        self.flag = flag
+
+    def visit_Assign(self, node):
+        if any(_is_self_attr(t) and t.attr == self.flag for t in node.targets):
+            return ast.Pass()
+        return node
+
+
+def _filter_mutated(tree, flag):
+    """A copy of the tree whose filter_batch never assigns `flag`."""
+    tree = copy.deepcopy(tree)
+    fn = _method(_class(tree, "ScheduleBatch"), "filter_batch")
+    _DropAssign(flag).visit(fn)
+    return tree
+
+
+def main():
+    tree = _tree()
+    req = _class(tree, "Req")
+    batch = _class(tree, "ScheduleBatch")
+
+    req_fields = _annotated_fields(req) | {
+        t.attr
+        for fn in req.body
+        if isinstance(fn, ast.FunctionDef) and fn.name == "__init__"
+        for t in ast.walk(fn)
+        if isinstance(t, ast.Attribute) and isinstance(t.value, ast.Name) and t.value.id == "self"
+    }
+    batch_fields = _annotated_fields(batch)
+
+    # Any return_* flag that lives on BOTH Req and ScheduleBatch has to be
+    # aggregated from the reqs in init_new, or the batch keeps its default.
+    shared = sorted(f for f in batch_fields & req_fields if f.startswith("return_"))
+    assert shared, "expected at least one shared return_* flag; the heuristic has drifted"
+
+    print(f"shared per-request flags on ScheduleBatch: {', '.join(shared)}\n")
+    failures = 0
+    for f, (expr, ok) in _judge(batch, shared).items():
+        print(f"  [{'PASS' if ok else 'FAIL'}] {f:<28} init_new passes: {expr!r}")
+        if not ok:
+            failures += 1
+            print(f"         {f} defaults on the batch and nothing derives it from the reqs.")
+
+    # Negative controls. Mutate the parsed source so init_new drops each flag, or passes a
+    # constant for it, and run the same parse and the same judgment on the result. Each has to
+    # read as not aggregated, or the check above can't fail either.
+    print()
+    for f in shared:
+        for label, value in (("dropped", None), ("pinned to False", ast.Constant(value=False))):
+            mutated = _class(_mutated(tree, f, value), "ScheduleBatch")
+            caught = not _judge(mutated, shared)[f][1]
+            print(f"  control ({f} {label}): {'detected' if caught else 'NOT DETECTED'}")
+            if not caught:
+                print("  FAIL: the control didn't fail, so this test detects nothing.")
+                failures += 1
+
+    # On the way out: every flag merge_batch ORs in, filter_batch derives again from the
+    # requests it keeps.
+    ored = _ored_in_merge(batch)
+    assert ored, "expected merge_batch to OR in at least one flag; the heuristic has drifted"
+    recomputed = _recomputed_in_filter(batch)
+    print(f"\nflags merge_batch ORs in: {', '.join(ored)}\n")
+    for f in ored:
+        ok = f in recomputed
+        print(f"  [{'PASS' if ok else 'FAIL'}] filter_batch derives {f} from the requests it keeps")
+        if not ok:
+            failures += 1
+            print(f"         {f} stays set after the last request that asked leaves the batch.")
+
+    # Negative controls. The same judgment on a filter_batch that never assigns the flag.
+    print()
+    for f in ored:
+        mutated = _class(_filter_mutated(tree, f), "ScheduleBatch")
+        caught = f not in _recomputed_in_filter(mutated)
+        print(f"  control ({f} never reassigned): {'detected' if caught else 'NOT DETECTED'}")
+        if not caught:
+            print("  FAIL: the control didn't fail, so this test detects nothing.")
+            failures += 1
+
+    print()
+    if failures:
+        print(f"FAILED: {failures} check(s)")
+        return 1
+    print("All checks passed.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
