+    def test_data_parallel_ranks_keep_their_rows(self):
+        # dp_size 2 at tp_size 2 needs two devices, and one process lets the control patch the
+        # scheduler the engine runs.
+        env = {"XLA_FLAGS": "--xla_force_host_platform_device_count=2"}
+        args = engine_args(self.qwen3, tp_size=2, dp_size=2, enable_single_process=True)
+        found = self.result(run_child("dp", env=env, **args), "dp")
+        # Control: the batch spans both ranks, rank 1 holds two requests, and one of them takes
+        # two prefill passes, or nothing here reads a rank's block.
+        self.assertEqual([r["meta_rank"] for r in found], DP_RANKS, found)
+        self.assertGreater(found[1]["batched"]["prompt_tokens"], 64, found)
+        for r in found:
+            self.assertContract(r["batched"])
+            self.assertLess(r["slot0_rel"], 1e-6, r)
+        # Control: the rows read as one packed run, the way they did before the per-rank
+        # offsets. The run has to finish and misfile rank 1's requests; a crash proves nothing.
+        code, results, log = run_child("dp", env=env, _mutant="single_block", **args)
+        misfiled = [r for r in results if r.get("case") == "dp"]
+        self.assertEqual(len(misfiled), len(DP_RANKS), f"the child exited {code}:\n{log}")
+        wrong = [r["slot0_rel"] for r in misfiled if r["meta_rank"] == 1]
+        self.assertTrue(any(rel >= 1e-6 for rel in wrong), misfiled)
