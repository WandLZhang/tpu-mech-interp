+        self.assertGreater(len(a_passes), 1, a_passes)
+        # A had three tokens before B arrived, so the two runs agree at least that far, and the
+        # comparison covers decode rows.
+        self.assertGreater(a["rows_compared"], a["crowded"]["prompt_tokens"] + 1, a)
+        for r in results.values():
