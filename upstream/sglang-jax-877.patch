+    def test_cached_prefix_returns_every_prompt_row(self):
+        (r,) = self.result(self.main_run(), "cached_prefix")
+        # Control: the cache is live, so a request that shares the prefix without asking for
+        # hidden states reuses it.
+        self.assertGreaterEqual(r["control_cached_tokens"], 10, r)
+        self.assertEqual(r["hit"]["cached_tokens"], 0, r)
+        self.assertContract(r["hit"])
+        self.assertLess(r["rel_to_alone"], ROW_TOL, r)
+
+    def test_mixed_batch_keeps_rows_with_their_request(self):
+        (r,) = self.result(self.main_run(), "mixed_batch")
+        # Control: the plain request kept streaming after the other one finished, so the step
+        # that finished it sent both, or this reads nothing.
+        self.assertGreater(r["plain_chunks_after_asker"], 0, r)
+        self.assertFalse(r["plain_got_key"], r)
