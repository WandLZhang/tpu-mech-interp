+++ b/python/sgl_jax/srt/layers/steering.py
@@ -0,0 +1,392 @@
+"""Causal activation steering inside the compiled forward pass.
+
+Steering adds a direction to the residual stream part way through the model:
+
+    h -> h + alpha * v
+
+The hard part is keeping the intervention inside the one program the engine already compiled. A
+prefill graph for a 32-chip slice takes minutes to compile, and the engine holds one executable per
+(batch bucket, token bucket). Anything that decides in Python multiplies that set.
+
+So the hook site is the only thing that compiles in. It's a Python int on the model, set from
+``--steering-layer`` before ``nnx.split()`` bakes it into ``model_def``, the same way
+``layers_to_capture`` works. Everything a request chooses arrives as a device array on
+``ForwardBatch``:
+
+    vectors    [S, D]  the loaded bank, one unit-norm direction per feature
+    probes     [S, D]  the matching read directions
+    slot       [T]     which bank row this token steers with
+    alpha      [T]     length of the shift, 0 for a token nobody asked to steer
+    threshold  [T]     fire above this projection; -inf steers unconditionally, +inf never
+
+One executable therefore covers every feature in the bank, every alpha, every mix of static and
+conditional requests, and every choice of steered tokens. Two requests in one batch can steer with
+different features, because the slot is per token.
+
+A batch nobody asked to steer still carries a ``SteeringBatch``, filled with a slot of 0, an alpha
+of 0 and a threshold of +inf so that no token fires. ``ForwardBatch`` is a registered pytree and
+``forward_batch`` is a jit argument, so ``None`` against a ``SteeringBatch`` is a second treedef
+and a second executable, and the hook widens the stream to float32 in one of them. Building it
+either way is what keeps the count at one and lets the precompiled buckets cover a steering
+request. Inside that one program a ``lax.cond`` on alpha skips the bank gathers and the projection
+when no token steers, so such a batch pays for the float32 widening and one reduction over [T].
+
+Precision. The engine serves a bf16 residual stream. A bf16 add throws a small steering vector
+away: at a per-element residual RMS of 300 with 5,376 dim, 99% of the delta's components come back
+bit-identical. So the hook widens the stream to float32, adds there, and leaves it widened for the
+rest of the stack. Rounding back to bf16 after the add loses the same 99%, so the widening has to
+persist. Every matmul downstream still runs at bf16, because ``LinearBase`` asks for
+``preferred_element_type=params_dtype`` and the MoE dispatch casts its input, so what widens is the
+residual accumulation and nothing else.
+
+Reads widen too. ``projection`` normalizes and contracts in float32, which is what makes the probe
+scale invariant and the fired set stable. A bf16 compare puts 512 tokens on a few hundred distinct
+values, so tokens tie against the threshold, and a token that flips moves the output by the whole
+``alpha * v`` rather than by a rounding-scale amount.
+
+``steering/from_sae.py`` in the interpretability repo writes the bank this module loads: a decoder
+row per feature as the vector, the matching encoder column as the probe, and the fitted JumpReLU
+threshold converted into the units ``projection`` returns.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import json
+import logging
+from typing import NamedTuple
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+from jax.sharding import NamedSharding
+from jax.sharding import PartitionSpec as P
+
+logger = logging.getLogger(__name__)
+
+# The hook runs in float32 inside a bf16 model.
+STEER_DTYPE = jnp.float32
+
+# A float32 matmul at TPU's default precision runs one bf16 pass, which puts a read of the
+# residual stream back at bf16 error. Ask for the float32 result.
+PRECISION = jax.lax.Precision.HIGHEST
+
+# What a token no request steers carries once the bank resolves it.
+NO_SLOT = 0
+NO_ALPHA = 0.0
+NEVER_FIRES = float("inf")
+
+BANK_KEYS = ("features", "vectors", "probes", "thresholds")
+
+
+class SteeringBatch(NamedTuple):
+    """Per-request steering, as device arrays. A pytree child of ``ForwardBatch``."""
+
+    vectors: jax.Array  # [S, D] float32
+    probes: jax.Array  # [S, D] float32
+    slot: jax.Array  # [T] int32
+    alpha: jax.Array  # [T] float32
+    threshold: jax.Array  # [T] float32
+
+
+def projection(h: jax.Array, probe: jax.Array) -> jax.Array:
+    """Read each token's residual stream along its own probe. `[T]` float32.
+
+    ``probe`` is `[D]` for one direction or `[T, D]` for a direction per token. Normalizing in
+    ``h.dtype`` breaks scale invariance: at bf16 a probe rescaled by 10 moves the projection by
+    1.3e-2 against a projection standard deviation of 0.98, which flips tokens across a threshold.
+    """
+    h = h.astype(STEER_DTYPE)
+    probe = probe.astype(STEER_DTYPE)
+    scale = jnp.maximum(
+        jnp.linalg.norm(probe, axis=-1, keepdims=True), jnp.asarray(1e-12, STEER_DTYPE)
+    )
+    unit = probe / scale
+    if unit.ndim == 1:
+        return jnp.dot(h, unit, precision=PRECISION)
+    return jnp.sum(h * unit, axis=-1)
+
+
+def threshold_fire(h: jax.Array, probe: jax.Array, threshold: jax.Array) -> jax.Array:
+    """Which tokens the predicate selects. `[T]` bool.
+
+    ``threshold`` is a scalar or `[T]`. `-inf` fires on every token, which is how static steering
+    rides the same code path as conditional steering. `+inf` fires on none.
+    """
+    return projection(h, probe) > jnp.asarray(threshold, STEER_DTYPE)
+
+
+def static_steer(
+    h: jax.Array,
+    v: jax.Array,
+    alpha: jax.Array,
+    mask: jax.Array,
+) -> jax.Array:
+    """Add ``alpha * v`` to the masked rows of the residual stream. Returns float32.
+
+    ``v`` is `[D]` or `[T, D]`. ``alpha`` is a scalar or `[T]`. Unmasked rows come back as the
+    float32 widening of ``h``, bit for bit.
+    """
+    wide = h.astype(STEER_DTYPE)
+    alpha = jnp.asarray(alpha, STEER_DTYPE)
+    if alpha.ndim:
+        alpha = alpha[:, None]
+    delta = alpha * v.astype(STEER_DTYPE)
+    return jnp.where(mask[:, None], wide + delta, wide)
+
+
+def conditional_steer(
+    h: jax.Array,
+    v: jax.Array,
+    alpha: jax.Array,
+    probe: jax.Array,
+    threshold: jax.Array,
+) -> jax.Array:
+    """Steer the tokens that pass the predicate. Masked select, no branch. Returns float32."""
+    return static_steer(h, v, alpha, threshold_fire(h, probe, threshold))
+
+
+def apply_steering(hidden_states: jax.Array, steering: SteeringBatch | None) -> jax.Array:
+    """The hook a model calls at its steering layer.
+
+    Gathers a direction and a probe per token out of the bank, then runs one masked select.
+    Returns ``hidden_states`` untouched when the batch carries no steering, so a server started
+    without the flag pays nothing. A batch whose every alpha is 0 takes the branch that only
+    widens: nothing it could add moves a row, so the gathers and the projection are skipped.
+    Both branches trace into the one program and return the same float32 rows.
+    """
+    if steering is None:
+        return hidden_states
+    # Under explicit sharding the operand replicates while the indices shard on the token axis,
+    # so jax can't resolve the gather's output sharding and raises ShardingTypeError. The gather
+    # returns one row per token, the shape hidden_states already has, so reuse its sharding. Pass
+    # the NamedSharding rather than a bare PartitionSpec, which needs a mesh context. Under auto
+    # sharding the mesh is empty and None lets the gather resolve on its own.
+    aval_sharding = jax.typeof(hidden_states).sharding
+    aval_mesh = getattr(aval_sharding, "mesh", None)
+    rows = (
+        aval_sharding if aval_mesh is not None and not getattr(aval_mesh, "empty", True) else None
+    )
+
+    def steer(h):
+        v = steering.vectors.at[steering.slot].get(out_sharding=rows)
+        probe = steering.probes.at[steering.slot].get(out_sharding=rows)
+        steered = conditional_steer(h, v, steering.alpha, probe, steering.threshold)
+        # Under explicit sharding both branches have to return one type, sharding included,
+        # and the widened stream keeps the sharding hidden_states has.
+        return steered if rows is None else jax.sharding.reshard(steered, rows)
+
+    def widen(h):
+        return h.astype(STEER_DTYPE)
+
+    return jax.lax.cond(jnp.any(steering.alpha != 0), steer, widen, hidden_states)
+
+
+@dataclasses.dataclass(frozen=True)
+class SteeringBank:
+    """The steering directions a server holds, loaded once at startup.
+
+    ``vectors`` and ``probes`` live on device and replicate across the mesh. They're operands,
+    not trace-time constants, so swapping a bank doesn't recompile.
+
+    ``features`` and ``thresholds`` stay on the host. A request names a feature, and
+    :meth:`resolve` turns per-token feature ids into per-token bank rows. The bank sorts its
+    features once, when it's built, and places the arrays of a batch nobody steers once per token
+    count, so a forward pass nobody steers does neither.
+    """
+
+    features: np.ndarray  # [S] int32
+    thresholds: np.ndarray  # [S] float32, the fitted JumpReLU threshold per feature
+    vectors: jax.Array  # [S, D] float32
+    probes: jax.Array  # [S, D] float32
+    # The bank row of each feature in sorted order, and the sorted features, for slots_for.
+    _order: np.ndarray = dataclasses.field(init=False, repr=False, compare=False)
+    _sorted: np.ndarray = dataclasses.field(init=False, repr=False, compare=False)
+    # all_off's placed arrays, by token count and sharding.
+    _all_off: dict = dataclasses.field(init=False, repr=False, compare=False, default_factory=dict)
+
+    def __post_init__(self):
+        order = np.argsort(self.features)
+        object.__setattr__(self, "_order", order)
+        object.__setattr__(self, "_sorted", self.features[order])
+
+    @classmethod
+    def load(
+        cls,
+        path: str,
+        mesh: jax.sharding.Mesh,
+        hidden_size: int,
+        steering_layer: int | None = None,
+    ) -> SteeringBank:
+        """Read a bank written by ``steering/from_sae.py::save_bank``.
+
+        Checks the site the bank was fit at against ``--steering-layer``. Width can't catch a
+        site mismatch, because every layer of a model is the same width, and a probe read one
+        layer off the distribution it was calibrated on selects a different set of tokens.
+        ``from_sae.py`` copies the SAE's capture slot into ``meta`` and converts it to the
+        ``--steering-layer`` that writes the same tensor, which is one less.
+        """
+        with np.load(path, allow_pickle=False) as data:
+            missing = [key for key in BANK_KEYS if key not in data]
+            if missing:
+                raise ValueError(f"steering bank {path} is missing {missing}")
+            features = np.asarray(data["features"], np.int32)
+            vectors = np.asarray(data["vectors"], np.float32)
+            probes = np.asarray(data["probes"], np.float32)
+            thresholds = np.asarray(data["thresholds"], np.float32)
+            meta = json.loads(str(data["meta"])) if "meta" in data else {}
+
+        # Each of these fails later on the scheduler thread, where it stops the server: a short
+        # thresholds array on the first request for a fitted threshold, an empty bank on the
+        # all-off batch every forward pass builds. A NaN threshold is the sentinel for "use the
+        # fitted one", so it can't stand for a value. +inf marks a dead latent and loads.
+        if (
+            features.ndim != 1
+            or vectors.ndim != 2
+            or vectors.shape != probes.shape
+            or vectors.shape[0] != features.shape[0]
+            or thresholds.shape != features.shape
+        ):
+            raise ValueError(
+                f"steering bank {path} is inconsistent: features {features.shape},"
+                f" thresholds {thresholds.shape}, vectors {vectors.shape}, probes {probes.shape}"
+            )
+        if features.shape[0] == 0:
+            raise ValueError(f"steering bank {path} holds no feature")
+        if np.isnan(thresholds).any() or np.isneginf(thresholds).any():
+            raise ValueError(
+                f"steering bank {path} has a NaN or -inf threshold; a threshold is a number, or"
+                " +inf for a dead latent"
+            )
+        if not (np.isfinite(vectors).all() and np.isfinite(probes).all()):
+            raise ValueError(f"steering bank {path} has a non-finite vector or probe")
+        if vectors.shape[1] != hidden_size:
+            raise ValueError(
+                f"steering bank {path} is {vectors.shape[1]} wide, the model is {hidden_size}"
+            )
+        if len(set(features.tolist())) != features.shape[0]:
+            raise ValueError(f"steering bank {path} lists a feature twice")
+        # A dead latent never fired during calibration. Conditional steering compares against
+        # its +inf and never fires either, but static steering reads no threshold and still adds
+        # the vector to every token it steers.
+        dead = features[np.isposinf(thresholds)]
+        if dead.size:
+            logger.warning(
+                "steering bank %s holds dead latent(s) %s with a +inf threshold. Conditional"
+                " steering never fires them, and static steering still adds their vectors.",
+                path,
+                dead.tolist(),
+            )
+
+        fit_at = meta.get("steering_layer")
+        if fit_at is None:
+            logger.warning(
+                "steering bank %s records no site, so --steering-layer %s goes unchecked."
+                " Rebuild it from an SAE whose checkpoint carries capture_layer.",
+                path,
+                steering_layer,
+            )
+        elif steering_layer is not None and int(fit_at) != int(steering_layer):
+            raise ValueError(
+                f"steering bank {path} was fit on capture slot {meta.get('capture_layer')},"
+                f" which is --steering-layer {int(fit_at)}, but this server was started with"
+                f" --steering-layer {steering_layer}"
+            )
+
+        replicated = NamedSharding(mesh, P())
+        return cls(
+            features=features,
+            thresholds=thresholds,
+            vectors=jax.device_put(jnp.asarray(vectors, STEER_DTYPE), replicated),
+            probes=jax.device_put(jnp.asarray(probes, STEER_DTYPE), replicated),
+        )
+
+    def slots_for(self, feature: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+        """Map per-token feature ids to bank rows.
+
+        Returns ``(slot, known)``. A token with no steering carries -1 and comes back unknown, so
+        the caller zeroes its alpha rather than steering it with row 0.
+        """
+        at = np.searchsorted(self._sorted, feature)
+        at = np.clip(at, 0, self._sorted.shape[0] - 1)
+        slot = self._order[at]
+        known = self.features[slot] == feature
+        return np.where(known, slot, NO_SLOT).astype(np.int32), known
+
+    def all_off(self, num_tokens: int, sharding, place) -> tuple[jax.Array, jax.Array, jax.Array]:
+        """The per-token arrays of a batch nobody steers, placed once per token count.
+
+        Slot 0, alpha 0 and a +inf threshold on every token, which is what :meth:`resolve` gives
+        a batch of -1 features. ``ForwardBatch.init_new`` needs them on every forward pass nobody
+        steers, and its token counts come from a few padded buckets. ``place`` is its
+        ``device_array``, called as ``place(arrays, sharding=sharding)``.
+        """
+        key = (num_tokens, sharding)
+        if key not in self._all_off:
+            self._all_off[key] = place(
+                (
+                    np.full(num_tokens, NO_SLOT, np.int32),
+                    np.full(num_tokens, NO_ALPHA, np.float32),
+                    np.full(num_tokens, NEVER_FIRES, np.float32),
+                ),
+                sharding=sharding,
+            )
+        return self._all_off[key]
+
+    def resolve(
+        self,
+        feature: np.ndarray,
+        alpha: np.ndarray,
+        threshold: np.ndarray,
+    ) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+        """Resolve the scheduler's per-token configuration against the bank, on the host.
+
+        ``feature`` is -1 on a token nobody steers. ``threshold`` is NaN where the request asked
+        for this feature's fitted threshold, -inf for static steering, and a number when the
+        request set one. A feature the bank doesn't hold steers nothing and logs a warning.
+
+        Returns ``(slot, alpha, threshold)`` as host arrays. ``ForwardBatch.init_new`` puts them on
+        the token axis with ``device_array``, like every other per-token array it builds.
+        """
+        feature = np.asarray(feature, np.int32)
+        alpha = np.asarray(alpha, np.float32).copy()
+        threshold = np.asarray(threshold, np.float32).copy()
+
+        slot, known = self.slots_for(feature)
+        wanted = feature >= 0
+        missing = wanted & ~known
+        if missing.any():
+            logger.warning(
+                "steering: %d token(s) asked for feature(s) %s, which the bank doesn't hold",
+                int(missing.sum()),
+                sorted(set(feature[missing].tolist())),
+            )
+        live = wanted & known
+        alpha[~live] = NO_ALPHA
+        threshold[~live] = NEVER_FIRES
+
+        fitted = np.isnan(threshold)
+        threshold[fitted] = self.thresholds[slot[fitted]]
+
+        if logger.isEnabledFor(logging.DEBUG):
+            steered = np.flatnonzero(live)
+            logger.debug(
+                "steering: %d of %d token(s) steer; rows %s, slots %s, alphas %s, thresholds %s",
+                steered.size,
+                feature.shape[0],
+                steered.tolist(),
+                slot[steered].tolist(),
+                alpha[steered].tolist(),
+                threshold[steered].tolist(),
+            )
+        return slot, alpha, threshold
+
+    def batch(self, slot: jax.Array, alpha: jax.Array, threshold: jax.Array) -> SteeringBatch:
