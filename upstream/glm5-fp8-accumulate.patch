@@ -55,6 +59,7 @@ def quantized_matmul_kernel(
 
     if x_q_dtype is None:
         x_q_dtype = x.dtype
+    out_dtype = x.dtype if out_dtype is None else jnp.dtype(out_dtype)
     quantize_activation = x_q_dtype != x.dtype
 
