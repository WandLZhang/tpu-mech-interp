-    # TODO(amandaliang): Make this configurable.
-    acc_dtype = jnp.bfloat16
+    # Each block's float32 dot, its scales and the running sum stay in float32. A BF16
+    # accumulator rounds the running sum after every block, which drops the low bits of every
