             block_size=block_size_in,
             x_q_dtype=x_q_dtype,
             tuned_value=tuned_value,
+            # A row-parallel layer sums the shards' outputs next; keep them in float32 until then.
+            out_dtype=jnp.float32 if reduce_axis is not None else None,
         )
 
     else:
@@ -128,11 +130,12 @@ def xla_quantized_matmul_local(
             )
             out = out.astype(compute_dtype) * jnp.expand_dims(w_scale, 0).astype(compute_dtype)
 
-    out = out.astype(out_dtype)
-    # Reduce across the contracted (input) axis. Caller passes
-    # ``output_scatter_dimension`` only when it has already decided that a
+    # Reduce across the contracted (input) axis in float32 and round once. Rounding each
+    # shard's partial sum to BF16 first adds one rounding per shard, 32 at --tp-size 32.
+    # Caller passes ``output_scatter_dimension`` only when it has already decided that a
     # reduce-scatter on that dim is appropriate AND wired ``out_specs``
     # accordingly; otherwise we do a plain all-reduce.
+    out = out.astype(out_dtype if reduce_axis is None else jnp.float32)
     if reduce_axis is not None:
         if output_scatter_dimension is not None:
             out = lax.psum_scatter(
@@ -140,5 +143,6 @@ def xla_quantized_matmul_local(
             )
         else:
             out = lax.psum(out, axis_name=reduce_axis)
+        out = out.astype(out_dtype)
 
     return out
