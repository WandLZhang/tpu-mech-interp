index 00000000..745a691b
--- /dev/null
+++ b/python/sgl_jax/srt/models/gpt_oss.py
@@ -0,0 +1,923 @@
+"""gpt-oss (openai/gpt-oss-20b, openai/gpt-oss-120b).
+
+Alternating sliding-window(128) and full attention, GQA 64 query over 8 KV heads at
+head_dim 64, a learned attention sink per query head, YaRN rope, and a MoE block whose
+experts use the clamped SwiGLU from the gpt-oss reference.
+
+The checkpoint is mixed precision. Attention, router, norms, embeddings and the LM head
+ship BF16. The two expert GEMMs ship MXFP4: a ``*_blocks`` tensor packing two FP4 E2M1
+codes per byte and a ``*_scales`` tensor of E8M0 exponents, one per 32 elements of the
+reduction axis. ``_load_mxfp4_experts`` decodes both into the dense BF16 layout EPMoE
+wants.
+"""
+
+import logging
+from concurrent.futures import ThreadPoolExecutor
+from typing import Any
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import safetensors
+from flax import nnx
+from jax.sharding import NamedSharding
+from jax.sharding import PartitionSpec as P
+from transformers import PretrainedConfig
+
+from sgl_jax.srt.configs.model_config import ModelConfig
+from sgl_jax.srt.configs.quantization_config import QuantizationConfig
+from sgl_jax.srt.eplb.expert_location import get_global_expert_location_metadata
+from sgl_jax.srt.layers.embeddings import Embed, ParallelLMHead, get_rope
+from sgl_jax.srt.layers.layernorm import RMSNorm
+from sgl_jax.srt.layers.linear import LinearBase
+from sgl_jax.srt.layers.logits_processor import LogitsMetadata, LogitsProcessor
+from sgl_jax.srt.layers.moe import EPMoE, GateLogit, TopK
+from sgl_jax.srt.layers.radix_attention import RadixAttention
+from sgl_jax.srt.mem_cache.memory_pool import KVCache, MemoryPools
+from sgl_jax.srt.model_executor.forward_batch_info import ForwardBatch
+from sgl_jax.srt.precision_tracer import precision_tracer
+from sgl_jax.srt.utils.profiling_utils import named_scope
+from sgl_jax.srt.utils.weight_utils import WeightLoader, WeightMapping
+
+logger = logging.getLogger(__name__)
+
+# FP4 E2M1 code point values, indexed by the 4-bit code.
+FP4_E2M1_VALUES = np.array(
+    [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0, -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0],
+    dtype=np.float32,
+)
+
+# One E8M0 scale covers this many elements of the reduction axis.
+MXFP4_BLOCK_SIZE = 32
+
+# Blocks decoded per pass. A pass holds a float32 staging buffer of
+# ``MXFP4_DECODE_BLOCKS * 32 * 4`` bytes, 32 MiB, whatever the tensor size. Decoding a
+# 120b gate_up_proj in one pass would hold 7.9 GiB of staging instead.
+MXFP4_DECODE_BLOCKS = 1 << 18
+
+# Passes that run at once. The gather and the multiply both drop the GIL, so threads
+# scale. On 8 vCPUs, 8 of them decode a 120b gate_up_proj in 8.9s against 19.6s serial.
+MXFP4_DECODE_THREADS = 8
+
+
+def dequantize_mxfp4(
+    blocks: np.ndarray, scales: np.ndarray, dtype: np.dtype = np.float32
+) -> np.ndarray:
+    """Decode one MXFP4 tensor.
+
+    Each pass decodes a slice of the block axis into a preallocated output, so peak host
+    memory is the output plus up to 52 MiB of scratch per thread. One gpt-oss-120b
+    gate_up_proj packs 0.99 GiB of blocks and decodes to 3.96 GiB of BF16. At 8 threads
+    its peak RSS growth is 4.3 times the packed tensor, 317 MiB over the output.
+
+    Args:
+        blocks: uint8 ``[..., out, k // 32, 16]``. Each byte holds two FP4 E2M1 codes.
+            The low nibble is the earlier element along the reduction axis.
+        scales: uint8 ``[..., out, k // 32]``. Biased E8M0 exponents, so the block
+            multiplier is ``2 ** (scale - 127)``.
+        dtype: output dtype. Pass the serving dtype to skip a float32 round trip.
+
+    Returns:
+        ``dtype`` ``[..., out, k]``.
+    """
+    if blocks.shape[:-1] != scales.shape:
+        raise ValueError(f"MXFP4 block shape {blocks.shape} does not match scales {scales.shape}")
+    if blocks.shape[-1] * 2 != MXFP4_BLOCK_SIZE:
+        raise ValueError(
+            f"MXFP4 expects {MXFP4_BLOCK_SIZE // 2} bytes per block, got {blocks.shape[-1]}"
+        )
+
+    flat_blocks = blocks.reshape(-1, blocks.shape[-1])
+    flat_scales = scales.reshape(-1, 1)
+    out = np.empty((flat_blocks.shape[0], MXFP4_BLOCK_SIZE), dtype=dtype)
+
+    def decode(start: int) -> None:
+        stop = min(start + MXFP4_DECODE_BLOCKS, flat_blocks.shape[0])
+        packed = flat_blocks[start:stop]
+        staging = np.empty((stop - start, MXFP4_BLOCK_SIZE), dtype=np.float32)
+        staging[:, 0::2] = FP4_E2M1_VALUES[packed & 0x0F]
+        staging[:, 1::2] = FP4_E2M1_VALUES[packed >> 4]
+        staging *= np.exp2(flat_scales[start:stop].astype(np.float32) - 127.0)
+        out[start:stop] = staging
+
+    starts = range(0, flat_blocks.shape[0], MXFP4_DECODE_BLOCKS)
+    workers = min(MXFP4_DECODE_THREADS, len(starts))
+    if workers > 1:
+        with ThreadPoolExecutor(max_workers=workers) as pool:
+            list(pool.map(decode, starts))
+    else:
+        for start in starts:
+            decode(start)
+
+    return out.reshape(*blocks.shape[:-2], -1)
+
+
+def _quantization_config(config: PretrainedConfig) -> QuantizationConfig | None:
+    """The quantization `ModelConfig` resolved for this run, or None.
+
+    `ModelConfig` puts a `QuantizationConfig` on the config when the user passes
+    `--quantization-config-path`. The published `config.json` carries its own
+    `quantization_config`, the `mxfp4` dict that describes the packed experts, and
+    `ModelConfig` leaves that dict in place. `EPMoE` calls methods on what it gets, so
+    only the object goes through. Without one, the experts stay in the serving dtype
+    `_load_mxfp4_experts` decodes them to.
+    """
+    quant = getattr(config, "quantization_config", None)
+    return quant if isinstance(quant, QuantizationConfig) else None
+
+
+def _layer_type(config: PretrainedConfig, layer_id: int) -> str:
+    """The attention type of one layer.
+
+    gpt-oss alternates, starting with a sliding layer.
+    ``transformers.GptOssConfig`` fills ``layer_types`` in when the checkpoint omits it,
+    so a config that arrives without one still gets the alternation. A list that's
+    present but too short describes a different architecture, so it raises instead of
+    turning the tail of the stack into full attention.
+    """
+    layer_types = getattr(config, "layer_types", None)
+    if layer_types is None:
+        return "sliding_attention" if layer_id % 2 == 0 else "full_attention"
+    if layer_id >= len(layer_types):
+        raise ValueError(
+            f"layer_types holds {len(layer_types)} entries, so layer {layer_id} has no "
+            f"attention type. gpt-oss needs one entry per layer."
+        )
+    return layer_types[layer_id]
+
+
+class GptOssAttention(nnx.Module):
+    """GQA with a learned sink logit per query head.
+
+    The sink is an extra column in the softmax that carries no value, so a head can hold
+    back probability mass instead of spending all of it on the sequence. It rides through
+    ``RadixAttention`` as the ``attention_sink`` keyword, which the ragged paged attention
+    kernel reads.
+    """
+
+    def __init__(
+        self,
+        config: PretrainedConfig,
+        layer_id: int,
+        mesh: jax.sharding.Mesh,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.layer_id = layer_id
+        self.mesh = mesh
+        hidden_size = config.hidden_size
+        attention_bias = getattr(config, "attention_bias", True)
+
+        self.layer_type = _layer_type(config, layer_id)
+        self.is_sliding = self.layer_type == "sliding_attention"
+        self.sliding_window = getattr(config, "sliding_window", 0) if self.is_sliding else 0
+
+        self.head_dim = getattr(config, "head_dim", hidden_size // config.num_attention_heads)
+        self.q_head_num = config.num_attention_heads
+        self.kv_head_num = config.num_key_value_heads
+        self.scaling = self.head_dim**-0.5
+
+        self.q_proj = LinearBase(
+            input_size=hidden_size,
+            output_size=self.q_head_num * self.head_dim,
+            use_bias=attention_bias,
+            kernel_axes=(None, "tensor"),
+            params_dtype=dtype,
+            mesh=mesh,
+            scope_name="q_proj",
+        )
+        self.k_proj = LinearBase(
+            input_size=hidden_size,
+            output_size=self.kv_head_num * self.head_dim,
+            use_bias=attention_bias,
+            kernel_axes=(None, "tensor"),
+            params_dtype=dtype,
+            mesh=mesh,
+            scope_name="k_proj",
+        )
+        self.v_proj = LinearBase(
+            input_size=hidden_size,
+            output_size=self.kv_head_num * self.head_dim,
+            use_bias=attention_bias,
+            kernel_axes=(None, "tensor"),
+            params_dtype=dtype,
+            mesh=mesh,
+            scope_name="v_proj",
+        )
+        self.o_proj = LinearBase(
+            input_size=self.q_head_num * self.head_dim,
+            output_size=hidden_size,
+            use_bias=attention_bias,
+            kernel_axes=("tensor", None),
+            params_dtype=dtype,
+            mesh=mesh,
+            scope_name="o_proj",
+        )
+
+        # The kernel reads the sinks in float32 and shards them over query heads, the
+        # same axis the q/k/v projections split on.
+        self.sinks = nnx.Param(
+            jnp.zeros((self.q_head_num,), dtype=jnp.float32, out_sharding=P("tensor"))
+        )
+
+        # transformers 5 folds rope_theta into the rope parameter dict and drops the
+        # top-level attribute, so read the dict first and fall back to the attribute.
+        rope_scaling = dict(
+            getattr(config, "rope_parameters", None) or getattr(config, "rope_scaling", None) or {}
+        )
+        rope_theta = rope_scaling.get("rope_theta") or getattr(config, "rope_theta", 150000)
+        self.rotary_emb = get_rope(
+            head_size=self.head_dim,
+            rotary_dim=self.head_dim,
+            max_position=getattr(config, "max_position_embeddings", 131072),
+            base=rope_theta,
+            is_neox_style=True,
+            rope_scaling=rope_scaling or None,
+            dtype=dtype,
+        )
+
+        self.attn = RadixAttention(
+            num_heads=self.q_head_num,
+            head_dim=self.head_dim,
+            scaling=self.scaling,
+            num_kv_heads=self.kv_head_num,
+            layer_id=layer_id,
+            sliding_window_size=self.sliding_window,
+        )
+
+    @named_scope
+    def __call__(
+        self,
+        positions: jax.Array,
+        hidden_states: jax.Array,
+        forward_batch: ForwardBatch,
+        token_to_kv_pool: KVCache,
+        *,
+        out_sharding: jax.sharding.Sharding | None = None,
+    ) -> tuple[jax.Array, jax.Array]:
+        q, _ = self.q_proj(hidden_states)
+        k, _ = self.k_proj(hidden_states)
+        v, _ = self.v_proj(hidden_states)
+
+        q = q.reshape(
+            -1,
+            self.q_head_num,
+            self.head_dim,
+            out_sharding=NamedSharding(self.mesh, P("data", "tensor", None)),
+        )
+        k = k.reshape(
+            -1,
+            self.kv_head_num,
+            self.head_dim,
+            out_sharding=NamedSharding(self.mesh, P("data", "tensor", None)),
+        )
+        v = v.reshape(
+            -1,
+            self.kv_head_num,
+            self.head_dim,
+            out_sharding=NamedSharding(self.mesh, P("data", "tensor", None)),
+        )
+
+        q, k = self.rotary_emb(positions, q, k)
+
+        attn_output, kv_fused = self.attn(
+            q,
+            k,
+            v,
+            forward_batch,
+            token_to_kv_pool,
+            attention_sink=self.sinks.value.astype(jnp.float32),
+        )
+
+        output, _ = self.o_proj(attn_output, out_sharding=out_sharding)
+        return output, kv_fused
+
+
+class GptOssRouter(nnx.Module):
+    """Linear router with a per-expert bias, scored by softmax.
+
+    gpt-oss takes the top-k raw logits and softmaxes those. Softmax is monotonic, so
+    softmaxing first and renormalizing the selected entries gives the same weights, which
+    is what ``TopK(renormalize=True)`` does downstream.
+    """
+
+    def __init__(
+        self,
+        config: PretrainedConfig,
+        dtype: jnp.dtype = jnp.bfloat16,
+        mesh: jax.sharding.Mesh | None = None,
+    ):
+        self.hidden_size = config.hidden_size
+        self.num_experts = getattr(config, "num_local_experts", 128)
+        self.proj = GateLogit(
+            input_size=self.hidden_size,
+            num_experts=self.num_experts,
+            weight_dtype=dtype,
+            enable_expert_bias=True,
+            kernel_dtype=dtype,
+            compute_dtype=jnp.float32,
+            bias_dtype=jnp.float32,
+            score_func=None,
+        )
+
+    def __call__(self, hidden_states: jax.Array) -> jax.Array:
+        router_logits = self.proj(hidden_states) + self.proj.bias.value
+        return jax.nn.softmax(router_logits.astype(jnp.float32), axis=-1)
+
+
+class GptOssSparseMoeBlock(nnx.Module):
+    """Router, top-k selection and the expert GEMMs."""
+
+    def __init__(
+        self,
+        config: PretrainedConfig,
+        mesh: jax.sharding.Mesh,
+        layer_id: int = 0,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.layer_id = layer_id
+        self.mesh = mesh
+        num_experts = getattr(config, "num_local_experts", 128)
+        num_experts_per_tok = getattr(config, "num_experts_per_tok", 4)
+
+        self.router = GptOssRouter(config=config, dtype=dtype, mesh=mesh)
+        self.topk = TopK(
+            topk=num_experts_per_tok,
+            renormalize=True,
+            layer_id=layer_id,
+            mesh=mesh,
+        )
+        self.experts = EPMoE(
+            hidden_size=config.hidden_size,
+            num_experts=num_experts,
+            num_experts_per_tok=num_experts_per_tok,
+            intermediate_dim=config.intermediate_size,
+            mesh=mesh,
+            ep_size=getattr(config, "ep_size", 1),
+            weight_dtype=dtype,
+            dtype=dtype,
+            activation="swiglu_oai",
+            activation_alpha=getattr(config, "swiglu_alpha", 1.702),
+            activation_limit=getattr(config, "swiglu_limit", 7.0),
+            use_expert_bias=True,
+            layer_id=layer_id,
+            quantization_config=_quantization_config(config),
+        )
+
+    @named_scope
+    def __call__(
+        self,
+        hidden_states: jax.Array,
+        forward_batch: ForwardBatch,
+    ) -> tuple[jax.Array, jax.Array]:
+        router_scores = self.router(hidden_states)
+        # TopK turns logical expert ids into physical ones when EPLB is on, the same
+        # call deepseek_v3 and qwen3_moe make. EPMoE sizes its weights at the physical
+        # count, and the loader fills every slot.
+        topk_weights, topk_ids = self.topk(
+            router_scores,
+            dispatch_info=getattr(forward_batch, "expert_location_metadata", None),
+        )
+
+        output = self.experts(hidden_states, topk_weights, topk_ids)
+        return output, jax.sharding.reshard(topk_ids, P(None))
+
+
+class GptOssDecoderLayer(nnx.Module):
+    def __init__(
+        self,
+        config: PretrainedConfig,
+        mesh: jax.sharding.Mesh,
+        layer_id: int = 0,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.layer_id = layer_id
+        self.hidden_size = config.hidden_size
+        rms_norm_eps = getattr(config, "rms_norm_eps", 1e-5)
+
+        self.input_layernorm = RMSNorm(
+            config.hidden_size,
+            epsilon=rms_norm_eps,
+            param_dtype=dtype,
+            scope_name="input_layernorm",
+        )
+        self.self_attn = GptOssAttention(
+            config=config,
+            layer_id=layer_id,
+            mesh=mesh,
+            dtype=dtype,
+        )
+        self.post_attention_layernorm = RMSNorm(
+            config.hidden_size,
+            epsilon=rms_norm_eps,
+            param_dtype=dtype,
+            scope_name="post_attention_layernorm",
+        )
+        self.mlp = GptOssSparseMoeBlock(
+            config=config,
+            mesh=mesh,
+            layer_id=layer_id,
+            dtype=dtype,
+        )
+
+    def __call__(
+        self,
+        positions: jax.Array,
+        hidden_states: jax.Array,
+        forward_batch: ForwardBatch,
+        token_to_kv_pool: KVCache,
+        residual: jax.Array | None = None,
+    ):
+        layer_callback_flag = []
+        if residual is None:
+            residual = hidden_states
+            hidden_states = self.input_layernorm(hidden_states)
+        else:
+            hidden_states += residual
+            residual = hidden_states
+            hidden_states = self.input_layernorm(hidden_states)
+
+        layer_norm_callback_flag = precision_tracer.jit_pure_callback_record(
+            hidden_states, "input_layernorm_output", "INPUT_LAYERNORM", self.layer_id
+        )
+        layer_callback_flag.append(layer_norm_callback_flag)
+
+        hidden_states, kv_fused = self.self_attn(
+            positions=positions,
+            hidden_states=hidden_states,
+            forward_batch=forward_batch,
+            token_to_kv_pool=token_to_kv_pool,
+        )
+
+        attn_callback_flag = precision_tracer.jit_pure_callback_record(
+            hidden_states, "self_attn_output", "SELF_ATTN", self.layer_id
+        )
+        layer_callback_flag.append(attn_callback_flag)
+
+        hidden_states += residual
+        residual = hidden_states
+        hidden_states = self.post_attention_layernorm(hidden_states)
+        hidden_states, topk_ids = self.mlp(hidden_states, forward_batch)
+
+        mlp_callback_flag = precision_tracer.jit_pure_callback_record(
+            hidden_states, "mlp_output", "MLP", self.layer_id
+        )
+        layer_callback_flag.append(mlp_callback_flag)
+
+        return hidden_states, residual, kv_fused, layer_callback_flag, topk_ids
+
+
+class GptOssModel(nnx.Module):
+    def __init__(
+        self,
+        config: PretrainedConfig,
+        mesh: jax.sharding.Mesh,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.embed_tokens = Embed(
+            num_embeddings=config.vocab_size,
+            features=config.hidden_size,
+            dtype=dtype,
+            kernel_axes=("tensor", None),
+            param_dtype=dtype,
+            mesh=mesh,
+        )
+
+        self.layers = nnx.data(
+            [
+                GptOssDecoderLayer(
+                    config=config,
+                    layer_id=i,
+                    dtype=dtype,
+                    mesh=mesh,
+                )
+                for i in range(config.num_hidden_layers)
+            ]
+        )
+
+        self.norm = RMSNorm(
+            config.hidden_size,
+            epsilon=getattr(config, "rms_norm_eps", 1e-5),
+            param_dtype=dtype,
+            scope_name="norm",
+        )
+        self.layers_to_capture = []
+
+    def __call__(
+        self,
+        forward_batch: ForwardBatch,
+        token_to_kv_pool: KVCache,
+        positions: jax.Array | None = None,
+    ):
+        residual = None
+        hidden_states = (
+            self.embed_tokens(forward_batch.input_ids)
+            if forward_batch.input_embedding is None
+            else forward_batch.input_embedding
+        )
+        layers_kv_fused = []
+        layers_callback_flag = []
+        layers_topk_ids = []
+        aux_hidden_states = []
+        positions = forward_batch.positions if positions is None else positions
+        for layer_id, layer in enumerate(self.layers):
+            if layer_id in self.layers_to_capture:
+                aux_hidden_states.append(
+                    hidden_states + residual if residual is not None else hidden_states
+                )
+            hidden_states, residual, kv_fused, callback_flag, topk_ids = layer(
+                positions,
+                hidden_states,
+                forward_batch,
+                token_to_kv_pool,
+                residual,
+            )
+            layers_kv_fused.append(kv_fused)
+            layers_callback_flag.extend(callback_flag)
+            layers_topk_ids.append(topk_ids)
+
+        if residual is not None:
+            hidden_states += residual
+        hidden_states = self.norm(hidden_states)
+
+        callback_flag = precision_tracer.jit_pure_callback_record(
+            hidden_states, "transformer_output", "TRANSFORMER"
+        )
+        layers_callback_flag.append(callback_flag)
+        return (
+            hidden_states,
+            aux_hidden_states,
+            layers_kv_fused,
+            layers_callback_flag,
+            layers_topk_ids,
+        )
+
+
+class GptOssForCausalLM(nnx.Module):
+    def __init__(
+        self,
+        config: PretrainedConfig,
+        mesh: jax.sharding.Mesh,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.mesh = mesh
+        self.config = config
+        self.dtype = dtype
+        # The expert decode runs on the host, so it needs the numpy spelling of the
+        # serving dtype. ``jnp.dtype`` resolves bfloat16 to the ml_dtypes scalar numpy
+        # understands.
+        self.np_dtype = jnp.dtype(dtype)
+        logger.info("GptOssForCausalLM config dtype: %s", self.dtype)
+        self.model = GptOssModel(config, dtype=self.dtype, mesh=mesh)
+        if not getattr(self.config, "tie_word_embeddings", False):
+            self.lm_head = ParallelLMHead(
+                config.vocab_size,
+                config.hidden_size,
+                dtype=self.dtype,
+                param_dtype=self.dtype,
+                mesh=mesh,
+                enable_dp_lm_head=getattr(config, "enable_dp_lm_head", False),
+            )
+        self.logits_processor = LogitsProcessor(
+            config.vocab_size,
+            mesh=mesh,
+            enable_dp_lm_head=getattr(config, "enable_dp_lm_head", False),
+        )
+
+        self.capture_aux_hidden_states = False
+
+    def load_weights(self, model_config: ModelConfig):
+        loader = WeightLoader(
+            model=self,
+            model_config=model_config,
+            mesh=self.mesh,
+            dtype=self.dtype,
+        )
+
+        if loader.dummy_mode:
+            # The loader's dummy pass fills every parameter the mapping table leaves out, and
+            # it drops the "expert" axis the model mesh doesn't carry, so an expert stack it
+            # filled would land whole on every chip. Fill the experts first, on EPMoE's mesh.
+            self._init_dummy_experts(loader)
+
+        loader.load_weights_from_safetensors(self._create_gpt_oss_weight_mappings())
+
+        if not loader.dummy_mode:
+            self._load_mxfp4_experts(loader)
+
+        logger.info("gpt-oss weights loaded successfully!")
+
+    def _create_gpt_oss_weight_mappings(self) -> dict:
+        """Everything except the two MXFP4 expert GEMMs.
+
+        The expert tensors need block decoding and an even/odd deinterleave, so they load
+        in ``_load_mxfp4_experts`` instead.
+        """
+        mappings = {
+            "model.embed_tokens.weight": WeightMapping(
+                target_path="model.embed_tokens.embedding",
+                sharding=("tensor", None),
+                transpose=False,
+            ),
+            "model.norm.weight": WeightMapping(
+                target_path="model.norm.scale", sharding=(None,), transpose=False
+            ),
+        }
+
+        if not getattr(self.config, "tie_word_embeddings", False):
+            mappings["lm_head.weight"] = WeightMapping(
+                target_path="lm_head.embedding", sharding=("tensor", None), transpose=False
+            )
+
+        for layer_idx in range(self.config.num_hidden_layers):
+            mappings.update(self._create_layer_mappings(layer_idx))
+
+        return mappings
+
+    def _create_layer_mappings(self, layer_idx: int) -> dict:
+        prefix = f"model.layers.{layer_idx}"
+
+        mappings = {
+            f"{prefix}.input_layernorm.weight": WeightMapping(
+                target_path=f"{prefix}.input_layernorm.scale",
+                sharding=(None,),
+                transpose=False,
+            ),
+            f"{prefix}.post_attention_layernorm.weight": WeightMapping(
+                target_path=f"{prefix}.post_attention_layernorm.scale",
+                sharding=(None,),
+                transpose=False,
+            ),
+            f"{prefix}.self_attn.sinks": WeightMapping(
+                target_path=f"{prefix}.self_attn.sinks",
+                sharding=("tensor",),
+                transpose=False,
+            ),
+            f"{prefix}.mlp.router.weight": WeightMapping(
+                target_path=f"{prefix}.mlp.router.proj.kernel",
+                sharding=(None, None),
+                transpose=True,
+            ),
+            f"{prefix}.mlp.router.bias": WeightMapping(
+                target_path=f"{prefix}.mlp.router.proj.bias",
+                sharding=(None,),
+                transpose=False,
+            ),
+        }
+
+        for proj, kv_pad in (("q_proj", False), ("k_proj", True), ("v_proj", True)):
+            mappings[f"{prefix}.self_attn.{proj}.weight"] = WeightMapping(
+                target_path=f"{prefix}.self_attn.{proj}.weight",
+                sharding=(None, "tensor"),
+                transpose=True,
+                kv_head_padding=kv_pad,
+            )
+            mappings[f"{prefix}.self_attn.{proj}.bias"] = WeightMapping(
+                target_path=f"{prefix}.self_attn.{proj}.bias",
+                sharding=(None,),
+                transpose=False,
+                kv_head_padding=kv_pad,
+            )
+
+        mappings[f"{prefix}.self_attn.o_proj.weight"] = WeightMapping(
+            target_path=f"{prefix}.self_attn.o_proj.weight",
+            sharding=("tensor", None),
+            transpose=True,
+            kv_head_padding=False,
+        )
+        mappings[f"{prefix}.self_attn.o_proj.bias"] = WeightMapping(
+            target_path=f"{prefix}.self_attn.o_proj.bias",
+            sharding=(None,),
+            transpose=False,
+        )
+
+        return mappings
+
+    def _expert_shardings(self, experts: EPMoE) -> tuple[Any, Any, Any, Any]:
+        """Device shardings for one expert block, or None when the mesh has no expert axis."""
+        moe_mesh = getattr(experts, "moe_mesh", None)
+        if moe_mesh is None:
+            return None, None, None, None
+        wi = NamedSharding(moe_mesh, P("expert", None, "tensor"))
+        wo = NamedSharding(moe_mesh, P("expert", "tensor", None))
+        wi_bias = NamedSharding(moe_mesh, P("expert", None, "tensor"))
+        wo_bias = NamedSharding(moe_mesh, P("expert", None, None))
+        return wi, wo, wi_bias, wo_bias
+
+    def _put(self, array: np.ndarray, sharding, expert_map: np.ndarray | None = None) -> jax.Array:
+        """Place one host array on its devices, one shard at a time.
+
+        ``jnp.asarray`` puts the whole array on one device and leaves the split to a
+        later reshard, so a 2.12 GB expert GEMM occupies a chip whole before it settles
+        at its 66 MB share, and a multi-host load has to gather to do it.
+        ``jax.make_array_from_callback`` cuts each shard on the host and asks only for
+        the shards this process owns, which is the same reason the shipped MoE loader
+        uses it.
+
+        ``expert_map`` is the layer's row of ``physical_to_logical_map``. With EPLB
+        redundant experts the parameter carries more physical slots than the checkpoint
+        carries experts, and slot ``p`` holds a copy of logical expert
+        ``expert_map[p]``.
+        """
+        value = np.asarray(array, dtype=self.np_dtype)
+        shape = value.shape if expert_map is None else (len(expert_map), *value.shape[1:])
+
+        if sharding is None:
+            return jnp.asarray(value if expert_map is None else value[expert_map])
+
+        def shard(index):
+            if expert_map is None:
+                return value[index]
+            return value[expert_map[index[0]]][(slice(None), *index[1:])]
+
+        return jax.make_array_from_callback(shape, sharding, shard)
+
+    def _expert_map(self) -> np.ndarray | None:
+        """``physical_to_logical_map``, or None when EPLB is off.
+
+        EPMoE sizes its parameters at ``num_physical_experts`` whenever expert-location
+        metadata exists, and ``TopK`` rewrites logical expert ids into physical ones.
+        The loader fills the redundant slots so the routing has somewhere to land.
+        """
+        metadata = get_global_expert_location_metadata()
+        if metadata is None:
+            return None
+        return np.asarray(jax.device_get(metadata.physical_to_logical_map))
+
+    def _load_mxfp4_experts(self, loader: WeightLoader) -> None:
+        """Decode the MXFP4 expert GEMMs into EPMoE's dense BF16 parameters.
+
+        ``gate_up_proj`` interleaves the two halves of the SwiGLU along its output axis:
+        even columns are the gate, odd columns are the linear half. EPMoE keeps them as
+        separate ``wi_0`` and ``wi_1`` weights, so the deinterleave happens here.
+
+        The checkpoint stores each GEMM as ``[experts, out, in]``. EPMoE wants
+        ``[experts, in, out]``, so both weights transpose on the way in.
+
+        Each GEMM decodes, places and then goes out of scope before the next one reads,
+        which holds one decoded tensor at a time.
+        """
+        weight_info = loader._scan_weight_info()
+        physical_to_logical_map = self._expert_map()
+
+        for layer_idx, layer in enumerate(self.model.layers):
+            experts = layer.mlp.experts
+            wi_shd, wo_shd, wi_bias_shd, wo_bias_shd = self._expert_shardings(experts)
+            prefix = f"model.layers.{layer_idx}.mlp.experts"
+
+            expert_map = None
+            if physical_to_logical_map is not None:
+                expert_map = physical_to_logical_map[layer_idx]
+                if len(expert_map) != experts.num_experts:
+                    raise ValueError(
+                        f"layer {layer_idx} allocates {experts.num_experts} physical experts "
+                        f"but expert-location metadata describes {len(expert_map)}"
+                    )
+
+            gate_up = self._read_mxfp4_tensor(weight_info, f"{prefix}.gate_up_proj")
+            self._check_expert_count(gate_up, expert_map, f"{prefix}.gate_up_proj")
+            experts.wi_0.value = self._put(
+                gate_up[:, 0::2, :].transpose(0, 2, 1), wi_shd, expert_map
+            )
+            experts.wi_1.value = self._put(
+                gate_up[:, 1::2, :].transpose(0, 2, 1), wi_shd, expert_map
+            )
+            del gate_up
+
+            gate_up_bias = self._read_plain_tensor(weight_info, f"{prefix}.gate_up_proj_bias")
+            experts.wi_0_bias.value = self._put(
+                gate_up_bias[:, None, 0::2], wi_bias_shd, expert_map
+            )
+            experts.wi_1_bias.value = self._put(
+                gate_up_bias[:, None, 1::2], wi_bias_shd, expert_map
+            )
+            del gate_up_bias
+
+            down = self._read_mxfp4_tensor(weight_info, f"{prefix}.down_proj")
+            self._check_expert_count(down, expert_map, f"{prefix}.down_proj")
+            experts.wo.value = self._put(down.transpose(0, 2, 1), wo_shd, expert_map)
+            del down
+
+            down_bias = self._read_plain_tensor(weight_info, f"{prefix}.down_proj_bias")
+            experts.wo_bias.value = self._put(down_bias[:, None, :], wo_bias_shd, expert_map)
+            del down_bias
+
+    @staticmethod
+    def _check_expert_count(tensor: np.ndarray, expert_map: np.ndarray | None, key: str) -> None:
+        if expert_map is None:
+            return
+        highest = int(expert_map.max())
+        if highest >= tensor.shape[0]:
+            raise ValueError(
+                f"{key} holds {tensor.shape[0]} experts but expert-location metadata "
+                f"points at logical expert {highest}"
+            )
+
+    def _init_dummy_experts(self, loader: WeightLoader) -> None:
+        """Zeroed expert parameters in EPMoE's layout, for a dummy-weight run.
+
+        ``load_weights`` calls this before the loader's dummy pass. That pass fills every
+        parameter the mapping table leaves out, and it drops the "expert" axis the model
+        mesh doesn't carry, so an expert stack it filled would sit whole on every chip,
+        6.37 GB a layer on gpt-oss-120b. A stack this fills first is already an array, and
+        the pass skips it.
+        """
+        for layer in self.model.layers:
+            experts = layer.mlp.experts
+            wi_shd, wo_shd, wi_bias_shd, wo_bias_shd = self._expert_shardings(experts)
+            for param, sharding in (
+                (experts.wi_0, wi_shd),
+                (experts.wi_1, wi_shd),
+                (experts.wo, wo_shd),
+                (experts.wi_0_bias, wi_bias_shd),
+                (experts.wi_1_bias, wi_bias_shd),
+                (experts.wo_bias, wo_bias_shd),
+            ):
+                # The loader's allocator builds the zeros already sharded, so no chip holds
+                # a whole-tensor copy on the way in. It also serves the abstract load.
+                target = param.value
+                param.value = loader._dummy_array(target.shape, target.dtype, sharding)
+
+    @staticmethod
+    def _read_plain_tensor(weight_info: dict, key: str) -> np.ndarray:
+        if key not in weight_info:
+            raise KeyError(f"gpt-oss checkpoint is missing {key}")
+        with safetensors.safe_open(weight_info[key][0]["file"], framework="np", device="cpu") as f:
+            return np.asarray(f.get_tensor(key), dtype=np.float32)
+
+    def _read_mxfp4_tensor(self, weight_info: dict, key: str) -> np.ndarray:
+        blocks = self._read_raw_tensor(weight_info, f"{key}_blocks")
+        scales = self._read_raw_tensor(weight_info, f"{key}_scales")
+        # Every FP4 code and every E8M0 scale is a power of two times a 2-bit mantissa,
+        # so decoding straight to the serving dtype is lossless and skips a float32 copy
+        # three times the size of the result.
+        return dequantize_mxfp4(blocks, scales, dtype=self.np_dtype)
+
+    @staticmethod
+    def _read_raw_tensor(weight_info: dict, key: str) -> np.ndarray:
+        if key not in weight_info:
+            raise KeyError(f"gpt-oss checkpoint is missing {key}")
+        with safetensors.safe_open(weight_info[key][0]["file"], framework="np", device="cpu") as f:
+            return np.asarray(f.get_tensor(key))
+
+    def get_embed_and_head(self):
+        return (
+            self.model.embed_tokens.embedding.value,
+            self.lm_head.embedding.value,
+        )
+
+    def set_embed_and_head(
+        self,
+        embed_weight: jax.Array | None = None,
+        head_weight: jax.Array | None = None,
+    ) -> None:
+        if embed_weight is not None:
+            self.model.embed_tokens.embedding.value = embed_weight
+        if head_weight is not None:
+            self.lm_head.embedding.value = head_weight
+
+    def set_eagle3_layers_to_capture(self, layer_ids: list[int] | None = None):
+        self.capture_aux_hidden_states = True
+        if layer_ids is None:
+            num_layers = self.config.num_hidden_layers
+            self.model.layers_to_capture = [2, num_layers // 2, num_layers - 3]
+        else:
+            self.model.layers_to_capture = [val + 1 for val in layer_ids]
+
+    def set_dflash_layers_to_capture(self, layer_ids: list[int]):
+        if layer_ids is None:
+            raise ValueError("DFLASH requires explicit target layer ids.")
+        self.capture_aux_hidden_states = True
+        self.model.layers_to_capture = [val + 1 for val in layer_ids]
+
+    def __call__(
+        self,
+        forward_batch: ForwardBatch,
+        memory_pools: MemoryPools,
+        logits_metadata: LogitsMetadata,
+    ):
+        kv_pool = memory_pools.token_to_kv_pool
+        (
+            hidden_states,
+            aux_hidden_states,
+            layers_kv_fused,
+            layers_callback_flag,
+            layers_topk_ids,
+        ) = self.model(forward_batch, kv_pool)
+        if not self.capture_aux_hidden_states:
+            aux_hidden_states = None
+        if not getattr(self.config, "tie_word_embeddings", False):
+            output = self.logits_processor(
+                hidden_states, self.lm_head, logits_metadata, aux_hidden_states=aux_hidden_states
+            )
+        else:
+            output = self.logits_processor(
+                hidden_states,
+                self.model.embed_tokens,
+                logits_metadata,
+                aux_hidden_states=aux_hidden_states,
+            )
+
+        return output, {"token_to_kv_pool": layers_kv_fused}, layers_callback_flag, layers_topk_ids
+
+
+EntryClass = GptOssForCausalLM
