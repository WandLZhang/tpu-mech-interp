+class KimiK3Config(KimiLinearConfig):
+    """`moonshotai/Kimi-K3`: a language tower plus a vision tower.
+
+    The published `config.json` nests every language-model field under
+    `text_config` and keeps `architectures`, `model_type` and the token ids at
+    the top. `AutoConfig` hands the outer object to the model class, so a config
+    that only wrapped the inner one would answer `hidden_size` and
+    `is_kda_layer` for nothing.
+
+    This copies the text fields onto itself and inherits the Kimi-Linear
+    accessors, so `hidden_size`, `linear_attn_config`, `is_kda_layer` and
+    `linear_layer_ids` all read the language model. Top-level keys win the
+    merge, which keeps `architectures` at `KimiK3ForConditionalGeneration`
+    rather than the `KimiLinearForCausalLM` the text tower carries.
+
+    `text_config` is this same object. The model reads it, `ModelConfig` reads
+    it as `hf_text_config`, and the state pools read it through
+    `get_kimi_linear_config`. So an override such as
+    `--json-model-override-args '{"num_hidden_layers": 4}'` reaches all three,
+    and so does one nested under `text_config`.
+    """
+
+    model_type = "kimi_k3"
+
+    def __init__(
+        self,
+        text_config: dict | PretrainedConfig | None = None,
+        vision_config: dict | None = None,
+        **kwargs,
+    ):
+        text = text_config if text_config is not None else {}
+        if isinstance(text, PretrainedConfig):
+            text = text.to_dict()
+        text = dict(text)
+        merged = {**text, **kwargs}
+        merged["model_type"] = "kimi_k3"
+        super().__init__(**merged)
+        self.vision_config = vision_config
+
+    @property
+    def text_config(self) -> KimiK3Config:
+        """This config. It carries every language-model field itself."""
+        return self
+
+
+def text_tower(hf_config: Any) -> Any:
+    """The sub-config that describes the language model.
+
+    Kimi K3's `KimiK3Config` is its own `text_config`. A config object that
+    nests a Kimi-Linear config under `text_config` answers that one.
+    Kimi-Linear-48B is the text config already.
+    """
+    inner = getattr(hf_config, "text_config", None)
+    return hf_config if inner is None else inner
+
+
 def _is_kimi_linear_config(hf_config: Any) -> bool:
+    hf_config = text_tower(hf_config)
+    if isinstance(hf_config, KimiLinearConfig):
+        return True
     if getattr(hf_config, "model_type", None) == "kimi_linear":
         return True
     architectures = getattr(hf_config, "architectures", None) or []
@@ -157,7 +232,7 @@ def _is_kimi_linear_config(hf_config: Any) -> bool:
 
 
