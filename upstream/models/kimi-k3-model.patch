+def attn_res_mix(
+    prefix_sum: jax.Array,
+    block_residual: jax.Array,
+    norm_scale: jax.Array,
+    proj_weight: jax.Array,
+    epsilon: float,
+) -> jax.Array:
+    """Mix the running prefix sum with the stashed block entries.
+
+    Kimi K3 doesn't carry one additive residual stream the length of the stack.
+    Every `attn_res_block_size` layers it stashes the current stream and starts
+    a fresh sum. A layer reads a softmax mixture of that sum and every stash:
+
+        v     = concat([block_residual, prefix_sum], axis=1)    [N, B + 1, H]
+        k     = v / rms(v)                                      no weight yet
+        score = sum_h k[..., h] * norm_scale[h] * proj_weight[h]
+        out   = softmax(score) @ v
+
+    The RMS normalization has no learned scale of its own. `norm_scale` and
+    `proj_weight` only ever appear multiplied together, so the reference folds
+    them into one `[H]` vector before the contraction and this does too. Whether
+    they're folded changes nothing about the answer and saves one pass over `v`.
+
+    The mixture runs in float32 and returns in the input dtype. It's a softmax
+    over as many as nine vectors of 7168 values, and bfloat16 loses the tail of
+    the score distribution.
+
+    Args:
+      prefix_sum: [N, H] the running sum this layer would have read.
+      block_residual: [N, B, H] one snapshot per block boundary passed.
+        `B = 0` is legal and makes this the identity on `prefix_sum`.
+      norm_scale: [H] the res-norm weight.
+      proj_weight: [H] or [H, 1] the res-proj weight.
+      epsilon: RMS epsilon.
+
+    Returns:
+      [N, H] in `prefix_sum.dtype`.
+    """
+    out_dtype = prefix_sum.dtype
+    stack = jnp.concatenate([block_residual, prefix_sum[:, None, :]], axis=1)
+    stack_f32 = stack.astype(jnp.float32)
+
+    variance = jnp.mean(jnp.square(stack_f32), axis=-1, keepdims=True)
+    normed = stack_f32 * jax.lax.rsqrt(variance + epsilon)
+
+    score_weight = norm_scale.astype(jnp.float32) * proj_weight.reshape(-1).astype(jnp.float32)
+    scores = jnp.sum(normed * score_weight, axis=-1)
+    probs = jax.nn.softmax(scores, axis=-1)
+
+    mixed = jnp.einsum("nb,nbh->nh", probs, stack_f32)
+    return mixed.astype(out_dtype)
+
+
+class KimiK3MLP(KimiMLP):
+    """A dense or shared-expert MLP. `situ` gating, no bias.
+
+    `kimi_linear.KimiMLP` builds the same three projections. Only the
+    activation differs.
+    """
+
+    def __init__(
+        self,
+        hidden_size: int,
+        intermediate_size: int,
+        mesh: jax.sharding.Mesh,
+        situ_beta: float,
+        situ_linear_beta: float | None,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        super().__init__(hidden_size, intermediate_size, mesh, dtype)
+        self.situ_beta = situ_beta
+        self.situ_linear_beta = situ_linear_beta
+
+    def __call__(self, hidden_states: jax.Array) -> jax.Array:
+        gate, _ = self.gate_proj(hidden_states)
+        up, _ = self.up_proj(hidden_states)
+        activated = situ_and_mul(gate, up, self.situ_beta, self.situ_linear_beta)
+        output, _ = self.down_proj(activated)
+        return output
+
+
+class KimiK3MLAAttention(DeepseekV3Attention):
+    """MLA with NoPE and a sigmoid output gate.
+
+    `DeepseekV3Attention` already covers the rest: the LoRA query path, the
+    latent KV, the absorbed fold and `skip_rope`. `mla_use_nope` is always true
+    here, so `rotary_emb` stays `None` and the `qk_rope_head_dim` slice carries
+    content without a rotation.
+    """
+
+    def __init__(
+        self,
+        hidden_size: int,
+        *,
+        use_output_gate: bool = True,
+        dtype: jnp.dtype = jnp.bfloat16,
+        **kwargs,
+    ):
+        super().__init__(hidden_size=hidden_size, dtype=dtype, **kwargs)
+        self.use_output_gate = use_output_gate
+        if use_output_gate:
+            self.g_proj = LinearBase(
+                input_size=hidden_size,
+                output_size=self.num_heads * self.v_head_dim,
+                mesh=self.mesh,
+                use_bias=False,
+                params_dtype=dtype,
+                kernel_axes=(None, "tensor"),
+                scope_name="g_proj",
+            )
+
+    def _pre_o_proj(self, attn_output: jax.Array, hidden_states: jax.Array) -> jax.Array:
+        """Gate the attention output before `o_proj`.
+
+        The gate reads the layer input, not the attention output, so it doesn't
+        depend on the attention kernel and the absorbed and non-absorbed paths
+        both reach it with the same `[tokens, heads * v_head_dim]` shape.
+        """
+        if not self.use_output_gate:
+            return attn_output
+        gate, _ = self.g_proj(hidden_states)
+        return attn_output * jax.nn.sigmoid(gate.astype(jnp.float32)).astype(attn_output.dtype)
+
+
+class KimiK3DeltaAttention(nnx.Module):
+    """Kimi Delta Attention with a full-rank output gate.
+
+    The recurrence, the three short convolutions, `A_log`, `dt_bias` and
+    `o_norm` match `kimi_linear.KimiDeltaAttention`. Two things don't. K3 sets
+    `use_full_rank_gate`, so one `g_proj` of `hidden_size x projection_size`
+    replaces the `g_a_proj` / `g_b_proj` pair. And the value heads take their
+    width from `linear_attn_config["head_dim"]`, as the published modeling file
+    sizes them, where `kimi_linear.py` reads the MLA `v_head_dim`.
+    """
+
+    def __init__(
+        self,
+        config: KimiLinearConfig,
+        layer_idx: int,
+        mesh: jax.sharding.Mesh,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        linear_config = config.linear_attn_config
+        self.mesh = mesh
+        self.layer_idx = layer_idx
+        self.hidden_size = config.hidden_size
+        self.conv_size = linear_config["short_conv_kernel_size"]
+        self.head_dim = linear_config["head_dim"]
+        self.num_heads = linear_config["num_heads"]
+        self.projection_size = self.num_heads * self.head_dim
+        self.use_full_rank_gate = linear_config.get("use_full_rank_gate", False)
+        rms_norm_eps = getattr(config, "rms_norm_eps", 1e-6)
+
+        for name in ("q_proj", "k_proj", "v_proj"):
+            setattr(
+                self,
+                name,
+                LinearBase(
+                    self.hidden_size,
+                    self.projection_size,
+                    mesh,
+                    use_bias=False,
+                    params_dtype=dtype,
+                    kernel_axes=(None, "tensor"),
+                    scope_name=name,
+                ),
+            )
+
+        # The short convolutions are stored as [D, K], the layout
+        # `short_convolution` reads. LinearBase is a parameter container here
+        # and is never called, the same way `kimi_linear.py` uses it.
+        for name in ("q_conv1d", "k_conv1d", "v_conv1d"):
+            setattr(
+                self,
+                name,
+                LinearBase(
+                    self.projection_size,
+                    self.conv_size,
+                    mesh,
+                    use_bias=False,
+                    params_dtype=dtype,
+                    kernel_axes=("tensor", None),
+                    scope_name=name,
+                ),
+            )
+
+        # One log decay per head, at `[1, 1, heads, 1]` as `kimi_linear.py` holds
+        # it. The checkpoint pads the heads' values to `head_dim` with zeros, and
+        # `_kda_mappings` keeps the first `num_heads`.
+        self.A_log = nnx.Param(
+            jnp.zeros(
+                (1, 1, self.num_heads, 1),
+                dtype=jnp.float32,
+                out_sharding=P(None, None, "tensor", None),
+            )
+        )
+        self.dt_bias = nnx.Param(
+            jnp.zeros((self.projection_size,), dtype=jnp.float32, out_sharding=P("tensor"))
+        )
+
+        self.f_a_proj = LinearBase(
+            self.hidden_size,
+            self.head_dim,
+            mesh,
+            use_bias=False,
+            params_dtype=dtype,
+            kernel_axes=(None, None),
+            scope_name="f_a_proj",
+        )
+        self.f_b_proj = LinearBase(
+            self.head_dim,
+            self.projection_size,
+            mesh,
+            use_bias=False,
+            params_dtype=dtype,
+            kernel_axes=(None, "tensor"),
+            scope_name="f_b_proj",
+        )
+        self.b_proj = LinearBase(
+            self.hidden_size,
+            self.num_heads,
+            mesh,
+            use_bias=False,
+            params_dtype=dtype,
+            kernel_axes=(None, "tensor"),
+            scope_name="b_proj",
+        )
+
+        if self.use_full_rank_gate:
+            self.g_proj = LinearBase(
+                self.hidden_size,
+                self.projection_size,
+                mesh,
+                use_bias=False,
+                params_dtype=dtype,
+                kernel_axes=(None, "tensor"),
+                scope_name="g_proj",
+            )
+        else:
+            self.g_a_proj = LinearBase(
+                self.hidden_size,
+                self.head_dim,
+                mesh,
+                use_bias=False,
+                params_dtype=dtype,
+                kernel_axes=(None, None),
+                scope_name="g_a_proj",
+            )
+            self.g_b_proj = LinearBase(
+                self.head_dim,
+                self.projection_size,
+                mesh,
+                use_bias=False,
+                params_dtype=dtype,
+                kernel_axes=(None, "tensor"),
+                scope_name="g_b_proj",
+            )
+
+        self.o_norm = GatedRMSNorm(self.head_dim, epsilon=rms_norm_eps)
+        self.o_proj = LinearBase(
+            self.projection_size,
+            self.hidden_size,
+            mesh,
+            use_bias=False,
+            params_dtype=dtype,
+            kernel_axes=("tensor", None),
+            scope_name="o_proj",
+        )
+
+        self.attn = RadixLinearAttention(
+            layer_id=layer_idx,
+            num_q_heads=self.num_heads,
+            num_k_heads=self.num_heads,
+            num_v_heads=self.num_heads,
+            head_q_dim=self.head_dim,
+            head_k_dim=self.head_dim,
+            head_v_dim=self.head_dim,
+            q_conv1d=self.q_conv1d,
+            k_conv1d=self.k_conv1d,
+            v_conv1d=self.v_conv1d,
+            bias=None,
+            activation=jax.nn.silu,
+            A_log=self.A_log,
+            dt_bias=self.dt_bias,
+        )
+        self.attn.kda_gate_lower_bound = linear_config.get("gate_lower_bound")
+
+    def output_gate(self, hidden_states: jax.Array) -> jax.Array:
+        """`[tokens, heads, head_dim]` gate for `o_norm`."""
+        if self.use_full_rank_gate:
+            gate, _ = self.g_proj(hidden_states)
+        else:
+            low_rank, _ = self.g_a_proj(hidden_states)
+            gate, _ = self.g_b_proj(low_rank)
+        return gate.reshape(hidden_states.shape[0], self.num_heads, self.head_dim)
+
+    def __call__(
+        self,
+        positions: jax.Array | None,
+        hidden_states: jax.Array,
+        forward_batch: ForwardBatch,
+        recurrent_state_pool,
+    ) -> tuple[jax.Array, object]:
+        del positions
+
+        q, _ = self.q_proj(hidden_states)
+        k, _ = self.k_proj(hidden_states)
+        v, _ = self.v_proj(hidden_states)
+
+        low_rank, _ = self.f_a_proj(hidden_states)
+        raw_gate, _ = self.f_b_proj(low_rank)
+        raw_gate = raw_gate.reshape(hidden_states.shape[0], self.num_heads, self.head_dim)
+        beta = jax.nn.sigmoid(self.b_proj(hidden_states)[0].astype(jnp.float32))
+
+        # The backend owns the short convolutions, the L2 normalization of q and
+        # k, the log gate and its lower bound, and the chunked recurrence.
+        out, recurrent_state_pool = self.attn(
+            forward_batch, q, k, v, raw_gate, beta, recurrent_state_pool
+        )
+        out = out.reshape(hidden_states.shape[0], self.num_heads, self.head_dim)
+
+        out = self.o_norm(out, self.output_gate(hidden_states))
+        out = out.reshape(hidden_states.shape[0], self.projection_size)
+        out, _ = self.o_proj(out)
+        return out, recurrent_state_pool
+
+
+class KimiK3LatentMoE(nnx.Module):
+    """Routed experts in a narrower latent, plus shared experts at full width.
+
+    The router scores the full `hidden_size` stream. `routed_expert_down_proj`
+    then takes the stream to `routed_expert_hidden_size`, the experts run there,
+    `routed_expert_norm` normalizes the combined result and
+    `routed_expert_up_proj` returns it. The shared experts never enter the
+    latent.
+
+    Halving the expert width is what keeps 896 experts affordable. At
+    `hidden_size = 7168` one expert matrix would be 22 M parameters; at the
+    3584 latent it's 11 M, and there are 2,688 of them per layer.
+    """
+
+    def __init__(
+        self,
+        config: KimiLinearConfig,
+        layer_idx: int,
+        mesh: jax.sharding.Mesh,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.hidden_size = config.hidden_size
+        self.latent_size = config.routed_expert_hidden_size or config.hidden_size
+        self.use_latent = config.routed_expert_hidden_size is not None
+        self.use_norm = config.latent_moe_use_norm
+        situ_beta = config.activation_situ_beta or 1.0
+        situ_linear_beta = config.activation_situ_linear_beta
+
+        # The checkpoint ships `e_score_correction_bias` as F32. Top-16 of 896 is
+        # picked on score plus bias, so a BF16 copy moves near-tied experts
+        # across the cut. The bias stays F32, as it does for GLM and DeepSeek.
+        self.gate = GateLogit(
+            input_size=config.hidden_size,
+            num_experts=config.num_experts,
+            enable_expert_bias=True,
+            weight_dtype=dtype,
+            bias_dtype=jnp.float32,
+            score_func=config.moe_router_activation_func,
+        )
+        self.topk = TopK(
+            topk=config.num_experts_per_token,
+            renormalize=config.moe_renormalize,
+            num_expert_group=config.num_expert_group,
+            topk_group=config.topk_group,
+            routed_scaling_factor=config.routed_scaling_factor,
+            layer_id=layer_idx,
+            mesh=mesh,
+        )
+        self.experts = EPMoE(
+            hidden_size=self.latent_size,
+            num_experts=config.num_experts,
+            num_experts_per_tok=config.num_experts_per_token,
+            intermediate_dim=config.moe_intermediate_size,
+            mesh=mesh,
+            weight_dtype=dtype,
+            dtype=dtype,
+            activation="situ" if config.hidden_act == "situ" else config.hidden_act,
+            situ_beta=situ_beta,
+            situ_linear_beta=situ_linear_beta,
+            layer_id=layer_idx,
+            ep_size=config.ep_size,
+            moe_dp_size=getattr(config, "moe_dp_size", 1),
+            quantization_config=moe_quantization_config(config),
+            mxfp4_resident=mxfp4_resident_experts(config),
+        )
+
+        if self.use_latent:
+            self.routed_expert_down_proj = LinearBase(
+                config.hidden_size,
+                self.latent_size,
+                mesh,
+                use_bias=False,
+                params_dtype=dtype,
+                # Row parallel. The stream arrives replicated on the tensor
+                # axis and the latent has to leave replicated, because `EPMoE`
+                # contracts the whole latent. Replicating the kernel instead
+                # would put 49.0 MiB of this matrix on every chip in each of
+                # the 92 MoE layers.
+                kernel_axes=("tensor", None),
+                scope_name="routed_expert_down_proj",
+            )
+            self.routed_expert_up_proj = LinearBase(
+                self.latent_size,
+                config.hidden_size,
+                mesh,
+                use_bias=False,
+                params_dtype=dtype,
+                kernel_axes=("tensor", None),
+                scope_name="routed_expert_up_proj",
+            )
+            self.routed_expert_norm = (
+                RMSNorm(
+                    self.latent_size,
+                    epsilon=config.rms_norm_eps,
+                    param_dtype=dtype,
+                    scope_name="routed_expert_norm",
+                )
+                if self.use_norm
+                else None
+            )
+        else:
+            self.routed_expert_down_proj = None
+            self.routed_expert_up_proj = None
+            self.routed_expert_norm = None
+
+        if config.num_shared_experts:
+            self.shared_experts = KimiK3MLP(
+                hidden_size=config.hidden_size,
+                intermediate_size=config.moe_intermediate_size * config.num_shared_experts,
+                mesh=mesh,
+                situ_beta=situ_beta,
+                situ_linear_beta=situ_linear_beta,
+                dtype=dtype,
+            )
+        else:
+            self.shared_experts = None
+
+    def __call__(
+        self,
+        hidden_states: jax.Array,
+        dispatch_info: ExpertLocationMetadata | None = None,
+    ) -> tuple[jax.Array, jax.Array]:
+        router_logits = self.gate(hidden_states)
+        correction_bias = self.gate.bias.value if self.gate.bias is not None else None
+        topk_weights, topk_ids = self.topk(
+            router_logits, correction_bias, dispatch_info=dispatch_info
+        )
+
+        routed = hidden_states
+        if self.routed_expert_down_proj is not None:
+            routed, _ = self.routed_expert_down_proj(hidden_states)
+
+        routed = self.experts(routed, topk_weights, topk_ids)
+
+        if self.routed_expert_norm is not None:
+            routed = self.routed_expert_norm(routed)
+        if self.routed_expert_up_proj is not None:
+            routed, _ = self.routed_expert_up_proj(routed)
+
+        if self.shared_experts is not None:
+            routed = routed + self.shared_experts(hidden_states)
+        return routed, topk_ids
+
+
+class KimiK3DecoderLayer(nnx.Module):
+    """One layer, either KDA or MLA, with the block attention residual."""
+
+    def __init__(
+        self,
+        config: KimiLinearConfig,
+        layer_idx: int,
+        mesh: jax.sharding.Mesh,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.layer_idx = layer_idx
+        self.hidden_size = config.hidden_size
+        self.rms_norm_eps = config.rms_norm_eps
+        self.is_kda = config.is_kda_layer(layer_idx)
+        self.attn_res_block_size = config.attn_res_block_size
+        self.starts_block = (
+            self.attn_res_block_size is not None and layer_idx % self.attn_res_block_size == 0
+        )
+
+        if self.is_kda:
+            self.self_attn = KimiK3DeltaAttention(
+                config=config, layer_idx=layer_idx, mesh=mesh, dtype=dtype
+            )
+        else:
+            self.self_attn = KimiK3MLAAttention(
+                hidden_size=config.hidden_size,
+                num_heads=config.num_attention_heads,
+                q_lora_rank=config.q_lora_rank,
+                kv_lora_rank=config.kv_lora_rank,
+                qk_nope_head_dim=config.qk_nope_head_dim,
+                qk_rope_head_dim=config.qk_rope_head_dim,
+                v_head_dim=config.v_head_dim,
+                mesh=mesh,
+                layer_id=layer_idx,
+                dtype=dtype,
+                use_absorbed=getattr(config, "use_absorbed_mla", True),
+                skip_rope=config.mla_use_nope,
+                use_output_gate=config.mla_use_output_gate,
+            )
+
+        self.is_moe_layer = (
+            config.is_moe
+            and layer_idx >= config.first_k_dense_replace
+            and layer_idx % config.moe_layer_freq == 0
+        )
+        if self.is_moe_layer:
+            self.block_sparse_moe = KimiK3LatentMoE(
+                config=config, layer_idx=layer_idx, mesh=mesh, dtype=dtype
+            )
+            self.mlp = None
+        else:
+            self.block_sparse_moe = None
+            self.mlp = KimiK3MLP(
+                hidden_size=config.hidden_size,
+                intermediate_size=config.intermediate_size,
+                mesh=mesh,
+                situ_beta=config.activation_situ_beta or 1.0,
+                situ_linear_beta=config.activation_situ_linear_beta,
+                dtype=dtype,
+            )
+
+        self.input_layernorm = RMSNorm(
+            config.hidden_size,
+            epsilon=config.rms_norm_eps,
+            param_dtype=dtype,
+            scope_name="input_layernorm",
+        )
+        self.post_attention_layernorm = RMSNorm(
+            config.hidden_size,
+            epsilon=config.rms_norm_eps,
+            param_dtype=dtype,
+            scope_name="post_attention_layernorm",
+        )
+
+        if self.attn_res_block_size is not None:
+            self.self_attention_res_norm = RMSNorm(
+                config.hidden_size,
+                epsilon=config.rms_norm_eps,
+                param_dtype=dtype,
+                scope_name="self_attention_res_norm",
+            )
+            self.mlp_res_norm = RMSNorm(
+                config.hidden_size,
+                epsilon=config.rms_norm_eps,
+                param_dtype=dtype,
+                scope_name="mlp_res_norm",
+            )
+            self.self_attention_res_proj = LinearBase(
+                config.hidden_size,
+                1,
+                mesh,
+                use_bias=False,
+                params_dtype=dtype,
+                kernel_axes=(None, None),
+                scope_name="self_attention_res_proj",
+            )
+            self.mlp_res_proj = LinearBase(
+                config.hidden_size,
+                1,
+                mesh,
+                use_bias=False,
+                params_dtype=dtype,
+                kernel_axes=(None, None),
+                scope_name="mlp_res_proj",
+            )
+
+    def __call__(
+        self,
+        positions: jax.Array,
+        hidden_states: jax.Array,
+        forward_batch: ForwardBatch,
+        memory_pools,
+        block_residual: jax.Array,
+        dispatch_info: ExpertLocationMetadata | None = None,
+    ):
+        """Run one layer and return `(prefix_sum, block_residual, state, topk)`.
+
+        `hidden_states` arrives as the running prefix sum. It leaves as the
+        prefix sum this layer produced, which is the sum of what entered and
+        what the two sublayers wrote, unless this layer starts a block. A layer
+        that starts a block pushes the incoming sum onto `block_residual` and
+        restarts the sum from its own attention output.
+        """
+        prefix_sum = hidden_states
+
+        # Before the first block boundary there's nothing stashed, so the
+        # attention branch reads the prefix sum unmixed.
+        if block_residual.shape[1] > 0:
+            hidden_states = attn_res_mix(
+                prefix_sum,
+                block_residual,
+                self.self_attention_res_norm.scale.value,
+                self.self_attention_res_proj.weight.value,
+                self.rms_norm_eps,
+            )
+
+        restart = False
+        if self.starts_block:
+            block_residual = jnp.concatenate(
+                [block_residual, prefix_sum[:, None, :]], axis=1
+            )
+            restart = True
+
+        hidden_states = self.input_layernorm(hidden_states)
+
+        pool = memory_pools.recurrent_state_pool if self.is_kda else memory_pools.token_to_kv_pool
+        attn_out, attn_state = self.self_attn(positions, hidden_states, forward_batch, pool)
+
+        prefix_sum = attn_out if restart else prefix_sum + attn_out
+
+        hidden_states = prefix_sum
+        if self.attn_res_block_size is not None:
+            hidden_states = attn_res_mix(
+                prefix_sum,
+                block_residual,
+                self.mlp_res_norm.scale.value,
+                self.mlp_res_proj.weight.value,
+                self.rms_norm_eps,
+            )
+        hidden_states = self.post_attention_layernorm(hidden_states)
+
+        if self.is_moe_layer:
+            ffn_out, topk_ids = self.block_sparse_moe(hidden_states, dispatch_info=dispatch_info)
+        else:
+            ffn_out, topk_ids = self.mlp(hidden_states), None
+
+        prefix_sum = prefix_sum + ffn_out
+        return prefix_sum, block_residual, attn_state, topk_ids
+
+
+class KimiK3Model(nnx.Module):
+    def __init__(
+        self,
+        config: KimiLinearConfig,
+        mesh: jax.sharding.Mesh,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.config = config
+        self.vocab_size = config.vocab_size
+        self.attn_res_block_size = config.attn_res_block_size
+
+        self.embed_tokens = Embed(
+            num_embeddings=config.vocab_size,
+            features=config.hidden_size,
+            dtype=dtype,
+            param_dtype=dtype,
+            kernel_axes=("tensor", None),
+            mesh=mesh,
+        )
+        self.layers = nnx.data(
+            [
+                KimiK3DecoderLayer(config=config, layer_idx=i, mesh=mesh, dtype=dtype)
+                for i in range(config.num_hidden_layers)
+            ]
+        )
+        self.norm = RMSNorm(
+            config.hidden_size,
+            epsilon=config.rms_norm_eps,
+            dtype=dtype,
+            param_dtype=dtype,
+            scope_name="norm",
+        )
+        if self.attn_res_block_size is not None:
+            self.output_attn_res_norm = RMSNorm(
+                config.hidden_size,
+                epsilon=config.rms_norm_eps,
+                param_dtype=dtype,
+                scope_name="output_attn_res_norm",
+            )
+            self.output_attn_res_proj = LinearBase(
+                config.hidden_size,
+                1,
+                mesh,
+                use_bias=False,
+                params_dtype=dtype,
+                kernel_axes=(None, None),
+                scope_name="output_attn_res_proj",
+            )
+
+    def __call__(self, forward_batch: ForwardBatch, memory_pools):
+        hidden_states = (
+            self.embed_tokens(forward_batch.input_ids)
+            if forward_batch.input_embedding is None
+            else forward_batch.input_embedding
+        )
+
+        # [tokens, 0, hidden]. Each block boundary appends one slice, so the
+        # width is known at trace time and the concatenations unroll. It's cut
+        # from the stream so it carries the stream's sharding. A bare jnp.zeros
+        # is replicated, and under the engine's Explicit mesh layer 0's
+        # concatenate refuses it beside the data-sharded embedding.
+        block_residual = hidden_states[:, None, :][:, :0, :]
+
+        layers_kv_fused = []
+        layers_recurrent_buffers = []
+        layers_conv_buffers = []
+        layers_topk_ids = []
+
+        for layer in self.layers:
+            hidden_states, block_residual, attn_state, topk_ids = layer(
+                forward_batch.positions,
+                hidden_states,
+                forward_batch,
+                memory_pools,
+                block_residual,
+                dispatch_info=forward_batch.expert_location_metadata,
+            )
+            if layer.is_kda:
+                recurrent_buffer, conv_buffers = attn_state
+                layers_recurrent_buffers.append(recurrent_buffer)
+                layers_conv_buffers.append(conv_buffers)
+            else:
+                layers_kv_fused.append(attn_state)
+            layers_topk_ids.append(topk_ids)
+
+        if self.attn_res_block_size is not None:
+            hidden_states = attn_res_mix(
+                hidden_states,
+                block_residual,
+                self.output_attn_res_norm.scale.value,
+                self.output_attn_res_proj.weight.value,
+                self.config.rms_norm_eps,
+            )
+        hidden_states = self.norm(hidden_states)
+
+        return (
+            hidden_states,
+            layers_kv_fused,
+            (layers_recurrent_buffers, layers_conv_buffers),
+            layers_topk_ids,
+        )
+
+
+class KimiK3ForCausalLM(nnx.Module):
+    @classmethod
+    def patch_model_config(cls, config: ModelConfig) -> None:
+        config.attention_arch = AttentionArch.MLA
+        text_config = getattr(config, "hf_text_config", config)
+        qk_nope = getattr(text_config, "qk_nope_head_dim", 0)
+        qk_rope = getattr(text_config, "qk_rope_head_dim", 0)
+        if qk_nope and qk_rope:
+            config.head_dim = qk_nope + qk_rope
+
+    def __init__(
+        self,
+        config: KimiLinearConfig,
+        mesh: jax.sharding.Mesh,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        # Keep the object the loader hands over. `KimiK3Config` subclasses
+        # `KimiLinearConfig`, answers every field below and is its own
+        # `text_config`, and `ModelRunner.load_model` writes `ep_size`,
+        # `moe_dp_size`, `use_absorbed_mla` and the rest onto that same object
+        # just before the loader builds the model.
+        if not isinstance(config, KimiLinearConfig):
+            # A bare text tower or a remote config object still needs the
+            # conversion. Carry the runtime attributes across it.
+            resolved = get_kimi_linear_config(config)
+            if resolved is not None:
+                for name, value in vars(config).items():
+                    if name not in vars(resolved):
+                        setattr(resolved, name, value)
+                config = resolved
+        quantization = moe_quantization_config(config)
+        if quantization is not None and quantization.is_static_checkpoint:
+            # The loader would swap every LinearBase for a static QuantizedLinear
+            # before load_weights runs, and the mappings here name BF16 `.weight`
+            # tensors and MXFP4 experts. ModelConfig marks any
+            # --quantization-config-path static when the checkpoint's own
+            # quantization_config is compressed-tensors, which the published one
+            # is, so refuse here rather than load a half-empty model.
+            raise NotImplementedError(
+                "Kimi K3 loads BF16 weights and MXFP4 routed experts; it has no path "
+                "for a statically quantized checkpoint. A --quantization-config-path "
+                "on this checkpoint is static because its quantization_config is "
+                "compressed-tensors, so launch without one."
+            )
+        self.config = config
+        self.mesh = mesh
+        self.dtype = dtype
+        self.model = KimiK3Model(config=config, mesh=mesh, dtype=dtype)
+
+        if not getattr(config, "tie_word_embeddings", False):
+            self.lm_head = ParallelLMHead(
+                config.vocab_size,
+                config.hidden_size,
+                dtype=dtype,
+                param_dtype=dtype,
+                mesh=mesh,
+                enable_dp_lm_head=getattr(config, "enable_dp_lm_head", False),
+            )
+        self.logits_processor = LogitsProcessor(
+            config.vocab_size,
+            mesh=mesh,
+            enable_dp_lm_head=getattr(config, "enable_dp_lm_head", False),
+        )
+
+    def __call__(
+        self,
+        forward_batch: ForwardBatch,
+        memory_pools,
+        logits_metadata: LogitsMetadata,
+    ):
+        (
+            hidden_states,
+            layers_kv_fused,
+            layers_recurrent_state,
+            layers_topk_ids,
+        ) = self.model(forward_batch, memory_pools)
+
+        head = (
+            self.model.embed_tokens
+            if getattr(self.config, "tie_word_embeddings", False)
+            else self.lm_head
+        )
+        output = self.logits_processor(hidden_states, head, logits_metadata)
+        return (
+            output,
+            {
+                "token_to_kv_pool": layers_kv_fused,
+                "recurrent_state_pool": layers_recurrent_state,
+            },
+            True,
+            layers_topk_ids,
+        )
+
+    # ------------------------------------------------------------------
+    # weights
+    # ------------------------------------------------------------------
+
+    def load_weights(self, model_config: ModelConfig):
+        loader = WeightLoader(
+            model=self,
+            model_config=model_config,
+            mesh=self.mesh,
+            dtype=self.dtype,
+            externally_loaded=self.is_accounted_key,
+        )
+        if loader.dummy_mode:
+            # A dummy load reads no checkpoint. The loader's dummy pass fills
+            # every parameter it has no mapping for, and it drops the "expert"
+            # axis to do it, so the routed experts would land whole on every
+            # chip. Fill them first, on the mesh EPMoE shards them over.
+            self._fill_dummy_routed_experts(loader)
+        loader.load_weights_from_safetensors(
+            self._create_weight_mappings(), validate_checkpoint_coverage=True
+        )
+        if not loader.dummy_mode:
+            self._load_routed_experts(loader)
+        for layer in self.model.layers:
+            if not layer.is_kda:
+                layer.self_attn.post_load_weights()
+        logger.info("Kimi K3 weights loaded successfully!")
+
+    def _create_weight_mappings(self) -> dict:
+        prefix = f"{TEXT_PREFIX}.model"
+        mappings = {
+            f"{prefix}.embed_tokens.weight": WeightMapping(
+                target_path="model.embed_tokens.embedding",
+                sharding=("tensor", None),
+                transpose=False,
+            ),
+            f"{prefix}.norm.weight": WeightMapping(
+                target_path="model.norm.scale", sharding=(None,), transpose=False
+            ),
+        }
+        if self.config.attn_res_block_size is not None:
+            mappings[f"{prefix}.output_attn_res_norm.weight"] = WeightMapping(
+                target_path="model.output_attn_res_norm.scale",
+                sharding=(None,),
+                transpose=False,
+            )
+            mappings[f"{prefix}.output_attn_res_proj.weight"] = WeightMapping(
+                target_path="model.output_attn_res_proj.weight",
+                sharding=(None, None),
+                transpose=True,
+            )
+        if not getattr(self.config, "tie_word_embeddings", False):
+            # The head's own mapping carries the sharding ParallelLMHead
+            # declares, which splits the vocabulary over data and tensor unless
+            # --enable-dp-lm-head is set, and the vocab padding it adds.
+            mappings[f"{TEXT_PREFIX}.lm_head.weight"] = self.lm_head.weight_mapping(
+                "lm_head.embedding"
+            )
+
+        for layer_idx in range(self.config.num_hidden_layers):
+            mappings.update(self._create_layer_mappings(layer_idx))
+        return mappings
+
+    def _create_layer_mappings(self, layer_idx: int) -> dict:
+        source = f"{TEXT_PREFIX}.model.layers.{layer_idx}"
+        target = f"model.layers.{layer_idx}"
+        is_dense = layer_idx < self.config.first_k_dense_replace
+        is_kda = self.config.is_kda_layer(layer_idx)
+
+        mappings = {
+            f"{source}.input_layernorm.weight": WeightMapping(
+                target_path=f"{target}.input_layernorm.scale", sharding=(None,), transpose=False
+            ),
+            f"{source}.post_attention_layernorm.weight": WeightMapping(
+                target_path=f"{target}.post_attention_layernorm.scale",
+                sharding=(None,),
+                transpose=False,
+            ),
+        }
+
+        if self.config.attn_res_block_size is not None:
+            for name in ("self_attention_res", "mlp_res"):
+                mappings[f"{source}.{name}_norm.weight"] = WeightMapping(
+                    target_path=f"{target}.{name}_norm.scale", sharding=(None,), transpose=False
+                )
+                mappings[f"{source}.{name}_proj.weight"] = WeightMapping(
+                    target_path=f"{target}.{name}_proj.weight",
+                    sharding=(None, None),
+                    transpose=True,
+                )
+
+        if is_kda:
+            mappings.update(self._kda_mappings(source, target))
+        else:
+            mappings.update(self._mla_mappings(source, target))
+
+        if is_dense:
+            for name, sharding in (
+                ("gate_proj", (None, "tensor")),
+                ("up_proj", (None, "tensor")),
+                ("down_proj", ("tensor", None)),
+            ):
+                mappings[f"{source}.mlp.{name}.weight"] = WeightMapping(
+                    target_path=f"{target}.mlp.{name}.weight", sharding=sharding, transpose=True
+                )
+            return mappings
+
+        mappings.update(self._moe_mappings(source, target))
+        return mappings
+
+    def _kda_mappings(self, source: str, target: str) -> dict:
+        attn = f"{target}.self_attn"
+        mappings = {}
+        column_parallel = ["q_proj", "k_proj", "v_proj", "f_b_proj", "b_proj"]
+        column_parallel.append("g_proj" if self._full_rank_gate else "g_b_proj")
+        for name in column_parallel:
+            mappings[f"{source}.self_attn.{name}.weight"] = WeightMapping(
+                target_path=f"{attn}.{name}.weight", sharding=(None, "tensor"), transpose=True
+            )
+        replicated = ["f_a_proj"] if self._full_rank_gate else ["f_a_proj", "g_a_proj"]
+        for name in replicated:
+            mappings[f"{source}.self_attn.{name}.weight"] = WeightMapping(
+                target_path=f"{attn}.{name}.weight", sharding=(None, None), transpose=True
+            )
+        mappings[f"{source}.self_attn.o_proj.weight"] = WeightMapping(
+            target_path=f"{attn}.o_proj.weight", sharding=("tensor", None), transpose=True
+        )
+
+        # HF ships the short convolutions as [D, 1, K]. `short_convolution`
+        # reads [D, K], and the middle axis is always 1, so a reshape is the
+        # whole conversion.
+        linear_config = self.config.linear_attn_config
+        projection_size = linear_config["num_heads"] * linear_config["head_dim"]
+        conv_size = linear_config["short_conv_kernel_size"]
+        for name in ("q_conv1d", "k_conv1d", "v_conv1d"):
+            mappings[f"{source}.self_attn.{name}.weight"] = WeightMapping(
+                target_path=f"{attn}.attn.{name}.weight",
+                sharding=("tensor", None),
+                transpose=False,
+                reshape=(projection_size, conv_size),
+            )
+        mappings[f"{source}.self_attn.o_norm.weight"] = WeightMapping(
+            target_path=f"{attn}.o_norm.weight", sharding=(None,), transpose=False
+        )
+        mappings[f"{source}.self_attn.dt_bias"] = WeightMapping(
+            target_path=f"{attn}.attn.dt_bias", sharding=("tensor",), transpose=False
+        )
+        # The checkpoint ships A_log as a float32 [head_dim]: one log decay per
+        # head, 96 values, then zeros up to 128. The reference modeling file,
+        # FLA's KDA kernels, vLLM and SGLang all read the first num_heads, and
+        # so does this.
+        heads = linear_config["num_heads"]
+        mappings[f"{source}.self_attn.A_log"] = WeightMapping(
+            target_path=f"{attn}.A_log",
+            sharding=(None, None, "tensor", None),
+            transpose=False,
+            narrow=(0, heads),
+            reshape=(1, 1, heads, 1),
+        )
+        return mappings
+
+    def _mla_mappings(self, source: str, target: str) -> dict:
+        attn = f"{target}.self_attn"
+        mappings = {
+            f"{source}.self_attn.q_a_proj.weight": WeightMapping(
+                target_path=f"{attn}.q_a_proj.weight", sharding=(None, None), transpose=True
+            ),
+            f"{source}.self_attn.q_a_layernorm.weight": WeightMapping(
+                target_path=f"{attn}.q_a_layernorm.scale", sharding=(None,), transpose=False
+            ),
+            f"{source}.self_attn.q_b_proj.weight": WeightMapping(
+                target_path=f"{attn}.q_b_proj.weight", sharding=(None, "tensor"), transpose=True
+            ),
+            f"{source}.self_attn.kv_a_proj_with_mqa.weight": WeightMapping(
+                target_path=f"{attn}.kv_a_proj.weight", sharding=(None, None), transpose=True
+            ),
+            f"{source}.self_attn.kv_a_layernorm.weight": WeightMapping(
+                target_path=f"{attn}.kv_a_layernorm.scale", sharding=(None,), transpose=False
+            ),
+            f"{source}.self_attn.kv_b_proj.weight": WeightMapping(
+                target_path=f"{attn}.kv_b_proj.weight", sharding=(None, "tensor"), transpose=True
+            ),
+            f"{source}.self_attn.o_proj.weight": WeightMapping(
+                target_path=f"{attn}.o_proj.weight", sharding=("tensor", None), transpose=True
+            ),
+        }
+        if self.config.mla_use_output_gate:
+            mappings[f"{source}.self_attn.g_proj.weight"] = WeightMapping(
+                target_path=f"{attn}.g_proj.weight", sharding=(None, "tensor"), transpose=True
+            )
+        return mappings
+
+    def _moe_mappings(self, source: str, target: str) -> dict:
+        moe = f"{target}.block_sparse_moe"
+        mappings = {
+            f"{source}.block_sparse_moe.gate.weight": WeightMapping(
+                target_path=f"{moe}.gate.kernel", sharding=(None, None), transpose=True
+            ),
+            f"{source}.block_sparse_moe.gate.e_score_correction_bias": WeightMapping(
+                target_path=f"{moe}.gate.bias", sharding=(None,)
+            ),
+        }
+        if self.config.routed_expert_hidden_size is not None:
+            for name in ("routed_expert_down_proj", "routed_expert_up_proj"):
+                mappings[f"{source}.block_sparse_moe.{name}.weight"] = WeightMapping(
+                    target_path=f"{moe}.{name}.weight",
+                    sharding=("tensor", None),
+                    transpose=True,
+                )
+            if self.config.latent_moe_use_norm:
+                mappings[f"{source}.block_sparse_moe.routed_expert_norm.weight"] = WeightMapping(
+                    target_path=f"{moe}.routed_expert_norm.scale",
+                    sharding=(None,),
+                    transpose=False,
+                )
+        if self.config.num_shared_experts:
+            for name, sharding in (
+                ("gate_proj", (None, "tensor")),
+                ("up_proj", (None, "tensor")),
+                ("down_proj", ("tensor", None)),
+            ):
+                mappings[f"{source}.block_sparse_moe.shared_experts.{name}.weight"] = WeightMapping(
+                    target_path=f"{moe}.shared_experts.{name}.weight",
+                    sharding=sharding,
+                    transpose=True,
+                )
+        return mappings
+
+    @property
+    def _full_rank_gate(self) -> bool:
+        return self.config.linear_attn_config.get("use_full_rank_gate", False)
+
+    def is_accounted_key(self, hf_key: str) -> bool:
+        """Whether a checkpoint key outside `_create_weight_mappings` is handled.
+
+        Three groups qualify. The MXFP4 routed experts, which
+        `_load_routed_experts` reads itself. The vision tower, which this class
+        serves nothing for. And every decoder layer at or past
+        `num_hidden_layers`, which `--model-layer-nums` cuts: `WeightLoader`
+        skips those only under a bare `model.layers.` prefix, and every key here
+        sits under `language_model.`. `WeightLoader` counts all three as
+        handled, so coverage validation still catches a key in a served layer
+        that nobody reads.
+        """
+        if is_externally_loaded_key(hf_key):
+            return True
+        layer = text_layer_index(hf_key)
+        return layer is not None and layer >= self.config.num_hidden_layers
+
+    def _load_routed_experts(self, loader: WeightLoader) -> None:
+        """Read the MXFP4 expert stacks and write them in the serving dtype.
+
+        `create_moe_weights_mapping` can't carry these: it addresses one tensor
+        per expert and MXFP4 stores two, and `WeightLoader` has no dequantizer
+        for the format. So this walks the same keys itself and builds the
+        `[experts, in, out]` array `EPMoE` holds.
+
+        `jax.make_array_from_callback` asks for one device shard at a time, so
+        the host reads and dequantizes only the experts that shard owns. A whole
+        BF16 layer is 55 GiB across the three matrices and never exists on one
+        host.
+
+        With expert-location metadata the first axis counts physical experts,
+        and `EPMoE` sizes the parameter that way. The checkpoint keys are
+        logical, so the physical-to-logical map decides which expert each slot
+        reads. `create_moe_weights_mapping` does the same for models whose
+        experts load through `WeightLoader`.
+        """
+        weight_info = loader.checkpoint_index()
+        metadata = get_global_expert_location_metadata()
+        physical_to_logical = (
+            np.asarray(jax.device_get(metadata.physical_to_logical_map))
+            if metadata is not None
+            else None
+        )
+        with SequentialSafetensorManager() as files:
+            for layer_idx, layer in enumerate(self.model.layers):
+                if not layer.is_moe_layer:
+                    continue
+                experts = layer.block_sparse_moe.experts
+                source = f"{TEXT_PREFIX}.model.layers.{layer_idx}.block_sparse_moe.experts"
+                layer_map = (
+                    physical_to_logical[layer_idx] if physical_to_logical is not None else None
+                )
+                if experts.mxfp4_resident:
+                    self._load_resident_experts(weight_info, files, experts, source, layer_map)
+                    logger.debug("layer %d routed experts kept MXFP4 on device", layer_idx)
+                    continue
+                for hf_name, param_name in EXPERT_MATRICES:
+                    target = getattr(experts, param_name).value
+                    setattr(
+                        experts,
+                        param_name,
+                        nnx.Param(
+                            self._stack_mxfp4_experts(
+                                weight_info,
+                                files,
+                                source,
+                                hf_name,
+                                target,
+                                expert_sharding(experts, target),
+                                layer_map,
+                            )
+                        ),
+                    )
+                logger.debug("layer %d routed experts dequantized from MXFP4", layer_idx)
+
+    def _load_resident_experts(
+        self,
+        weight_info: dict,
+        files: SequentialSafetensorManager,
+        experts: EPMoE,
+        source: str,
+        layer_map: np.ndarray | None,
+    ) -> None:
+        """One layer's packed codes and scales, straight from the file.
+
+        Each of the six arrays is `[experts, in // k, out]` uint8, the file's
+        `[out, in // k]` per expert transposed, with `k` 2 for the codes and 32
+        for the scales. The callback reads one device shard's rectangle and
+        nothing is decoded.
+        """
+        for hf_name, param_name in EXPERT_MATRICES:
+            for suffix, name in (
+                ("weight_packed", param_name),
+                ("weight_scale", f"{param_name}_mxfp4_scale"),
+            ):
+                target = getattr(experts, name).value
+                setattr(
+                    experts,
+                    name,
+                    nnx.Param(
+                        self._stack_raw_experts(
+                            weight_info,
+                            files,
+                            source,
+                            f"{hf_name}.{suffix}",
+                            target,
+                            expert_sharding(experts, target),
+                            layer_map,
+                        )
+                    ),
+                )
+
+    def _stack_raw_experts(
+        self,
+        weight_info: dict,
+        files: SequentialSafetensorManager,
+        source: str,
+        tensor_name: str,
+        target: jax.Array,
+        sharding: NamedSharding,
+        physical_to_logical: np.ndarray | None = None,
+    ) -> jax.Array:
+        """One uint8 `[experts, rows, cols]` array, the file's `[cols, rows]` per expert.
+
+        The callback cuts the rectangle off the file for each expert its device
+        shard owns, so a host holds one device shard of one layer at most.
+        """
+
+        def read(index):
+            expert_slice, row_slice, col_slice = index
+            shards = []
+            for slot in range(*expert_slice.indices(target.shape[0])):
+                expert_id = slot if physical_to_logical is None else int(physical_to_logical[slot])
+                key = f"{source}.{expert_id}.{tensor_name}"
+                handle = files.get_handle(weight_info[key][0]["file"])
+                shards.append(np.asarray(handle.get_slice(key)[col_slice, row_slice]).T)
+            return np.ascontiguousarray(np.stack(shards).astype(np.uint8))
+
+        return jax.make_array_from_callback(target.shape, sharding, read)
+
+    def _fill_dummy_routed_experts(self, loader: WeightLoader) -> None:
+        """Zero expert stacks for a dummy load, sharded the way EPMoE shards them."""
+        for layer in self.model.layers:
+            if not layer.is_moe_layer:
+                continue
+            experts = layer.block_sparse_moe.experts
+            names = [param_name for _, param_name in EXPERT_MATRICES]
+            if experts.mxfp4_resident:
+                names += [f"{name}_mxfp4_scale" for name in list(names)]
+            for param_name in names:
+                target = getattr(experts, param_name).value
+                dummy = loader._dummy_array(
+                    target.shape, target.dtype, expert_sharding(experts, target)
+                )
+                setattr(experts, param_name, nnx.Param(dummy))
+
+    def _stack_mxfp4_experts(
+        self,
+        weight_info: dict,
+        files: SequentialSafetensorManager,
+        source: str,
+        hf_name: str,
+        target: jax.Array,
+        sharding: NamedSharding,
+        physical_to_logical: np.ndarray | None = None,
+    ) -> jax.Array:
+        """One `[experts, in, out]` array in `target.dtype`, read shard by shard.
+
+        The checkpoint holds `[out, in]` per expert, which is what a torch
+        `nn.Linear` stores. `EPMoE` wants `[in, out]`, so each expert is
+        transposed after dequantization. `sharding` has to name devices, which
+        `expert_sharding` gives it.
+        """
+
+        def read(index):
+            expert_slice, row_slice, col_slice = index
+            shards = []
+            for slot in range(*expert_slice.indices(target.shape[0])):
+                expert_id = slot if physical_to_logical is None else int(physical_to_logical[slot])
+                key = f"{source}.{expert_id}.{hf_name}"
+                packed_key, scale_key = f"{key}.weight_packed", f"{key}.weight_scale"
+                handle = files.get_handle(weight_info[packed_key][0]["file"])
+                shards.append(
+                    read_mxfp4_block(
+                        handle,
+                        packed_key,
+                        scale_key,
+                        out_slice=col_slice,
+                        in_slice=row_slice,
+                        in_size=target.shape[1],
+                        group_size=MXFP4_GROUP_SIZE,
+                    )
+                )
+            return np.stack(shards).astype(target.dtype)
+
+        return jax.make_array_from_callback(target.shape, sharding, read)
+
+
+def expert_sharding(experts: EPMoE, target) -> NamedSharding:
+    """Where one EPMoE expert stack lives, with real devices behind it.
+
+    EPMoE builds `wi_0`, `wi_1` and `wo` under `use_abstract_mesh`, so once the
+    loader's `nnx.eval_shape` has built the model each one carries a
+    NamedSharding over an AbstractMesh, which names no devices.
+    `jax.make_array_from_callback` needs devices. `EPMoE.moe_mesh` is the
+    concrete mesh with the same axis names, so the spec moves onto it.
+    """
+    spec = getattr(jax.typeof(target).sharding, "spec", None)
+    return NamedSharding(experts.moe_mesh, P() if spec is None else spec)
+
+
+def is_mxfp4_checkpoint(config) -> bool:
+    """Whether the checkpoint's own `quantization_config` names MXFP4.
+
+    The published one is a compressed-tensors dict whose `format` is
+    `mxfp4-pack-quantized`.
+    """
+    quantization = getattr(config, "quantization_config", None)
+    if isinstance(quantization, QuantizationConfig) or not quantization:
+        return False
+    if not isinstance(quantization, dict):
+        quantization = getattr(quantization, "to_dict", lambda: {})()
+    return quantization.get("format") == "mxfp4-pack-quantized"
+
+
+def mxfp4_resident_experts(config) -> bool:
+    """Whether the routed experts stay MXFP4 on the device.
+
+    `mxfp4_resident_experts` on the config decides, and
+    `--json-model-override-args '{"mxfp4_resident_experts": false}'` sets it.
+    Unset, the experts stay resident when the checkpoint is MXFP4. A launch
+    quantization config or `--moe-dp-size` above 1 needs BF16 stacks, so
+    either one turns residency off unless the config asked for it, and then
+    `EPMoE` refuses the launch by name.
+    """
+    flag = getattr(config, "mxfp4_resident_experts", None)
+    if flag is not None:
+        return bool(flag)
+    if moe_quantization_config(config) is not None or getattr(config, "moe_dp_size", 1) > 1:
+        return False
+    return is_mxfp4_checkpoint(config)
+
+
+def moe_quantization_config(config) -> QuantizationConfig | None:
+    """The quantization config `EPMoE` takes, or None.
+
+    `ModelConfig` puts a `QuantizationConfig` on the config when the launch
+    passes one. Without one, the config still carries the checkpoint's own
+    `quantization_config`, the compressed-tensors dict that describes the MXFP4
+    experts. `EPMoE` can't read that dict, and `_load_routed_experts` already
+    turns those experts into the serving dtype, so it goes nowhere.
+    """
+    quantization = getattr(config, "quantization_config", None)
+    return quantization if isinstance(quantization, QuantizationConfig) else None
+
+
+def text_layer_index(hf_key: str) -> int | None:
+    """The decoder layer a `language_model.model.layers.N.*` key belongs to."""
+    prefix = f"{TEXT_PREFIX}.model.layers."
+    if not hf_key.startswith(prefix):
+        return None
+    index = hf_key[len(prefix) :].split(".", 1)[0]
+    return int(index) if index.isdigit() else None
+
+
+def read_mxfp4_block(
+    handle,
+    packed_key: str,
+    scale_key: str,
+    *,
+    out_slice: slice,
+    in_slice: slice,
+    in_size: int,
+    group_size: int,
+) -> np.ndarray:
+    """One `[in, out]` block of a `[out, in]` MXFP4 tensor.
+
+    The checkpoint stores the transpose of what `EPMoE` holds, so the block the
+    caller asks for by `[in, out]` is a `[out, in]` rectangle in the file. Both
+    edges come off the file before anything is decoded, so the host reads the
+    rectangle rather than the whole matrix.
+
+    The output axis slices freely, because it indexes whole rows.
+    The input axis is the packed axis: two E2M1 codes share a byte and
+    `group_size` codes share a scale. A slice that starts and ends on a group
+    boundary cuts the file cleanly; anything else reads the full row and cuts
+    after decoding.
+
+    Args:
+      handle: an open safetensors file.
+      packed_key: the `weight_packed` key.
+      scale_key: the `weight_scale` key.
+      out_slice: which output columns the caller wants.
+      in_slice: which input rows the caller wants.
+      in_size: the input dimension of the whole tensor.
+      group_size: elements per scale.
+
+    Returns:
+      `[len(in_slice), len(out_slice)]` float32.
+    """
+    start, stop, step = in_slice.indices(in_size)
+    aligned = step == 1 and start % group_size == 0 and stop % group_size == 0
+    packed = handle.get_slice(packed_key)
+    scale = handle.get_slice(scale_key)
+    if aligned:
+        dense = dequantize_mxfp4(
+            packed[out_slice, start // 2 : stop // 2],
+            scale[out_slice, start // group_size : stop // group_size],
+            group_size=group_size,
+        )
+        return dense.T
+    dense = dequantize_mxfp4(packed[out_slice], scale[out_slice], group_size=group_size)
+    return dense.T[in_slice]
+
+
+def is_routed_expert_key(hf_key: str) -> bool:
+    """Whether `_load_routed_experts` owns this checkpoint key."""
+    return ".block_sparse_moe.experts." in hf_key and hf_key.endswith(
+        ("weight_packed", "weight_scale")
+    )
+
+
+def is_vision_key(hf_key: str) -> bool:
+    """Whether this checkpoint key belongs to the vision tower or its projector.
+
+    `moonshotai/Kimi-K3` ships 168 of these in the last two shards. This class
+    serves the language tower, neither entry class joins
+    `InModelMultimodalContract`, and nothing here reads them.
+    """
+    return hf_key.startswith(("vision_tower.", "mm_projector."))
+
+
+def is_externally_loaded_key(hf_key: str) -> bool:
+    """Whether a key outside `_create_weight_mappings` is accounted for.
+
+    Two groups qualify at any layer count: the MXFP4 routed experts, which
+    `_load_routed_experts` reads itself, and the vision tower, which this class
+    serves nothing for. `KimiK3ForCausalLM.is_accounted_key` adds the layers
+    `--model-layer-nums` cuts. Coverage validation still catches a
+    language-model key nobody reads.
+    """
+    return is_routed_expert_key(hf_key) or is_vision_key(hf_key)
+
+
+class KimiK3ForConditionalGeneration(KimiK3ForCausalLM):
+    """The name the published checkpoint asks for.
+
+    `moonshotai/Kimi-K3` lists `KimiK3ForConditionalGeneration` in the top-level
+    `architectures`, and `get_model_architecture` resolves that list against the
+    registry. The language tower is the whole of what this file serves, so the
+    two names run the same code.
+
+    This stays out of `InModelMultimodalContract`, which is what marks a model
+    multimodal. The vision tower and the projector load nowhere, and a text
+    request runs untouched.
+    """
+
+
+EntryClass = [KimiK3ForCausalLM, KimiK3ForConditionalGeneration]
