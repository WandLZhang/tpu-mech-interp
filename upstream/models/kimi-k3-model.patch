 from flax import nnx
 
 from sgl_jax.srt.utils.profiling_utils import named_scope
@@ -18,6 +19,49 @@ ACT2FN = {
 }
 
 
+def situ_and_mul(
+    gate: jax.Array,
+    up: jax.Array,
+    beta: float,
+    linear_beta: float | None = None,
+) -> jax.Array:
+    """Kimi K3's `situ` gated activation.
+
+        situ(g) = beta * tanh(g / beta) * sigmoid(g)
+        out     = situ(gate) * clip(up)
+
+    `beta` bounds the gate branch. `tanh(g / beta)` saturates at 1, so the
+    factor `beta * tanh(g / beta) * sigmoid(g)` never exceeds `beta`. At the
+    published `beta = 4.0` it bottoms out at -0.270. SiLU has no such bound.
+
+    `linear_beta` bounds the linear branch the same way, through
+    `linear_beta * tanh(up / linear_beta)`. `None` leaves `up` alone, which is
+    what a config that sets `activation_situ_beta` and omits
+    `activation_situ_linear_beta` asks for.
+
+    Both branches run in float32 whatever the operands are, and the result
+    comes back in the gate's dtype. The reference activation does the same, and
+    at the published `beta = 4.0` a bfloat16 `tanh(g / beta)` loses three digits
+    right where the curve bends.
+
+    Args:
+      gate: `[..., d]`
+      up: `[..., d]`
+      beta: `activation_situ_beta`.
+      linear_beta: `activation_situ_linear_beta`, or `None`.
+
+    Returns:
+      `[..., d]` in `gate.dtype`.
+    """
+    out_dtype = gate.dtype
+    gate_f32 = gate.astype(jnp.float32)
+    up_f32 = up.astype(jnp.float32)
+    activated = beta * jnp.tanh(gate_f32 / beta) * jax.nn.sigmoid(gate_f32)
+    if linear_beta is not None:
+        up_f32 = linear_beta * jnp.tanh(up_f32 / linear_beta)
+    return (activated * up_f32).astype(out_dtype)
+
+
 class GeluAndMul(nnx.Module):
     def __init__(self, approximate: str = "tanh"):
         self.approximate = approximate
