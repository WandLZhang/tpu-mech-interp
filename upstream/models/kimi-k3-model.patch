@@ -0,0 +1,168 @@
+"""MXFP4 (OCP microscaling FP4) unpacking for compressed-tensors checkpoints.
+
+A `mxfp4-pack-quantized` tensor ships as two arrays:
+
+* `weight_packed`, uint8, two 4-bit E2M1 codes per byte along the last axis.
+  The low nibble holds the even element, the high nibble the odd one.
+* `weight_scale`, uint8, one E8M0 exponent per group of `group_size` elements
+  along the same axis. The scale is `2 ** (code - 127)`.
+
+E2M1 is 1 sign bit, 2 exponent bits and 1 mantissa bit, so the 16 codes cover
+eight magnitudes and their negatives. `E2M1_VALUES` lists them in code order.
+
+`dequantize_mxfp4` runs on the host with numpy. A loader can call it during
+weight load and hand the model BF16, so nothing downstream has to know the
+checkpoint was quantized.
+
+`dequantize_mxfp4_jax` runs on the device. It lets a model keep the packed
+codes and the scales in HBM and decode one layer's experts inside the forward,
+which holds 4.25 bits a weight resident instead of 16. It makes the same float32
+products as `dequantize_mxfp4` and casts them the same way, so the two agree
+bit for bit wherever the device keeps float32 subnormals. Only E8M0 codes 0
+and 1 reach them: code 0's scale is 2 ** -127, and code 1 makes products below
+2 ** -126. A device that flushes subnormals decodes those to zero.
+"""
+
+from __future__ import annotations
+
+import jax.numpy as jnp
+import numpy as np
+
+__all__ = [
+    "E2M1_VALUES",
+    "E8M0_SCALES",
+    "MXFP4_EXPONENT_BIAS",
+    "dequantize_mxfp4",
+    "dequantize_mxfp4_jax",
+    "unpack_nibbles",
+]
+
+# Code order: sign in bit 3, exponent in bits 2-1, mantissa in bit 0.
+E2M1_VALUES = np.array(
+    [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0, -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0],
+    dtype=np.float32,
+)
+
+# E8M0 stores an unbiased exponent. 127 maps to a scale of 1.0.
+MXFP4_EXPONENT_BIAS = 127
+
+# The scale for each of the 256 E8M0 codes, computed the way `dequantize_mxfp4`
+# computes it: numpy's float32 `exp2` of the unbiased exponent. Code 255 is
+# 2 ** 128, which float32 holds as infinity, and that's what `exp2` returns.
+E8M0_SCALES = np.append(
+    np.exp2((np.arange(255, dtype=np.int32) - MXFP4_EXPONENT_BIAS).astype(np.float32)),
+    np.float32(np.inf),
+)
+
+
+def unpack_nibbles(packed: np.ndarray) -> np.ndarray:
+    """Split each uint8 into its two 4-bit codes along the last axis.
+
+    Args:
+      packed: uint8 array of shape `[..., n]`.
+
+    Returns:
+      uint8 array of shape `[..., 2 * n]`. Element `2 * j` is the low nibble of
+      byte `j` and element `2 * j + 1` is the high nibble.
+    """
+    packed = np.asarray(packed, dtype=np.uint8)
+    low = packed & 0x0F
+    high = (packed >> 4) & 0x0F
+    interleaved = np.stack((low, high), axis=-1)
+    return interleaved.reshape(*packed.shape[:-1], 2 * packed.shape[-1])
+
+
+def dequantize_mxfp4(
+    packed: np.ndarray,
+    scale: np.ndarray,
+    group_size: int = 32,
+    dtype: np.dtype = np.float32,
+) -> np.ndarray:
+    """Turn one `weight_packed` / `weight_scale` pair into a dense array.
+
+    Args:
+      packed: uint8 `[..., n]`, two E2M1 codes per byte.
+      scale: uint8 `[..., 2 * n // group_size]`, one E8M0 exponent per group.
+      group_size: elements per scale. `mxfp4-pack-quantized` uses 32.
+      dtype: output dtype.
+
+    Returns:
+      `[..., 2 * n]` in `dtype`.
+
+    Raises:
+      ValueError: if the scale count doesn't match the element count, which
+        means the group size or the packing axis is wrong.
+    """
+    codes = unpack_nibbles(packed)
+    elements = codes.shape[-1]
+    scale = np.asarray(scale, dtype=np.uint8)
+    groups = scale.shape[-1]
+    if groups * group_size != elements:
+        raise ValueError(
+            f"{groups} scales at group_size {group_size} cover {groups * group_size} "
+            f"elements, but the packed array holds {elements}"
+        )
+    if scale.shape[:-1] != codes.shape[:-1]:
+        raise ValueError(f"scale shape {scale.shape} does not match packed shape {codes.shape}")
+
+    values = E2M1_VALUES[codes]
+    exponent = scale.astype(np.int32) - MXFP4_EXPONENT_BIAS
+    factor = np.exp2(exponent.astype(np.float32))
+    grouped = values.reshape(*values.shape[:-1], groups, group_size)
+    scaled = grouped * factor[..., None]
+    return scaled.reshape(values.shape).astype(dtype)
+
+
+def dequantize_mxfp4_jax(
+    packed: jnp.ndarray,
+    scale: jnp.ndarray,
+    *,
+    dtype: jnp.dtype,
+    group_size: int = 32,
+    element_offset: int | jnp.ndarray = 0,
+) -> jnp.ndarray:
+    """Decode MXFP4 on the device, packed along axis 1.
+
+    The layout is the one `EPMoE` holds, `[experts, in, out]`, with the input
+    axis packed. Byte `j` of axis 1 holds element `2 * j` in its low nibble and
+    element `2 * j + 1` in its high nibble, as in `unpack_nibbles`.
+
+    `packed` can be one device's rows of a larger tensor. `element_offset` is
+    the index of its first element in the whole tensor, and `scale` holds every
+    group those rows touch, so a cut that splits a scale group still reads the
+    right exponent.
+
+    Args:
+      packed: uint8 `[e, n // 2, m]`.
+      scale: uint8 `[e, groups, m]`. Element `element_offset + i` reads group
+        `(element_offset + i) // group_size`.
+      dtype: output dtype.
+      group_size: elements per scale.
+      element_offset: where row 0 of `packed` sits in the whole tensor, in
+        elements. It can be traced.
+
+    Returns:
+      `[e, n, m]` in `dtype`.
+    """
+    low = packed & 0x0F
+    high = packed >> 4
+    codes = jnp.stack((low, high), axis=2)
+    codes = codes.reshape(packed.shape[0], 2 * packed.shape[1], *packed.shape[2:])
+    values = jnp.asarray(E2M1_VALUES)[codes]
+    elements = codes.shape[1]
+    if isinstance(element_offset, int) and element_offset % group_size == 0 and (
+        elements % group_size == 0
+    ):
+        # Rows that start and end on a group boundary read one exponent per
+        # group. The factor stays [e, groups, m], 1/32 of the elements, and
+        # broadcasts over each group. A per-element factor would be an f32
+        # array the size of the decoded stack.
+        first = element_offset // group_size
+        count = elements // group_size
+        factor = jnp.asarray(E8M0_SCALES)[scale[:, first : first + count]]
+        grouped = values.reshape(values.shape[0], count, group_size, *values.shape[2:])
+        return (grouped * factor[:, :, None]).reshape(values.shape).astype(dtype)
+    groups = (element_offset + jnp.arange(elements, dtype=jnp.int32)) // group_size
+    exponents = jnp.take(scale, groups, axis=1)
+    factor = jnp.asarray(E8M0_SCALES)[exponents]
+    return (values * factor).astype(dtype)
