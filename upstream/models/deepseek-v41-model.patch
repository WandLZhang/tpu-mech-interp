diff --git a/python/sgl_jax/srt/mem_cache/deepseek_v41_state_pool.py b/python/sgl_jax/srt/mem_cache/deepseek_v41_state_pool.py
new file mode 100644
index 00000000..443e1363
--- /dev/null
+++ b/python/sgl_jax/srt/mem_cache/deepseek_v41_state_pool.py
@@ -0,0 +1,76 @@
+"""Per-request state of DeepSeek V4.1-Flash.
+
+One row per request slot, plus the dummy slot 0 that padding tokens write to. Row `i + 1`
+belongs to the request at `req_pool_indices == i`. What a row holds, per
+`models/deepseek_v41.state_shapes`:
+
+- `window[l]`: the last `window_size` raw latents of layer `l`, as a ring.
+- `ckv[o]`, `ik[o]`: the compressed latents and index keys of KV owner `o`, one row per closed
+  group, `context_len // ratio` rows.
+- `tail_kv[o]`, `tail_score[o]`: the members of a ratio-2 owner's group that hasn't closed.
+- `engram_hist[0]`: the last `engram_max_ngram_size - 1` compressed token ids.
+
+A request reads only rows it wrote itself: the model masks every read by the request's own
+prefix length, so a slot needs no reset between requests. Nothing here is paged and nothing is
+shared between requests, so the model runs with the radix cache off.
+"""
+
+from __future__ import annotations
+
+import jax
+import jax.numpy as jnp
+from jax.sharding import NamedSharding
+from jax.sharding import PartitionSpec as P
+from jax.tree_util import register_pytree_node_class
+
+
+@register_pytree_node_class
+class DeepseekV41StatePool:
+    def __init__(self, state: dict, num_slots: int, mesh=None):
+        self.state = state
+        self.num_slots = num_slots
+        self.mesh = mesh
+
+    @classmethod
+    def create(cls, cfg, max_num_reqs: int, context_len: int, dtype, mesh):
+        from sgl_jax.srt.models.deepseek_v41 import state_shapes
+
+        num_slots = max_num_reqs + 1
+        sharding = NamedSharding(mesh, P()) if mesh is not None else None
+        shapes = state_shapes(cfg, num_slots, context_len, dtype)
+        state = {}
+        with jax.set_mesh(mesh) if mesh is not None else _null():
+            for key, entries in shapes.items():
+                state[key] = [jnp.zeros(shape, dt, device=sharding) for shape, dt in entries]
+        return cls(state, num_slots, mesh)
+
+    def size_bytes(self) -> int:
+        return sum(a.size * a.dtype.itemsize for v in self.state.values() for a in v)
+
+    def replace_buffer(self, new_state) -> None:
+        if set(new_state) != set(self.state):
+            raise ValueError(f"state keys {sorted(new_state)} != {sorted(self.state)}")
+        self.state = {k: list(v) for k, v in new_state.items()}
+
+    def tree_flatten(self):
+        keys = sorted(self.state)
+        lens = tuple(len(self.state[k]) for k in keys)
+        leaves = [a for k in keys for a in self.state[k]]
+        return leaves, (tuple(keys), lens, self.num_slots, self.mesh)
+
+    @classmethod
+    def tree_unflatten(cls, aux, leaves):
+        keys, lens, num_slots, mesh = aux
+        state, i = {}, 0
+        for k, n in zip(keys, lens):
+            state[k] = list(leaves[i : i + n])
+            i += n
+        return cls(state, num_slots, mesh)
+
+
+class _null:
+    def __enter__(self):
+        return None
+
+    def __exit__(self, *exc):
+        return False
