index 00000000..1e0f8db9
--- /dev/null
+++ b/python/sgl_jax/srt/models/deepseek_v41.py
@@ -0,0 +1,1489 @@
+"""DeepSeek V4.1-Flash text backbone (`DeepseekV41ForCausalLM`).
+
+Ported from the reference runtime the checkpoint repo ships, `inference/model.py` and
+`inference/engram.py` at revision dba1be0a40aa45a94ad051997016db3960a90277. Names follow it:
+`Attention`, `Compressor`, `Indexer`, `Engram`, `Gate`, `Block`, `hc_pre`, `hc_post`.
+
+What the model is, in the terms this file uses:
+
+- The residual stream is `hc_mult` (4) parallel copies. Each block collapses them into the
+  attention input with the `pre` mix the previous sublayer made, and into the feed-forward input
+  with the one its own attention made. `hc_post` expands each sublayer's output back to four
+  copies and mixes the residual in through a Sinkhorn-normalized matrix.
+- Every layer attends over a sliding window of 128 raw latents. Layers with a compression ratio
+  `r > 0` also attend over `index_topk` compressed latents. A KV owner (`kv_source_layers`) pools
+  `r` tokens into one latent and writes it, and the index keys, to a cache the layers after it
+  read. An index source (`index_source_layers`) scores the compressed positions and publishes its
+  top-k, which the layers after it reuse. The candidate source keeps the best blocks of
+  compressed positions, and the index sources after it score only inside them.
+- One 512-wide latent serves as key and value for all query heads. Rotation turns the last 64
+  channels and the attention output is rotated back before the output projection.
+- Two layers add an Engram lookup to the stream before the block: n-gram hashes of the token ids
+  pick rows from an FP8 table, and a per-copy gate decides how much of each row goes in.
+
+The reference rounds cached values to FP8 and FP4 and stores them back in the compute dtype. This
+file does the same round trips, so its activations match the reference's.
+
+State. Every cache the model reads lives in `DeepseekV41StatePool`, one row per request slot:
+the window ring of each layer, the compressed latents and index keys of each KV owner, the tail of
+each ratio-2 compressor's open group, and the last `engram_max_ngram_size - 1` compressed token ids
+for the Engram hash. Slot 0 is a dummy that padding tokens write to. The pool isn't paged and holds
+no prefix, so this model runs without prefix caching.
+
+Capture. Slot `k` of `layers_to_capture` holds the collapsed attention input of layer `k`: the
+four copies after any Engram lookup, collapsed with the incoming `pre` mix, before `attn_norm`.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import glob
+import json
+import logging
+import math
+import os
+import struct
+from functools import partial
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+from flax import nnx
+from jax.sharding import NamedSharding
+from jax.sharding import PartitionSpec as P
+
+from sgl_jax.srt.layers import moe as _moe
+from sgl_jax.srt.layers.embeddings import Embed, ParallelLMHead
+from sgl_jax.srt.layers.logits_processor import LogitsMetadata, LogitsProcessor
+from sgl_jax.srt.layers.moe import EPMoE
+
+logger = logging.getLogger(__name__)
+
+FP8_MAX = 448.0
+FP4_MAX = 6.0
+E2M1_VALUES = np.array(
+    [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0, -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0],
+    dtype=np.float32,
+)
+
+
+# --------------------------------------------------------------------------------------------
+# Layer plan
+# --------------------------------------------------------------------------------------------
+
+
+@dataclasses.dataclass(frozen=True)
+class LayerRole:
+    """What one backbone layer reads and writes. All fields are static."""
+
+    layer_id: int
+    ratio: int  # 0: window only; r: compressed r-to-1
+    kv_owner: int  # index into kv_source_layers of the cache this layer reads, -1 if none
+    owns_kv: bool  # this layer runs the compressor and writes the cache
+    index_source: int  # layer id whose top-k this layer uses, -1 if none
+    owns_index: bool  # this layer runs its own indexer
+    is_candidate_source: bool
+    uses_candidates: bool
+    engram_slot: int  # index into engram_layer_ids, -1 if none
+
+
+def layer_roles(cfg) -> list[LayerRole]:
+    """Bind each backbone layer to its KV owner and its index source.
+
+    A consumer binds to the nearest source at or before it, because the reference runtime hands
+    shared state down the stack in layer order. Raises when a consumer and its source differ in
+    ratio, or when an index source has no KV owner to read keys from.
+    """
+    n_layers = int(cfg.n_layers)
+    ratios = [int(r) for r in cfg.compress_ratios[:n_layers]]
+    kv_sources = [int(i) for i in cfg.kv_source_layers]
+    index_sources = [int(i) for i in cfg.index_source_layers]
+    cand = int(getattr(cfg, "candidate_source_layer", -1))
+    engram_ids = [int(i) for i in getattr(cfg, "engram_layer_ids", [])]
+    if len(cfg.compress_ratios) < n_layers:
+        raise ValueError(f"compress_ratios holds {len(cfg.compress_ratios)} entries for {n_layers} layers")
+    for s in kv_sources:
+        if s not in index_sources:
+            raise ValueError(f"kv source {s} isn't an index source")
+    roles = []
+    for layer_id, ratio in enumerate(ratios):
+        owner, isrc = -1, -1
+        if ratio:
+            before = [s for s in kv_sources if s <= layer_id]
+            if not before:
+                raise ValueError(f"layer {layer_id} compresses at ratio {ratio} but no kv source precedes it")
+            owner_layer = before[-1]
+            if ratios[owner_layer] != ratio:
+                raise ValueError(
+                    f"layer {layer_id} at ratio {ratio} binds to kv source {owner_layer} at "
+                    f"ratio {ratios[owner_layer]}"
+                )
+            owner = kv_sources.index(owner_layer)
+            ibefore = [s for s in index_sources if s <= layer_id]
+            isrc = ibefore[-1]
+            if ratios[isrc] != ratio:
+                raise ValueError(f"layer {layer_id} binds to index source {isrc} at another ratio")
+        roles.append(
+            LayerRole(
+                layer_id=layer_id,
+                ratio=ratio,
+                kv_owner=owner,
+                owns_kv=layer_id in kv_sources,
+                index_source=isrc,
+                owns_index=layer_id in index_sources,
+                is_candidate_source=layer_id == cand,
+                uses_candidates=0 <= cand < layer_id and ratio > 0,
+                engram_slot=engram_ids.index(layer_id) if layer_id in engram_ids else -1,
+            )
+        )
+    return roles
+
+
+def owner_ratios(cfg) -> list[int]:
+    return [int(cfg.compress_ratios[s]) for s in cfg.kv_source_layers]
+
+
+# --------------------------------------------------------------------------------------------
+# Numerics shared by every layer
+# --------------------------------------------------------------------------------------------
+
+
+def rms_norm(x, weight, eps):
+    """FP32 statistics, weight applied in FP32, cast back. `RMSNorm.forward` in the reference."""
+    xf = x.astype(jnp.float32)
+    xf = xf * jax.lax.rsqrt(jnp.mean(xf * xf, axis=-1, keepdims=True) + eps)
+    return (weight.astype(jnp.float32) * xf).astype(x.dtype)
+
+
+def _pow2_ceil(v):
+    """2 ** ceil(log2(v)) for positive normal float32 `v`, exactly, the way `fast_round_scale`
+    reads the exponent bits."""
+    mant, exp = jnp.frexp(v)  # v = mant * 2**exp, mant in [0.5, 1)
+    k = jnp.where(mant == 0.5, exp - 1, exp)
+    return jnp.ldexp(jnp.ones_like(v), k)
+
+
+def fp8_roundtrip(x, block=32):
+    """`act_quant(x, block, "ue8m0", e8m0, inplace=True)`: E4M3 with a power-of-2 scale per block."""
+    shape = x.shape
+    xb = x.astype(jnp.float32).reshape(*shape[:-1], shape[-1] // block, block)
+    amax = jnp.maximum(jnp.max(jnp.abs(xb), axis=-1, keepdims=True), 1e-4)
+    s = _pow2_ceil(amax * np.float32(1.0 / FP8_MAX))
+    y = jnp.clip(xb / s, -FP8_MAX, FP8_MAX).astype(jnp.float8_e4m3fn).astype(jnp.float32) * s
+    return y.reshape(shape).astype(x.dtype)
+
+
+def fp4_roundtrip(x, block, e4m3_scale=False):
+    """`fp4_act_quant(x, block, inplace=True)`: E2M1 values with an E8M0 scale per block, or an
+    E4M3 scale when `e4m3_scale`, as the compressed KV uses."""
+    shape = x.shape
+    xb = x.astype(jnp.float32).reshape(*shape[:-1], shape[-1] // block, block)
+    amax = jnp.max(jnp.abs(xb), axis=-1, keepdims=True)
+    if e4m3_scale:
+        amax = jnp.maximum(amax, FP4_MAX * 2.0**-9)
+        s = (amax / FP4_MAX).astype(jnp.float8_e4m3fn).astype(jnp.float32)
+    else:
+        amax = jnp.maximum(amax, FP4_MAX * 2.0**-126)
+        s = _pow2_ceil(amax * np.float32(1.0 / FP4_MAX))
+    y = jnp.clip(xb / s, -FP4_MAX, FP4_MAX).astype(jnp.float4_e2m1fn).astype(jnp.float32) * s
+    return y.reshape(shape).astype(x.dtype)
+
+
+def rope_freqs(dim, original_seq_len, base, factor, beta_fast, beta_slow) -> np.ndarray:
+    """Per-pair angular frequencies, `precompute_freqs_cis` before the outer product. YaRN
+    applies when `original_seq_len > 0`."""
+    freqs = 1.0 / (np.float32(base) ** (np.arange(0, dim, 2, dtype=np.float32) / np.float32(dim)))
+    freqs = freqs.astype(np.float32)
+    if original_seq_len > 0:
+
+        def corrected_dim(rotations):
+            return dim * math.log(original_seq_len / (rotations * 2 * math.pi)) / (2 * math.log(base))
+
+        low = max(math.floor(corrected_dim(beta_fast)), 0)
+        high = min(math.ceil(corrected_dim(beta_slow)), dim - 1)
+        ramp = np.clip((np.arange(dim // 2, dtype=np.float32) - low) / max(high - low, 1e-3), 0, 1)
+        smooth = (1 - ramp).astype(np.float32)
+        freqs = (freqs / np.float32(factor) * (1 - smooth) + freqs * smooth).astype(np.float32)
+    return freqs
+
+
+def rope_cos_sin(positions, freqs):
+    angle = positions.astype(jnp.float32)[..., None] * jnp.asarray(np.array(freqs, np.float32))[None, :]
+    return jnp.cos(angle), jnp.sin(angle)
+
+
+def apply_rope(x, cos, sin, rd, inverse=False):
+    """Rotate the last `rd` channels as adjacent pairs, `apply_rotary_emb`. `cos`/`sin` are
+    `[T, rd/2]` and broadcast over any axes between the token axis and the channel axis."""
+    head, tail = x[..., :-rd], x[..., -rd:]
+    t = tail.astype(jnp.float32).reshape(*tail.shape[:-1], rd // 2, 2)
+    a, b = t[..., 0], t[..., 1]
+    extra = x.ndim - 2
+    c = cos.reshape(cos.shape[0], *([1] * extra), cos.shape[-1])
+    s = sin.reshape(sin.shape[0], *([1] * extra), sin.shape[-1])
+    if inverse:
+        s = -s
+    out = jnp.stack([a * c - b * s, a * s + b * c], axis=-1).reshape(tail.shape)
+    return jnp.concatenate([head, out.astype(x.dtype)], axis=-1)
+
+
+def sinkhorn_split(mixes, hc_scale, hc_base, hc, iters, eps):
+    """`hc_split_sinkhorn`: pre, post and the doubly stochastic comb from one projection."""
+    m = mixes.astype(jnp.float32)
+    scale = hc_scale.astype(jnp.float32)
+    base = hc_base.astype(jnp.float32)
+    pre = jax.nn.sigmoid(m[..., :hc] * scale[0] + base[:hc]) + eps
+    post = 2.0 * jax.nn.sigmoid(m[..., hc : 2 * hc] * scale[1] + base[hc : 2 * hc])
+    c = m[..., 2 * hc :] * scale[2] + base[2 * hc :]
+    c = c.reshape(*c.shape[:-1], hc, hc)
+    c = jax.nn.softmax(c, axis=-1) + eps
+    c = c / (jnp.sum(c, axis=-2, keepdims=True) + eps)
+    for _ in range(iters - 1):
+        c = c / (jnp.sum(c, axis=-1, keepdims=True) + eps)
+        c = c / (jnp.sum(c, axis=-2, keepdims=True) + eps)
+    return pre, post, c
+
+
+def hc_pre(x, pre_mix):
+    """Collapse `[T, hc, D]` to `[T, D]` with weights `[T, hc]`."""
+    return jnp.sum(pre_mix[..., None] * x.astype(jnp.float32), axis=-2).astype(x.dtype)
+
+
+def hc_post(y, residual, post, comb):
+    """`post[j] * y + sum_i comb[i, j] * residual[i]`, `[T, hc, D]`."""
+    mixed = jnp.einsum("tij,tid->tjd", comb, residual.astype(jnp.float32))
+    return (post[..., None] * y.astype(jnp.float32)[:, None, :] + mixed).astype(y.dtype)
+
+
+# --------------------------------------------------------------------------------------------
+# Token metadata
+# --------------------------------------------------------------------------------------------
+
+
+@jax.tree_util.register_pytree_node_class
+@dataclasses.dataclass
+class TokenMeta:
+    """Per-token and per-request views of one forward batch, all on device.
+
+    `slot` is the state-pool row a token reads and writes: `req_pool_index + 1`, or 0 for a padding
+    token. `prefix` is how many tokens of the request the pool already holds, `end` how many it
+    holds after this pass, `idx` the token's place inside its request's chunk.
+    """
+
+    valid: jax.Array  # [T] bool
+    pos: jax.Array  # [T] int32
+    slot: jax.Array  # [T] int32
+    prefix: jax.Array  # [T] int32
+    end: jax.Array  # [T] int32
+    idx: jax.Array  # [T] int32
+    req_slot: jax.Array  # [B] int32
+    req_prefix: jax.Array  # [B] int32
+    req_lens: jax.Array  # [B] int32
+    req_start: jax.Array  # [B] int32
+
+    def tree_flatten(self):
+        return tuple(getattr(self, f.name) for f in dataclasses.fields(self)), None
+
+    @classmethod
+    def tree_unflatten(cls, aux, children):
+        return cls(*children)
+
+
+def token_meta(num_tokens, req_pool_indices, prefix_lens, extend_lens) -> TokenMeta:
+    """Tokens sit request after request, each request's in position order, the layout
+    `ForwardBatch` uses for extend and decode alike. `extend_lens[b] == 0` marks a padding
+    request."""
+    req_pool_indices = jnp.asarray(req_pool_indices, jnp.int32)
+    prefix_lens = jnp.asarray(prefix_lens, jnp.int32)
+    extend_lens = jnp.asarray(extend_lens, jnp.int32)
+    cum = jnp.cumsum(extend_lens)
+    start = cum - extend_lens
+    t = jnp.arange(num_tokens, dtype=jnp.int32)
+    b = jnp.clip(jnp.searchsorted(cum, t, side="right"), 0, extend_lens.shape[0] - 1)
+    valid = t < cum[-1]
+    idx = t - start[b]
+    prefix = prefix_lens[b]
+    req_slot = jnp.where(extend_lens > 0, req_pool_indices + 1, 0)
+    return TokenMeta(
+        valid=valid,
+        pos=jnp.where(valid, prefix + idx, 0),
+        slot=jnp.where(valid, req_slot[b], 0),
+        prefix=jnp.where(valid, prefix, 0),
+        end=jnp.where(valid, prefix + extend_lens[b], 0),
+        idx=jnp.where(valid, idx, 0),
+        req_slot=req_slot,
+        req_prefix=prefix_lens,
+        req_lens=extend_lens,
+        req_start=start,
+    )
+
+
+def _replicated(x):
+    """The engine shards batch arrays over `data`. Metadata here is small and every token reads
+    all of it, so it runs replicated."""
+    return jax.sharding.reshard(jnp.asarray(x, jnp.int32), P())
+
+
+def meta_from_forward_batch(forward_batch) -> TokenMeta:
+    num_tokens = forward_batch.input_ids.shape[0]
+    req = _replicated(forward_batch.req_pool_indices)
+    if forward_batch.forward_mode.is_decode():
+        seq_lens = _replicated(forward_batch.seq_lens)
+        lens = (seq_lens > 0).astype(jnp.int32)
+        return token_meta(num_tokens, req, jnp.maximum(seq_lens - 1, 0), lens)
+    return token_meta(
+        num_tokens,
+        req,
+        _replicated(forward_batch.extend_prefix_lens),
+        _replicated(forward_batch.extend_seq_lens),
+    )
+
+
+# --------------------------------------------------------------------------------------------
+# State
+# --------------------------------------------------------------------------------------------
+
+
+def state_shapes(cfg, num_slots, max_context, dtype):
+    """Shapes and dtypes of every state array, keyed the way the model reads them. `num_slots`
+    counts the dummy slot 0."""
+    hd, win, ihd = int(cfg.head_dim), int(cfg.window_size), int(cfg.index_head_dim)
+    n_layers = int(cfg.n_layers)
+    out = {"window": [((num_slots, win, hd), dtype) for _ in range(n_layers)]}
+    out["ckv"], out["ik"], out["tail_kv"], out["tail_score"] = [], [], [], []
+    for r in owner_ratios(cfg):
+        cap = max_context // r
+        out["ckv"].append(((num_slots, cap, hd), dtype))
+        out["ik"].append(((num_slots, cap, ihd), dtype))
+        out["tail_kv"].append(((num_slots, max(r, 1), hd), jnp.float32))
+        out["tail_score"].append(((num_slots, max(r, 1), hd), jnp.float32))
+    hist = max(int(getattr(cfg, "engram_max_ngram_size", 1)) - 1, 1)
+    out["engram_hist"] = [((num_slots, hist), jnp.int32)]
+    return out
+
+
+def init_state(cfg, num_slots, max_context, dtype, sharding=None):
+    shapes = state_shapes(cfg, num_slots, max_context, dtype)
+    return {
+        key: [jnp.zeros(shape, dt, device=sharding) for shape, dt in entries]
+        for key, entries in shapes.items()
+    }
+
+
+def _scatter_rows(buf, slot, row, values, write):
+    """buf[slot, row] = values where `write`, else into the dummy slot 0 at row 0."""
+    slot = jnp.where(write, slot, 0)
+    row = jnp.where(write, row, 0)
+    return buf.at[slot, row].set(values.astype(buf.dtype))
+
+
+# --------------------------------------------------------------------------------------------
+# Parameters
+# --------------------------------------------------------------------------------------------
+
+
+def _param(shape, dtype, spec=None):
+    spec = spec or (None,) * len(shape)
+    return nnx.Param(jnp.zeros(shape, dtype=dtype, out_sharding=P(*spec)))
+
+
+class Buffer(nnx.Variable):
+    """A loaded array that isn't trained and isn't a weight: the Engram token map."""
+
+
+class DeepseekV41Compressor(nnx.Module):
+    def __init__(self, cfg, ratio, dtype):
+        dim, hd = int(cfg.dim), int(cfg.head_dim)
+        self.ratio = ratio
+        # ratio 1 is a plain projection; the softmax pooling above ratio 1 runs in FP32
+        wdtype = jnp.float32 if ratio > 1 else dtype
+        self.wkv = _param((dim, hd), wdtype)
+        if ratio > 1:
+            self.wgate = _param((dim, hd), jnp.float32)
+        self.norm = _param((hd,), jnp.float32)
+
+
+class DeepseekV41Indexer(nnx.Module):
+    def __init__(self, cfg, owns_k, dtype):
+        dim, qr = int(cfg.dim), int(cfg.q_lora_rank)
+        ih, ihd, hd = int(cfg.index_n_heads), int(cfg.index_head_dim), int(cfg.head_dim)
+        self.wq_b = _param((qr, ih * ihd), dtype)
+        self.weights_proj = _param((dim, ih), dtype)
+        self.owns_k = owns_k
+        if owns_k:
+            self.wk = _param((hd, ihd), dtype)
+            self.k_norm = _param((ihd,), jnp.float32)
+
+
+class DeepseekV41Attention(nnx.Module):
+    """`Attention` in the reference: a window of raw latents plus, at ratio > 0, the top-k
+    compressed latents, in one softmax with a per-head sink."""
+
+    def __init__(self, cfg, role: LayerRole, dtype):
+        self.role = role
+        self.dim = int(cfg.dim)
+        self.n_heads = int(cfg.n_heads)
+        self.head_dim = int(cfg.head_dim)
+        self.rd = int(cfg.rope_head_dim)
+        self.q_lora_rank = int(cfg.q_lora_rank)
+        self.o_groups = int(cfg.o_groups)
+        self.o_lora_rank = int(cfg.o_lora_rank)
+        self.window = int(cfg.window_size)
+        self.eps = float(cfg.norm_eps)
+        self.index_n_heads = int(cfg.index_n_heads)
+        self.index_head_dim = int(cfg.index_head_dim)
+        self.index_topk = int(cfg.index_topk)
+        self.cand_blocks = int(getattr(cfg, "candidate_topk_blocks", 0))
+        self.cand_block_size = int(getattr(cfg, "candidate_block_size", 0))
+        self.dtype = dtype
+        h, hd = self.n_heads, self.head_dim
+        self.attn_sink = _param((h,), jnp.float32)
+        self.wq_a = _param((self.dim, self.q_lora_rank), dtype)
+        self.q_norm = _param((self.q_lora_rank,), jnp.float32)
+        self.wq_b = _param((self.q_lora_rank, h * hd), dtype)
+        self.wkv = _param((self.dim, hd), dtype)
+        self.kv_norm = _param((hd,), jnp.float32)
+        self.wo_a = _param((self.o_groups, self.o_lora_rank, h * hd // self.o_groups), dtype)
+        self.wo_b = _param((self.o_groups * self.o_lora_rank, self.dim), dtype)
+        self.compressor = DeepseekV41Compressor(cfg, role.ratio, dtype) if role.owns_kv else None
+        self.indexer = (
+            DeepseekV41Indexer(cfg, role.owns_kv, dtype) if role.ratio and role.owns_index else None
+        )
+        if role.ratio:
+            freqs = rope_freqs(
+                self.rd,
+                int(cfg.original_seq_len),
+                float(cfg.compress_rope_theta),
+                float(cfg.rope_factor),
+                int(cfg.beta_fast),
+                int(cfg.beta_slow),
+            )
+        else:
+            # pure sliding-window layers turn YaRN off and use the base theta
+            freqs = rope_freqs(self.rd, 0, float(cfg.rope_theta), float(cfg.rope_factor),
+                               int(cfg.beta_fast), int(cfg.beta_slow))
+        self.freqs = tuple(float(f) for f in freqs)
+
+    # --- window -------------------------------------------------------------------------
+
+    def _window(self, kv, meta, state):
+        """Keys and mask for the window: the ring as it stood before this pass, then the band of
+        this request's chunk ending at the query. Writes the chunk's newest tokens to the ring."""
+        win, layer = self.window, self.role.layer_id
+        ring_buf = state["window"][layer]
+        ring = ring_buf[meta.slot]  # [T, win, hd]
+        j = jnp.arange(win, dtype=jnp.int32)[None, :]
+        last = meta.prefix[:, None] - 1
+        ring_pos = last - jnp.mod(last - j, win)  # newest position < prefix in ring slot j
+        lo = meta.pos[:, None] - win + 1
+        ring_ok = (ring_pos >= 0) & (ring_pos >= lo) & meta.valid[:, None]
+        o = jnp.arange(win, dtype=jnp.int32)[None, :]
+        t = jnp.arange(kv.shape[0], dtype=jnp.int32)[:, None]
+        band = kv[jnp.clip(t - o, 0, kv.shape[0] - 1)]  # [T, win, hd]
+        band_ok = (o <= meta.idx[:, None]) & meta.valid[:, None]
+        write = meta.valid & (meta.pos >= meta.end - win)
+        state["window"][layer] = _scatter_rows(ring_buf, meta.slot, jnp.mod(meta.pos, win), kv, write)
+        return jnp.concatenate([ring, band], axis=1), jnp.concatenate([ring_ok, band_ok], axis=1)
+
+    # --- compressor ---------------------------------------------------------------------
+
+    def _compress(self, x, meta, state):
+        """`Compressor.forward`: the pre-RoPE latent of each group this pass closes, and which
+        tokens close one. Updates the tail of the open group."""
+        c, r, owner = self.compressor, self.role.ratio, self.role.kv_owner
+        if r == 1:
+            latent = rms_norm(x @ c.wkv.value, c.norm.value, self.eps)
+            return latent, meta.valid
+        xf = x.astype(jnp.float32)
+        kvc = xf @ c.wkv.value.astype(jnp.float32)
+        sc = xf @ c.wgate.value.astype(jnp.float32)
+        closes = meta.valid & (jnp.mod(meta.pos + 1, r) == 0)
+        tail_kv = state["tail_kv"][owner][meta.slot]  # [T, r, hd]
+        tail_sc = state["tail_score"][owner][meta.slot]
+        k = jnp.arange(r, dtype=jnp.int32)[None, :]
+        q = meta.pos[:, None] - (r - 1) + k  # member positions
+        in_chunk = q >= meta.prefix[:, None]
+        t = jnp.arange(x.shape[0], dtype=jnp.int32)[:, None]
+        src = jnp.clip(t - (meta.pos[:, None] - q), 0, x.shape[0] - 1)
+        slot_idx = jnp.mod(q, r)
+        mem_kv = jnp.where(in_chunk[..., None], kvc[src], jnp.take_along_axis(tail_kv, slot_idx[..., None], 1))
+        mem_sc = jnp.where(in_chunk[..., None], sc[src], jnp.take_along_axis(tail_sc, slot_idx[..., None], 1))
+        pooled = jnp.sum(mem_kv * jax.nn.softmax(mem_sc, axis=1), axis=1)
+        latent = rms_norm(pooled.astype(x.dtype), c.norm.value, self.eps)
+        write = meta.valid & (meta.pos >= meta.end - r)
+        state["tail_kv"][owner] = _scatter_rows(state["tail_kv"][owner], meta.slot, jnp.mod(meta.pos, r), kvc, write)
+        state["tail_score"][owner] = _scatter_rows(
+            state["tail_score"][owner], meta.slot, jnp.mod(meta.pos, r), sc, write
+        )
+        return latent, closes
+
+    # --- indexer ------------------------------------------------------------------------
+
+    def _index(self, x, qr, meta, state, shared, latent, closes, cos_c, sin_c):
+        """`Indexer.forward`: publish index keys when this layer owns the cache, then score every
+        compressed position of the request and keep the top-k."""
+        ix, r, owner, rd = self.indexer, self.role.ratio, self.role.kv_owner, self.rd
+        if ix.owns_k:
+            k = rms_norm(latent @ ix.wk.value, ix.k_norm.value, self.eps)
+            k = apply_rope(k, cos_c, sin_c, rd)
+            k = fp4_roundtrip(k, 32)
+            state["ik"][owner] = _scatter_rows(state["ik"][owner], meta.slot, meta.pos // r, k, closes)
+        cos, sin = rope_cos_sin(meta.pos, self.freqs)
+        q = (qr @ ix.wq_b.value).reshape(-1, self.index_n_heads, self.index_head_dim)
+        q = apply_rope(q, cos, sin, rd)
+        q = fp4_roundtrip(q, 32)
+        keys = state["ik"][owner][meta.slot]  # [T, cap, ihd]
+        w = (x @ ix.weights_proj.value).astype(jnp.float32) * (
+            self.index_head_dim**-0.5 * self.index_n_heads**-0.5
+        )
+        score = jnp.einsum("thd,tnd->thn", q.astype(jnp.float32), keys.astype(jnp.float32))
+        score = jnp.sum(jax.nn.relu(score) * w[..., None], axis=1)  # [T, cap]
+        cap = score.shape[-1]
+        clen = (meta.pos + 1) // r
+        n = jnp.arange(cap, dtype=jnp.int32)[None, :]
+        score = jnp.where((n < clen[:, None]) & meta.valid[:, None], score, -jnp.inf)
+        if self.role.is_candidate_source:
+            shared["candidates"] = self._candidates(score, clen, shared.get("margins"))
+        elif self.role.uses_candidates:
+            score = jnp.where(shared["candidates"], score, -jnp.inf)
+        topk = min(self.index_topk, cap)
+        vals, idxs = jax.lax.top_k(score, topk)
+        if "margins" in shared and topk < cap:
+            # the relative gap between the last kept and the first dropped score; a gap near
+            # float32 resolution means another library may keep the other one
+            v2, _ = jax.lax.top_k(score, topk + 1)
+            a, b = v2[:, topk - 1], v2[:, topk]
+            gap = jnp.where(jnp.isfinite(b), (a - b) / (jnp.abs(a) + 1e-30), jnp.inf)
+            shared["margins"].append((f"topk{self.role.layer_id}", gap))
+        ok = (vals > -jnp.inf) & (idxs < clen[:, None])
+        shared["topk"][self.role.layer_id] = (idxs, ok)
+        return idxs, ok
+
+    def _candidates(self, score, clen, margins=None):
+        """`select_candidate_blocks`: the `candidate_topk_blocks` best blocks per query, the block
+        holding the newest position pinned in."""
+        bs = self.cand_block_size
+        width = score.shape[-1]
+        pad = -width % bs
+        s = jnp.pad(score, ((0, 0), (0, pad)), constant_values=-jnp.inf)
+        s = s.reshape(s.shape[0], -1, bs).max(axis=-1)
+        nb = s.shape[-1]
+        last = jnp.floor_divide(clen - 1, bs)
+        s = jnp.where(jnp.arange(nb)[None, :] == last[:, None], jnp.inf, s)
+        vals, idxs = jax.lax.top_k(s, min(self.cand_blocks, nb))
+        if margins is not None and self.cand_blocks < nb:
+            v2, _ = jax.lax.top_k(s, self.cand_blocks + 1)
+            a, b = v2[:, self.cand_blocks - 1], v2[:, self.cand_blocks]
+            ok = jnp.isfinite(a) & jnp.isfinite(b)
+            margins.append(("cand", jnp.where(ok, (a - b) / (jnp.abs(a) + 1e-30), jnp.inf)))
+        keep = jnp.zeros_like(s, dtype=bool)
+        keep = keep.at[jnp.arange(s.shape[0])[:, None], idxs].set(vals > -jnp.inf)
+        return jnp.repeat(keep, bs, axis=-1)[:, :width]
+
+    # --- forward ------------------------------------------------------------------------
+
+    def __call__(self, x, meta, state, shared):
+        rd, h, hd = self.rd, self.n_heads, self.head_dim
+        cos, sin = rope_cos_sin(meta.pos, self.freqs)
+        qr = rms_norm(x @ self.wq_a.value, self.q_norm.value, self.eps)
+        q = (qr @ self.wq_b.value).reshape(-1, h, hd)
+        q = apply_rope(q, cos, sin, rd)
+
+        kv = rms_norm(x @ self.wkv.value, self.kv_norm.value, self.eps)
+        kv = apply_rope(kv, cos, sin, rd)
+        kv = fp8_roundtrip(kv, 32)
+        keys, mask = self._window(kv, meta, state)
+
+        if self.role.ratio:
+            r, owner = self.role.ratio, self.role.kv_owner
+            latent = closes = cos_c = sin_c = None
+            if self.role.owns_kv:
+                latent, closes = self._compress(x, meta, state)
+                # a latent stands for the first token of its group
+                gpos = (meta.pos // r) * r
+                cos_c, sin_c = rope_cos_sin(gpos, self.freqs)
+            if self.role.owns_index:
+                idxs, ok = self._index(x, qr, meta, state, shared, latent, closes, cos_c, sin_c)
+            else:
+                idxs, ok = shared["topk"][self.role.index_source]
+            if self.role.owns_kv:
+                lat = apply_rope(latent, cos_c, sin_c, rd)
+                lat = fp4_roundtrip(lat, 16, e4m3_scale=True)
+                state["ckv"][owner] = _scatter_rows(state["ckv"][owner], meta.slot, meta.pos // r, lat, closes)
+            ckv = state["ckv"][owner][meta.slot[:, None], idxs]  # [T, K, hd]
+            keys = jnp.concatenate([keys, ckv], axis=1)
+            mask = jnp.concatenate([mask, ok & meta.valid[:, None]], axis=1)
+
+        o = self._attend(q, keys, mask)
+        o = apply_rope(o, cos, sin, rd, inverse=True)
+        o = o.reshape(o.shape[0], self.o_groups, -1)
+        o = jnp.einsum("tgd,grd->tgr", o, self.wo_a.value)
+        return o.reshape(o.shape[0], -1) @ self.wo_b.value
+
+    def _attend(self, q, keys, mask):
+        """`sparse_attn`: one softmax over the selected latents and the per-head sink. The latent
+        is key and value at once."""
+        scale = self.head_dim**-0.5
+        logits = jnp.einsum("thd,tkd->thk", q.astype(jnp.float32), keys.astype(jnp.float32)) * scale
+        logits = jnp.where(mask[:, None, :], logits, -jnp.inf)
+        sink = self.attn_sink.value.astype(jnp.float32)[None, :]
+        m = jnp.maximum(jnp.max(logits, axis=-1), sink)
+        p = jnp.exp(logits - m[..., None])
+        denom = jnp.sum(p, axis=-1) + jnp.exp(sink - m)
+        o = jnp.einsum("thk,tkd->thd", p, keys.astype(jnp.float32)) / denom[..., None]
+        return o.astype(q.dtype)
+
+
+class DeepseekV41EPMoE(EPMoE):
+    """`EPMoE` with the SwiGLU clamp the checkpoint trained with: the up branch clamped on both
+    sides, the gate branch from above (`Expert.forward`)."""
+
+    swiglu_limit: float = 0.0
+
+    def _gmm_compute(
+        self,
+        inputs_2d,
+        token_indices,
+        group_sizes,
+        w0_kernel,
+        w1_kernel,
+        wo_kernel,
+        group_offset,
+        w0_kernel_scale=None,
+        w1_kernel_scale=None,
+        wo_kernel_scale=None,
+        w0_kernel_bias=None,
+        w1_kernel_bias=None,
+        wo_kernel_bias=None,
+        local_range=None,
+    ):
+        if token_indices.shape[0] == 0:
+            return jnp.zeros((0, wo_kernel.shape[-1]), dtype=inputs_2d.dtype)
+        if local_range is not None:
+            x = _moe.sc_dispatch_gather(inputs_2d, token_indices, *local_range).astype(self.dtype)
+        else:
+            x = inputs_2d[token_indices].astype(self.dtype)
+        group_sizes = group_sizes.astype(jnp.int32)
+        kwargs = dict(
+            group_sizes=group_sizes,
+            preferred_element_type=self.dtype,
+            group_offset=group_offset,
+            maybe_quantize_lhs=False,
+            acc_dtype=jnp.float32,
+        )
+        gate = _moe.gmm(lhs=x, rhs=w0_kernel, rhs_scale=w0_kernel_scale, rhs_bias=w0_kernel_bias,
+                        zero_initialize=False, **kwargs)
+        up = _moe.gmm(lhs=x, rhs=w1_kernel, rhs_scale=w1_kernel_scale, rhs_bias=w1_kernel_bias,
+                      zero_initialize=False, **kwargs)
+        gate = gate.astype(jnp.float32)
+        up = up.astype(jnp.float32)
+        if self.swiglu_limit > 0:
+            up = jnp.clip(up, -self.swiglu_limit, self.swiglu_limit)
+            gate = jnp.minimum(gate, self.swiglu_limit)
+        act = (jax.nn.silu(gate) * up).astype(self.dtype)
+        return _moe.gmm(lhs=act, rhs=wo_kernel, rhs_scale=wo_kernel_scale, rhs_bias=wo_kernel_bias,
+                        zero_initialize=True, **kwargs)
+
+
+class DeepseekV41MoE(nnx.Module):
+    """`MoE`: `sqrtsoftplus` routing with a selection-only bias, `route_scale`, one shared
+    expert."""
+
+    def __init__(self, cfg, mesh, layer_id, dtype, ep_size):
+        dim, inter = int(cfg.dim), int(cfg.moe_inter_dim)
+        self.n_experts = int(cfg.n_routed_experts)
+        self.topk = int(cfg.n_activated_experts)
+        self.score_func = str(cfg.score_func)
+        self.gate_temp = float(getattr(cfg, "gate_temp", 1.0))
+        self.norm_topk_prob = bool(cfg.norm_topk_prob)
+        self.route_scale = float(cfg.route_scale)
+        self.swiglu_limit = float(cfg.swiglu_limit)
+        self.gate_weight = _param((self.n_experts, dim), jnp.float32)
+        self.gate_bias = _param((self.n_experts,), jnp.float32)
+        self.experts = DeepseekV41EPMoE(
+            hidden_size=dim,
+            num_experts=self.n_experts,
+            num_experts_per_tok=self.topk,
+            ep_size=ep_size,
+            mesh=mesh,
+            intermediate_dim=inter,
+            weight_dtype=dtype,
+            dtype=dtype,
+            layer_id=layer_id,
+        )
+        self.experts.swiglu_limit = self.swiglu_limit
+        self.shared_w1 = _param((dim, inter), dtype)
+        self.shared_w3 = _param((dim, inter), dtype)
+        self.shared_w2 = _param((inter, dim), dtype)
+
+    def route(self, x):
+        scores = (x.astype(jnp.float32) @ self.gate_weight.value.astype(jnp.float32).T) / self.gate_temp
+        if self.score_func == "softmax":
+            scores = jax.nn.softmax(scores, axis=-1)
+        elif self.score_func == "sigmoid":
+            scores = jax.nn.sigmoid(scores)
+        else:
+            scores = jnp.sqrt(jax.nn.softplus(scores))
+        _, idx = jax.lax.top_k(scores + self.gate_bias.value[None, :], self.topk)
+        weights = jnp.take_along_axis(scores, idx, axis=-1)
+        if self.norm_topk_prob and self.topk > 1:
+            weights = weights / (jnp.sum(weights, axis=-1, keepdims=True) + 1e-20)
+        return weights * self.route_scale, idx
+
+    def shared(self, x):
+        gate = (x @ self.shared_w1.value).astype(jnp.float32)
+        up = (x @ self.shared_w3.value).astype(jnp.float32)
+        if self.swiglu_limit > 0:
+            up = jnp.clip(up, -self.swiglu_limit, self.swiglu_limit)
+            gate = jnp.minimum(gate, self.swiglu_limit)
+        return (jax.nn.silu(gate) * up).astype(x.dtype) @ self.shared_w2.value
+
+    def __call__(self, x):
+        weights, idx = self.route(x)
+        routed = self.experts(x, weights.astype(x.dtype), idx.astype(jnp.int32))
+        return (routed.astype(jnp.float32) + self.shared(x).astype(jnp.float32)).astype(x.dtype)
+
+
+# --------------------------------------------------------------------------------------------
+# Engram
+# --------------------------------------------------------------------------------------------
+
+
+def _isprime(n: int) -> bool:
+    from sympy import isprime
+
+    return bool(isprime(n))
+
+
+@dataclasses.dataclass(frozen=True)
+class EngramLayout:
+    """`engram.EngramLayout`: per layer, per n-gram size, per head, a prime-sized bucket range,
+    primes drawn in order and never reused."""
+
+    max_ngram_size: int
+    layer_ids: tuple
+    num_embeddings: tuple
+    primes: tuple  # [layer][ngram][head]
+    n_heads: int
+    head_dim: int
+
+    @classmethod
+    def from_config(cls, cfg):
+        layer_ids = tuple(int(i) for i in getattr(cfg, "engram_layer_ids", []))
+        if not layer_ids:
+            return None
+        max_n, heads = int(cfg.engram_max_ngram_size), int(cfg.engram_n_heads)
+        primes, seen = [], set()
+        for _ in layer_ids:
+            per_ngram = []
+            for _ in range(max_n - 1):
+                sizes, current = [], int(cfg.engram_vocab_size) - 1
+                for _ in range(heads):
+                    candidate = current + 1
+                    while not _isprime(candidate) or candidate in seen:
+                        candidate += 1
+                    current = candidate
+                    seen.add(current)
+                    sizes.append(current)
+                per_ngram.append(tuple(sizes))
+            primes.append(tuple(per_ngram))
+        return cls(max_n, layer_ids, tuple(int(n) for n in cfg.engram_num_embeddings),
+                   tuple(primes), heads, int(cfg.engram_head_dim))
+
+    @property
+    def n_hash_cols(self):
+        return (self.max_ngram_size - 1) * self.n_heads
+
+
+def engram_multipliers(layer_ids, max_ngram_size, compressed_vocab_size) -> np.ndarray:
+    """`engram.compute_hash_multipliers`: odd, from a per-layer RNG, bounded so the products fit
+    in int64. `[layers, max_ngram_size]` int64."""
+    max_long = np.iinfo(np.int64).max
+    bound = max(1, (max_long // compressed_vocab_size) // 2)
+    rows = []
+    for layer_id in layer_ids:
+        gen = np.random.default_rng(10007 * layer_id)
+        values = gen.integers(low=0, high=bound, size=(max_ngram_size,), dtype=np.int64)
+        rows.append(values * 2 + 1)
+    return np.stack(rows)
+
+
+def build_compressed_token_map(tokenizer) -> tuple[list[int], int]:
+    """`engram.build_compressed_token_map`: tokens that normalize alike share one id."""
+    from tokenizers import Regex, normalizers
+
+    sentinel = "\ue000"
+    normalizer = normalizers.Sequence(
+        [
+            normalizers.NFKC(),
+            normalizers.NFD(),
+            normalizers.StripAccents(),
+            normalizers.Lowercase(),
+            normalizers.Replace(Regex(r"[ \t\r\n]+"), " "),
+            normalizers.Replace(Regex(r"^ $"), sentinel),
+            normalizers.Strip(),
+            normalizers.Replace(sentinel, " "),
+        ]
+    )
+    backend = tokenizer.backend_tokenizer
+    key_to_new: dict[str, int] = {}
+    lookup = [0] * len(tokenizer)
+    for token_id in range(len(tokenizer)):
+        text = backend.decode([token_id], skip_special_tokens=False)
+        if "\ufffd" in text:
+            key = backend.id_to_token(token_id)
+        else:
+            normalized = normalizer.normalize_str(text)
+            key = normalized if normalized else text
+        new_id = key_to_new.get(key)
+        if new_id is None:
+            new_id = len(key_to_new)
+            key_to_new[key] = new_id
+        lookup[token_id] = new_id
+    return lookup, len(key_to_new)
+
+
+def _as_tuple(a: np.ndarray):
+    return tuple(_as_tuple(x) for x in a) if a.ndim > 1 else tuple(int(v) for v in a)
+
+
+def _u64_limbs(values: np.ndarray) -> np.ndarray:
+    """int64 -> four 16-bit limbs, least significant first, as uint32."""
+    v = values.astype(np.uint64)
+    return np.stack([((v >> np.uint64(16 * i)) & np.uint64(0xFFFF)).astype(np.uint32) for i in range(4)], -1)
+
+
+def _mul_u17_u64(t, m_limbs):
+    """t (< 2**32, as uint32) times a 64-bit constant in 16-bit limbs, mod 2**64, in limbs.
+    Every partial product of two 16-bit limbs fits in uint32, and the halves accumulate apart."""
+    t_limbs = [t & 0xFFFF, t >> 16]
+    acc = [jnp.zeros_like(t) for _ in range(6)]
+    for i, ti in enumerate(t_limbs):
+        for j in range(4):
+            if i + j >= 4:
+                continue
+            pp = ti * m_limbs[..., j]
+            acc[i + j] = acc[i + j] + (pp & 0xFFFF)
+            acc[i + j + 1] = acc[i + j + 1] + (pp >> 16)
+    out, carry = [], jnp.zeros_like(t)
+    for k in range(4):
+        v = acc[k] + carry
+        out.append(v & 0xFFFF)
+        carry = v >> 16
+    return jnp.stack(out, -1)
+
+
+def _mod_limbs(limbs, p):
+    """A 64-bit value in 16-bit limbs modulo p < 2**27, four bits at a time in uint32."""
+    r = jnp.zeros(limbs.shape[:-1], jnp.uint32)
+    for k in range(3, -1, -1):
+        limb = limbs[..., k]
+        for shift in (12, 8, 4, 0):
+            r = (r * 16 + ((limb >> shift) & 0xF)) % p
+    return r
+
+
+def _mesh_axes(mesh):
+    """Every axis of the mesh, in order: the Engram tables split their rows over all of them."""
+    return tuple(mesh.axis_names) if mesh is not None else ()
+
+
+def _mesh_size(mesh):
+    return int(np.prod([mesh.shape[a] for a in _mesh_axes(mesh)])) if mesh is not None else 1
+
+
+class DeepseekV41Engram(nnx.Module):
+    """`Engram` with its `ParallelEngramEmbedding`: the table stays E4M3 with one E8M0 exponent
+    per 32 channels, and a row widens on lookup.
+
+    The rows split evenly over every device of the mesh, padded up to a multiple of the device
+    count the way `convert.py` pads its shards. A lookup runs inside `shard_map`: each device
+    gathers against its own slice, zeroes the rows it doesn't hold, and one `psum` over the mesh
+    sums the widened rows, as `ParallelEngramEmbedding.forward` does across ranks."""
+
+    def __init__(self, cfg, layout: EngramLayout, slot: int, dtype, mesh=None):
+        self.slot = slot
+        self.dim = int(cfg.dim)
+        self.hc = int(cfg.hc_mult)
+        self.eps = float(cfg.norm_eps)
+        self.head_dim = layout.head_dim
+        self.block = 32
+        self.mesh = mesh
+        self.axes = _mesh_axes(mesh)
+        ways = _mesh_size(mesh)
+        self.rows = layout.num_embeddings[slot]
+        self.padded_rows = -(-self.rows // ways) * ways
+        spec = (self.axes if self.axes else None, None)
+        self.table = _param((self.padded_rows, layout.head_dim), jnp.float8_e4m3fn, spec)
+        self.table_scale = _param((self.padded_rows, layout.head_dim // self.block), jnp.uint8, spec)
+        self.wkv = _param((layout.n_hash_cols * layout.head_dim, self.dim * (self.hc + 1)), dtype)
+        self.q_weight = _param((self.hc, self.dim), jnp.float32)
+        self.k_weight = _param((self.hc, self.dim), jnp.float32)
+
+    def _widen(self, table, scale, ids):
+        rows = table[ids].astype(jnp.float32)  # [T, cols, hd]
+        codes = scale[ids].astype(jnp.int32) - 127
+        factor = jnp.ldexp(jnp.ones(codes.shape, jnp.float32), codes)
+        rows = rows.reshape(*rows.shape[:-1], -1, self.block) * factor[..., None]
+        return rows.reshape(*ids.shape, self.head_dim)
+
+    def lookup(self, hash_ids, dtype):
+        if not self.axes:
+            return self._widen(self.table.value, self.table_scale.value, hash_ids).astype(dtype)
+        axes = self.axes
+
+        def local(table, scale, ids):
+            part = table.shape[0]
+            start = jax.lax.axis_index(axes) * part
+            here = ids - start
+            mask = (here >= 0) & (here < part)
+            rows = self._widen(table, scale, jnp.where(mask, here, 0))
+            rows = jnp.where(mask[..., None], rows, 0.0)
+            return jax.lax.psum(rows, axes)
+
+        out = jax.shard_map(
+            local,
+            mesh=self.mesh,
+            in_specs=(P(axes, None), P(axes, None), P()),
+            out_specs=P(),
+            check_vma=False,
+        )(self.table.value, self.table_scale.value, jax.sharding.reshard(hash_ids, P()))
+        return out.astype(dtype)
+
+    def __call__(self, x, hash_ids):
+        values = self.lookup(hash_ids, x.dtype)
+        kv = values.reshape(values.shape[0], -1) @ self.wkv.value
+        key = kv[:, : self.hc * self.dim].astype(jnp.float32).reshape(-1, self.hc, self.dim)
+        value = kv[:, self.hc * self.dim :].astype(jnp.float32)
+        weight = self.q_weight.value.astype(jnp.float32) * self.k_weight.value.astype(jnp.float32)
+        h = x.astype(jnp.float32)
+        rstd = jax.lax.rsqrt(jnp.mean(h * h, -1) + self.eps) * jax.lax.rsqrt(jnp.mean(key * key, -1) + self.eps)
+        dot = jnp.sum(h * weight * key, -1) * rstd * self.dim**-0.5
+        gate = jax.nn.sigmoid(jnp.copysign(jnp.sqrt(jnp.maximum(jnp.abs(dot), 1e-6)), dot))
+        return (h + gate[..., None] * value[:, None, :]).astype(x.dtype)
+
+
+class DeepseekV41EngramHash(nnx.Module):
+    """`NgramHashState` on device. The hash of a position XORs `token * multiplier` over the
+    n-gram ending there, then reduces modulo each head's prime. Products run in 16-bit limbs,
+    because the engine runs JAX without 64-bit integers."""
+
+    def __init__(self, cfg, layout: EngramLayout, vocab_size: int):
+        self.layout = layout
+        self.max_n = layout.max_ngram_size
+        self.pad_token = int(getattr(cfg, "engram_pad_id", 2))
+        self.compressed_vocab = int(cfg.engram_compressed_vocab_size)
+        self.token_map = Buffer(jnp.zeros((vocab_size,), jnp.int32))
+        self.pad_id = Buffer(jnp.zeros((), jnp.int32))
+        mult = engram_multipliers(layout.layer_ids, self.max_n, self.compressed_vocab)
+        # Constants stay Python tuples. nnx treats an ndarray attribute as graph data, and the
+        # engine's split/merge of the model state then hands back something else.
+        self.mult_limbs = _as_tuple(_u64_limbs(mult))  # [layers, max_n, 4]
+        flat = [[p for per in layer for p in per] for layer in layout.primes]
+        primes = np.array(flat, dtype=np.uint32)  # [layers, cols]
+        offsets = np.array([np.cumsum([0, *sizes[:-1]]) for sizes in flat], dtype=np.int64)
+        self.primes, self.offsets = _as_tuple(primes), _as_tuple(offsets)
+        if offsets.max(initial=0) + primes.max(initial=0) >= 2**31:
+            raise ValueError("Engram row ids need int32")
+
+    def __call__(self, input_ids, meta, state):
+        """Hash ids `[T, layers, cols]` and the new last-token history."""
+        n_hist = self.max_n - 1
+        comp = self.token_map.value[input_ids]
+        hist = state["engram_hist"][0][meta.slot]  # [T, n_hist]; entry k-1 holds position prefix-k
+        t = jnp.arange(input_ids.shape[0], dtype=jnp.int32)
+        pad = self.pad_id.value
+        tokens = [comp]
+        for shift in range(1, self.max_n):
+            from_chunk = comp[jnp.clip(t - shift, 0, input_ids.shape[0] - 1)]
+            back = jnp.clip(shift - meta.idx - 1, 0, n_hist - 1)
+            from_hist = jnp.take_along_axis(hist, back[:, None], 1)[:, 0]
+            tok = jnp.where(shift <= meta.idx, from_chunk, from_hist)
+            tokens.append(jnp.where(meta.pos - shift < 0, pad, tok))
+        tokens = jnp.stack(tokens, -1).astype(jnp.uint32)  # [T, max_n]
+        mult = jnp.asarray(np.array(self.mult_limbs, np.uint32))
+        primes = jnp.asarray(np.array(self.primes, np.uint32))
+        heads = self.layout.n_heads
+        out = []
+        for li in range(len(self.layout.layer_ids)):
+            rolling = _mul_u17_u64(tokens[:, 0], mult[li, 0])
+            cols = []
+            for i in range(1, self.max_n):
+                rolling = rolling ^ _mul_u17_u64(tokens[:, i], mult[li, i])
+                p = primes[li, (i - 1) * heads : i * heads]
+                cols.append(_mod_limbs(rolling[:, None, :], p[None, :]))
+            out.append(jnp.concatenate(cols, -1).astype(jnp.int32) + jnp.asarray(np.array(self.offsets[li]), jnp.int32))
+        new_hist = self._history(comp, meta, state, pad)
+        return jnp.stack(out, 1), new_hist
+
+    def _history(self, comp, meta, state, pad):
+        n_hist = self.max_n - 1
+        buf = state["engram_hist"][0]
+        old = buf[meta.req_slot]  # [B, n_hist]
+        end = meta.req_prefix + meta.req_lens
+        k = jnp.arange(1, n_hist + 1, dtype=jnp.int32)[None, :]
+        q = end[:, None] - k
+        in_chunk = q >= meta.req_prefix[:, None]
+        src = jnp.clip(meta.req_start[:, None] + q - meta.req_prefix[:, None], 0, comp.shape[0] - 1)
+        back = jnp.clip(meta.req_prefix[:, None] - q - 1, 0, n_hist - 1)
+        val = jnp.where(in_chunk, comp[src], jnp.take_along_axis(old, back, 1))
+        val = jnp.where(q < 0, pad, val)
+        slot = jnp.where(meta.req_lens > 0, meta.req_slot, 0)
+        return buf.at[slot].set(val.astype(buf.dtype))
+
+
