+++ b/python/sgl_jax/srt/configs/deepseek_v41.py
@@ -0,0 +1,118 @@
+"""Config for DeepSeek V4.1-Flash (`model_type: deepseek_v41`).
+
+The published `config.json` nests the language model under `text_config` and ships no
+configuration module, so `transformers` can't build it. This class flattens `text_config` onto
+itself, so `get_hf_text_config` returns the config itself and every text field sits at the top.
+
+It also moves the checkpoint's `quantization_config` to `checkpoint_quantization_config`. The
+engine reads `quantization_config.quant_method: fp8` as a request to serve FP8 linears, while this
+model widens its FP8 and FP4 weights to the serving dtype in its own loader, and keeps the Engram
+tables in FP8.
+"""
+
+from __future__ import annotations
+
+from transformers import PretrainedConfig
+
+# Published name -> the name the reference runtime (`inference/model.py` `ModelArgs`) uses. The
+# model reads the reference names, so a tiny test config and the published file land on one set.
+_TEXT_ALIASES = {
+    "hidden_size": "dim",
+    "moe_intermediate_size": "moe_inter_dim",
+    "num_hidden_layers": "n_layers",
+    "num_attention_heads": "n_heads",
+    "qk_rope_head_dim": "rope_head_dim",
+    "rms_norm_eps": "norm_eps",
+    "num_experts_per_tok": "n_activated_experts",
+    "scoring_func": "score_func",
+    "routed_scaling_factor": "route_scale",
+    "sliding_window": "window_size",
+    "kv_source_layer_ids": "kv_source_layers",
+    "index_source_layer_ids": "index_source_layers",
+    "candidate_source_layer_id": "candidate_source_layer",
+    "engram_pad_token_id": "engram_pad_id",
+    "num_nextn_predict_layers": "n_mtp_layers",
+    "dspark_num_experts_per_tok": "dspark_n_activated_experts",
+}
+
+# The reference defaults for fields a config may leave out.
+_DEFAULTS = {
+    "n_shared_experts": 1,
+    "gate_temp": 1.0,
+    "norm_topk_prob": True,
+    "swiglu_limit": 0.0,
+    "o_groups": 8,
+    "compress_rope_theta": 40000.0,
+    "rope_factor": 40.0,
+    "beta_fast": 32,
+    "beta_slow": 1,
+    "original_seq_len": 0,
+    "candidate_source_layer": -1,
+    "candidate_topk_blocks": 0,
+    "candidate_block_size": 0,
+    "hc_mult": 4,
+    "hc_sinkhorn_iters": 20,
+    "hc_eps": 1e-6,
+    "engram_layer_ids": [],
+    "engram_num_embeddings": [],
+    "engram_max_ngram_size": 1,
+    "engram_vocab_size": 0,
+    "engram_n_heads": 0,
+    "engram_head_dim": 0,
+    "engram_pad_id": 2,
+    "engram_compressed_vocab_size": 0,
+    "n_mtp_layers": 0,
+}
+
+
+class DeepseekV41Config(PretrainedConfig):
+    model_type = "deepseek_v41"
+
+    def __init__(self, text_config=None, vision_config=None, **kwargs):
+        quant = kwargs.pop("quantization_config", None)
+        if quant is not None:
+            kwargs.setdefault("checkpoint_quantization_config", quant)
+        text = dict(text_config or {})
+        text.pop("model_type", None)
+        text.update({k: v for k, v in kwargs.items() if k not in ("architectures",)})
+        # transformers 5 standardizes `rope_scaling` into `rope_parameters` inside
+        # PretrainedConfig.__init__. The model reads the four YaRN fields below instead, so the
+        # published dict stays aside under another name.
+        rope = text.pop("rope_scaling", None) or {}
+        text["yarn_rope_scaling"] = rope
+        if rope:
+            text.setdefault("rope_factor", rope.get("factor", 40.0))
+            text.setdefault("beta_fast", rope.get("beta_fast", 32))
+            text.setdefault("beta_slow", rope.get("beta_slow", 1))
+            text.setdefault("original_seq_len", rope.get("original_max_position_embeddings", 0))
+        for published, reference in _TEXT_ALIASES.items():
+            if published in text and reference not in text:
+                text[reference] = text[published]
+            if reference in text and published not in text:
+                text[published] = text[reference]
+        for key, value in _DEFAULTS.items():
+            text.setdefault(key, value)
+        # ModelConfig reads `sliding_window` and then splits the paged KV pool into full and SWA
+        # layers. This model keeps its window ring in its own state pool, so the published name
+        # stays out and the reference name `window_size` carries it.
+        text.pop("sliding_window", None)
+        text.setdefault("num_key_value_heads", 1)
+        text.setdefault("tie_word_embeddings", False)
+        self.vision_config = vision_config
+        for key in ("architectures",):
+            if key in kwargs:
+                text[key] = kwargs[key]
+        super().__init__(**text)
+        # PretrainedConfig drops unknown keys it can't set only on error; set them all again so
+        # every reference name is an attribute.
+        for key, value in text.items():
+            if not hasattr(self, key):
+                setattr(self, key, value)
+        for key in ("compress_ratios", "kv_source_layers", "index_source_layers",
+                    "engram_layer_ids", "engram_num_embeddings", "dspark_target_layer_ids"):
+            if getattr(self, key, None) is not None:
+                setattr(self, key, [int(v) for v in getattr(self, key)])
+        self.head_dim = int(text.get("head_dim", 512))
+        # The engine sizes nothing from these for this model, but ModelConfig reads them.
+        self.v_head_dim = self.head_dim
+        self.max_position_embeddings = int(text.get("max_position_embeddings", 1048576))
