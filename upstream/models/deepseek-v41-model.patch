+# Blocks and model
+# --------------------------------------------------------------------------------------------
+
+
+class DeepseekV41DecoderLayer(nnx.Module):
+    """`Block`: attention and feed-forward between `hc_pre` and `hc_post`. Returns the `pre` mix
+    the next layer's attention collapses with."""
+
+    def __init__(self, cfg, mesh, role, dtype, ep_size, layout):
+        dim, hc = int(cfg.dim), int(cfg.hc_mult)
+        self.role = role
+        self.hc = hc
+        self.eps = float(cfg.norm_eps)
+        self.hc_iters = int(cfg.hc_sinkhorn_iters)
+        self.hc_eps = float(cfg.hc_eps)
+        mix = (2 + hc) * hc
+        self.attn = DeepseekV41Attention(cfg, role, dtype)
+        self.ffn = DeepseekV41MoE(cfg, mesh, role.layer_id, dtype, ep_size)
+        self.attn_norm = _param((dim,), jnp.float32)
+        self.ffn_norm = _param((dim,), jnp.float32)
+        self.hc_attn_fn = _param((mix, hc * dim), jnp.float32)
+        self.hc_ffn_fn = _param((mix, hc * dim), jnp.float32)
+        self.hc_attn_base = _param((mix,), jnp.float32)
+        self.hc_ffn_base = _param((mix,), jnp.float32)
+        self.hc_attn_scale = _param((3,), jnp.float32)
+        self.hc_ffn_scale = _param((3,), jnp.float32)
+        self.engram = (
+            DeepseekV41Engram(cfg, layout, role.engram_slot, dtype, mesh)
+            if role.engram_slot >= 0 else None
+        )
+
+    def hc_mixes(self, x, fn, scale, base):
+        xf = x.reshape(x.shape[0], -1).astype(jnp.float32)
+        rs = jax.lax.rsqrt(jnp.mean(xf * xf, -1, keepdims=True) + self.eps)
+        mixes = (xf @ fn.value.T) * rs
+        return sinkhorn_split(mixes, scale.value, base.value, self.hc, self.hc_iters, self.hc_eps)
+
+    def __call__(self, x, pre_mix, meta, state, shared):
+        residual = x
+        a_pre, a_post, a_comb = self.hc_mixes(x, self.hc_attn_fn, self.hc_attn_scale, self.hc_attn_base)
+        collapsed = hc_pre(x, pre_mix)
+        h = rms_norm(collapsed, self.attn_norm.value, self.eps)
+        h = self.attn(h, meta, state, shared)
+        x = hc_post(h, residual, a_post, a_comb)
+
+        residual = x
+        f_pre, f_post, f_comb = self.hc_mixes(x, self.hc_ffn_fn, self.hc_ffn_scale, self.hc_ffn_base)
+        h = hc_pre(x, a_pre)
+        h = rms_norm(h, self.ffn_norm.value, self.eps)
+        h = self.ffn(h)
+        x = hc_post(h, residual, f_post, f_comb)
+        return x, f_pre, collapsed
+
+
+class DeepseekV41Model(nnx.Module):
+    def __init__(self, cfg, mesh, dtype, ep_size=1):
+        self.cfg = cfg
+        self.dtype = dtype
+        self.hc = int(cfg.hc_mult)
+        self.eps = float(cfg.norm_eps)
+        self.roles = layer_roles(cfg)
+        self.layout = EngramLayout.from_config(cfg)
+        self.embed = Embed(int(cfg.vocab_size), int(cfg.dim), dtype=dtype, param_dtype=dtype,
+                           kernel_axes=(None, None), mesh=mesh)
+        self.layers = nnx.List(
+            [DeepseekV41DecoderLayer(cfg, mesh, role, dtype, ep_size, self.layout) for role in self.roles]
+        )
+        self.norm = _param((int(cfg.dim),), jnp.float32)
+        self.engram_hash = (
+            DeepseekV41EngramHash(cfg, self.layout, int(cfg.vocab_size)) if self.layout else None
+        )
+        self.layers_to_capture = []
+        self.return_streams = False
+
+    def __call__(self, input_ids, meta: TokenMeta, state):
+        """Returns the final collapsed, normed hidden state `[T, D]`, the captured slots, the new
+        state and, when `return_streams`, every layer's four copies after it."""
+        state = {k: list(v) for k, v in state.items()}
+        shared = {"topk": {}}
+        if self.return_streams:
+            shared["margins"] = []
+        hash_ids = None
+        if self.engram_hash is not None:
+            hash_ids, state["engram_hist"][0] = self.engram_hash(input_ids, meta, state)
+        h = self.embed(input_ids).astype(self.dtype)
+        # The window band, the compressor's group members and the Engram history all gather
+        # across the token axis, so the stream stays replicated. Attention weights are
+        # replicated too; only the routed experts shard, inside EPMoE.
+        h = jax.sharding.reshard(h, P(None, None))
+        x = jnp.repeat(h[:, None, :], self.hc, axis=1)
+        pre_mix = jnp.zeros((x.shape[0], self.hc), jnp.float32).at[:, 0].set(1.0)
+        aux, streams = [], []
+        for layer_id, layer in enumerate(self.layers):
+            if layer.engram is not None:
+                x = layer.engram(x, hash_ids[:, layer.engram.slot])
+                if self.return_streams:
+                    streams.append(("engram", layer_id, x))
+            x, pre_mix, collapsed = layer(x, pre_mix, meta, state, shared)
+            if layer_id in self.layers_to_capture:
+                aux.append(collapsed)
+            if self.return_streams:
+                streams.append(("block", layer_id, x))
+                streams.append(("collapsed", layer_id, collapsed))
+        for name, gap in shared.get("margins", []):
+            streams.append((f"margin:{name}", -1, gap))
+        h = hc_pre(x, pre_mix)
+        h = rms_norm(h, self.norm.value, self.eps)
+        return h, aux, state, streams
+
+
+class DeepseekV41ForCausalLM(nnx.Module):
+    """Text backbone of `deepseek-ai/DeepSeek-V4.1-Flash`. DSpark draft blocks (`mtp.*`) and the
+    vision tower (`vision.*`, `aligner.*`, `image_*`) load nothing yet."""
+
+    STATE_POOL = "dsv41_state_pool"
+    # The runner still builds the paged KV pool and the scheduler still hands each token a slot in
+    # it, but nothing reads it. One layer keeps a slot at 2 KiB instead of 80 KiB, and the token
+    # cap keeps the pool from taking the HBM the state pool needs.
+    paged_kv_layers = 1
+    PAGED_KV_TOKEN_CEILING = 1 << 20
+
+    @classmethod
+    def paged_kv_token_cap(cls, server_args, model_config, max_num_reqs):
+        return min(int(max_num_reqs) * int(model_config.context_len), cls.PAGED_KV_TOKEN_CEILING)
+
+    def __init__(self, config, mesh, dtype=jnp.bfloat16):
+        self.config = config
+        self.mesh = mesh
+        self.dtype = dtype
+        ep_size = int(getattr(config, "ep_size", 1) or 1)
+        self.model = DeepseekV41Model(config, mesh, dtype, ep_size=ep_size)
+        self.lm_head = ParallelLMHead(int(config.vocab_size), int(config.dim), dtype=jnp.float32,
+                                      param_dtype=jnp.float32, mesh=mesh)
+        self.logits_processor = LogitsProcessor(int(config.vocab_size), mesh=mesh)
+        self.capture_aux_hidden_states = False
+
+    def set_layers_to_capture(self, layers):
+        self.model.layers_to_capture = list(layers)
+
+    def forward_hidden(self, forward_batch, state):
+        meta = meta_from_forward_batch(forward_batch)
+        return self.model(_replicated(forward_batch.input_ids), meta, state)
+
+    @classmethod
+    def build_extra_memory_pools(cls, model_config, server_args, max_num_reqs, mesh, dtype):
+        """Pools the runner adds beside `token_to_kv_pool`: the per-request state. The model
+        reads none of the engine's paged KV pool."""
+        from sgl_jax.srt.mem_cache.deepseek_v41_state_pool import DeepseekV41StatePool
+
+        if not getattr(server_args, "disable_radix_cache", False):
+            raise ValueError(
+                "DeepseekV41ForCausalLM keeps its caches per request, not per token, so no radix "
+                "prefix can be shared; start the server with --disable-radix-cache"
+            )
+        pool = DeepseekV41StatePool.create(
+            model_config.hf_config, max_num_reqs, model_config.context_len, dtype, mesh
+        )
+        logger.info("DeepSeek V4.1 state pool: %d slots, %.2f GiB", pool.num_slots,
+                    pool.size_bytes() / 2**30)
+        return {cls.STATE_POOL: pool}
+
+    def __call__(self, forward_batch, memory_pools, logits_metadata: LogitsMetadata):
+        pool = getattr(memory_pools, self.STATE_POOL)
+        hidden, aux, new_state, _ = self.forward_hidden(forward_batch, pool.state)
+        if not self.capture_aux_hidden_states:
+            aux = None
+        output = self.logits_processor(hidden.astype(jnp.float32), self.lm_head, logits_metadata,
+                                       aux_hidden_states=aux)
+        updates = {self.STATE_POOL: new_state}
+        for name, other in memory_pools._pools.items():
+            if name != self.STATE_POOL:
+                # this model writes no paged KV; hand the buffers back as they came
+                updates[name] = other.kv_buffer
+        return output, updates, True, None
+
+    # ----------------------------------------------------------------------------------------
+    # Weights
+    # ----------------------------------------------------------------------------------------
+
+    def load_weights(self, model_config):
+        path = model_config.model_path
+        load_checkpoint(self, path)
+        if self.model.engram_hash is not None:
+            from transformers import AutoTokenizer
+
+            tok = AutoTokenizer.from_pretrained(path)
+            self.set_token_map(tok)
+
+    def set_token_map(self, tokenizer):
+        hashing = self.model.engram_hash
+        lookup, size = build_compressed_token_map(tokenizer)
+        if size != hashing.compressed_vocab:
+            raise ValueError(
+                f"the tokenizer compresses to {size} ids, the config says "
+                f"engram_compressed_vocab_size={hashing.compressed_vocab}"
+            )
+        table = np.zeros(hashing.token_map.value.shape, np.int32)
+        table[: len(lookup)] = np.asarray(lookup, np.int32)
+        hashing.token_map.value = jnp.asarray(table)
+        hashing.pad_id.value = jnp.asarray(lookup[hashing.pad_token], jnp.int32)
+
+
+# --------------------------------------------------------------------------------------------
+# Checkpoint reading
+# --------------------------------------------------------------------------------------------
+
+_ST_DTYPES = {
+    "F32": np.float32,
+    "F16": np.float16,
+    "BF16": np.uint16,
+    "F8_E4M3": np.uint8,
+    "F8_E8M0": np.uint8,
+    "I8": np.int8,
+    "U8": np.uint8,
+    "I32": np.int32,
+    "I64": np.int64,
+}
+
+
+def scan_safetensors(path) -> dict:
+    """Every tensor in `path/*.safetensors`: file, dtype tag, shape, byte range."""
+    index = {}
+    for file in sorted(glob.glob(os.path.join(path, "*.safetensors"))):
+        with open(file, "rb") as fp:
+            n = struct.unpack("<Q", fp.read(8))[0]
+            header = json.loads(fp.read(n))
+        base = 8 + n
+        for name, info in header.items():
+            if name == "__metadata__":
+                continue
+            start, stop = info["data_offsets"]
+            index[name] = (file, info["dtype"], tuple(info["shape"]), base + start, base + stop)
+    return index
+
+
+def read_tensor(entry) -> np.ndarray:
+    """Raw read. BF16 comes back as float32, F8_E4M3 as `ml_dtypes.float8_e4m3fn`, F8_E8M0 as
+    its uint8 exponent code, I8 as int8."""
+    import ml_dtypes
+
+    file, tag, shape, start, stop = entry
+    dt = _ST_DTYPES[tag]
+    # A memory map: slicing it reads only the rows asked for, which is how a host reads its own
+    # shard of a 98 GB Engram table.
+    arr = np.memmap(file, dtype=dt, mode="r", offset=start, shape=tuple(shape))
+    if tag == "BF16":
+        return (arr.astype(np.uint32) << 16).view(np.float32)
+    if tag == "F8_E4M3":
+        return arr.view(ml_dtypes.float8_e4m3fn)
+    return arr
+
+
+def e8m0_to_float(codes: np.ndarray) -> np.ndarray:
+    return np.ldexp(np.float32(1.0), codes.astype(np.int32) - 127).astype(np.float32)
+
+
+def dequant_fp8_block(weight: np.ndarray, scale_codes: np.ndarray, block=32) -> np.ndarray:
+    """E4M3 `[out, in]` with one E8M0 scale per `block x block` tile. The last tile in either
+    axis may be partial."""
+    out, inn = weight.shape
+    s = e8m0_to_float(scale_codes)
+    if s.shape != (-(-out // block), -(-inn // block)):
+        raise ValueError(f"scale {s.shape} doesn't tile weight {weight.shape} at {block}")
+    s = np.repeat(np.repeat(s, block, 0), block, 1)[:out, :inn]
+    return weight.astype(np.float32) * s
+
+
+def dequant_fp4(packed: np.ndarray, scale_codes: np.ndarray, block=32) -> np.ndarray:
+    """Packed E2M1 `[out, in/2]`, even element in the low nibble, one E8M0 scale per `block`
+    inputs."""
+    p = packed.view(np.uint8)
+    codes = np.stack([p & 0x0F, p >> 4], -1).reshape(p.shape[0], -1)
+    vals = E2M1_VALUES[codes]
+    s = e8m0_to_float(scale_codes)
+    if s.shape != (codes.shape[0], codes.shape[1] // block):
+        raise ValueError(f"scale {s.shape} doesn't cover {codes.shape} at {block}")
+    return (vals.reshape(codes.shape[0], -1, block) * s[..., None]).reshape(codes.shape)
+
+
+# Checkpoint key families this text-only model reads nothing from.
+SKIPPED_PREFIXES = ("mtp.", "vision.", "aligner.", "image_start", "image_end", "image_newline")
+SKIPPED_SUFFIXES = (".ffn.gate.bias_vl",)
+
+
+def _is_skipped(name):
+    return name.startswith(SKIPPED_PREFIXES) or name.endswith(SKIPPED_SUFFIXES)
+
+
+def load_checkpoint(model: DeepseekV41ForCausalLM, path: str) -> dict:
+    """Read every backbone tensor, widen FP8 and FP4 to the parameter dtype, keep the Engram
+    table in FP8, and place each on its parameter's sharding. Returns the key -> parameter map
+    it used. Raises on a checkpoint key it neither reads nor skips, and on a parameter nothing
+    wrote."""
+    index = scan_safetensors(path)
+    index_st = index
+    used, written = {}, set()
+
+    def get(name):
+        if name not in index:
+            raise KeyError(f"checkpoint has no {name}")
+        used[name] = True
+        return read_tensor(index[name])
+
+    def dense(name):
+        """[out, in] float32 of a linear, dequantized when it ships FP8."""
+        w = get(name + ".weight")
+        if index[name + ".weight"][1] == "F8_E4M3":
+            return dequant_fp8_block(w, get(name + ".scale"))
+        return w.astype(np.float32)
+
+    def put(param, value, label, mesh=None, shape=None):
+        """Place a value on the parameter's partition spec over a concrete mesh. The engine's
+        loader builds the model under `nnx.eval_shape`, where a parameter's sharding names an
+        abstract mesh that can't place anything.
+
+        `value` is an array, or a function of one device's index (a tuple of slices) that returns
+        that device's block. The function form lets each host build only the blocks its own
+        devices hold: its experts, its rows of an Engram table."""
+        v = param.value
+        want = tuple(v.shape)
+        spec = getattr(getattr(v, "sharding", None), "spec", None) or P()
+        sharding = NamedSharding(mesh if mesh is not None else model.mesh, spec)
+        if callable(value):
+            if tuple(shape) != want:
+                raise ValueError(f"{label}: checkpoint gives {tuple(shape)}, parameter is {want}")
+
+            def block(index):
+                out = np.asarray(value(index))
+                return out.astype(v.dtype) if out.dtype != v.dtype else out
+
+            param.value = jax.make_array_from_callback(want, sharding, block)
+        else:
+            arr = np.asarray(value)
+            if tuple(arr.shape) != want:
+                raise ValueError(f"{label}: checkpoint gives {arr.shape}, parameter is {want}")
+            param.value = jax.device_put(arr.astype(v.dtype) if arr.dtype != v.dtype else arr, sharding)
+        written.add(id(param))
+
+    def rows_block(name, rows, padded, fill):
+        """A padded row-sharded table read one device's rows at a time from the memory map."""
+        arr = get(name)
+
+        def block(index):
+            r = index[0]
+            lo, hi = r.start or 0, padded if r.stop is None else r.stop
+            out = np.full((hi - lo, *arr.shape[1:]), fill, dtype=arr.dtype)
+            take = max(0, min(hi, rows) - lo)
+            if take:
+                out[:take] = arr[lo : lo + take]
+            return out[(slice(None), *index[1:])]
+
+        return block, (padded, *arr.shape[1:])
+
+    def expert_block(fp, w, n_exp, transpose_shape):
+        """One device's slice of an `[experts, in, out]` stack, dequantizing only its experts."""
+
+        def block(index):
+            e = index[0]
+            lo, hi = e.start or 0, n_exp if e.stop is None else e.stop
+            mats = []
+            for i in range(lo, hi):
+                key = f"{fp}experts.{i}.{w}"
+                if index_st[key + ".weight"][1] == "I8":
+                    mats.append(dequant_fp4(get(key + ".weight"), get(key + ".scale")).T)
+                else:
+                    mats.append(dense(key).T)
+            return np.stack(mats)[(slice(None), *index[1:])]
+
+        return block, (n_exp, *transpose_shape)
+
+    m = model.model
+    put(m.embed.embedding, get("embed.weight"), "embed")
+    put(model.lm_head.embedding, get("head.weight"), "head")
+    put(m.norm, get("norm.weight"), "norm")
+    cfg = model.config
+    for i, layer in enumerate(m.layers):
+        pre = f"layers.{i}."
+        put(layer.attn_norm, get(pre + "attn_norm.weight"), pre + "attn_norm")
+        put(layer.ffn_norm, get(pre + "ffn_norm.weight"), pre + "ffn_norm")
+        for part in ("attn", "ffn"):
+            for kind in ("fn", "base", "scale"):
+                put(getattr(layer, f"hc_{part}_{kind}"), get(f"{pre}hc_{part}_{kind}"), pre + f"hc_{part}_{kind}")
+        a = layer.attn
+        ap = pre + "attn."
+        put(a.attn_sink, get(ap + "attn_sink"), ap + "attn_sink")
+        put(a.wq_a, dense(ap + "wq_a").T, ap + "wq_a")
+        put(a.q_norm, get(ap + "q_norm.weight"), ap + "q_norm")
+        put(a.wq_b, dense(ap + "wq_b").T, ap + "wq_b")
+        put(a.wkv, dense(ap + "wkv").T, ap + "wkv")
+        put(a.kv_norm, get(ap + "kv_norm.weight"), ap + "kv_norm")
+        put(a.wo_a, dense(ap + "wo_a").reshape(a.wo_a.value.shape), ap + "wo_a")
+        put(a.wo_b, dense(ap + "wo_b").T, ap + "wo_b")
+        if a.compressor is not None:
+            cp = ap + "compressor."
+            put(a.compressor.wkv, dense(cp + "wkv").T, cp + "wkv")
+            if a.role.ratio > 1:
+                put(a.compressor.wgate, dense(cp + "wgate").T, cp + "wgate")
+            put(a.compressor.norm, get(cp + "norm.weight"), cp + "norm")
+        if a.indexer is not None:
+            ip = ap + "indexer."
+            put(a.indexer.wq_b, dense(ip + "wq_b").T, ip + "wq_b")
+            put(a.indexer.weights_proj, dense(ip + "weights_proj").T, ip + "weights_proj")
+            if a.indexer.owns_k:
+                put(a.indexer.wk, dense(ip + "wk").T, ip + "wk")
+                put(a.indexer.k_norm, get(ip + "k_norm.weight"), ip + "k_norm")
+        f = layer.ffn
+        fp = pre + "ffn."
+        put(f.gate_weight, get(fp + "gate.weight"), fp + "gate.weight")
+        put(f.gate_bias, get(fp + "gate.bias"), fp + "gate.bias")
+        put(f.shared_w1, dense(fp + "shared_experts.w1").T, fp + "shared_experts.w1")
+        put(f.shared_w3, dense(fp + "shared_experts.w3").T, fp + "shared_experts.w3")
+        put(f.shared_w2, dense(fp + "shared_experts.w2").T, fp + "shared_experts.w2")
+        n_exp = int(cfg.n_routed_experts)
+        emesh = f.experts.moe_mesh
+        dim, inter = int(cfg.dim), int(cfg.moe_inter_dim)
+        for w, target, tshape in (("w1", f.experts.wi_0, (dim, inter)), ("w3", f.experts.wi_1, (dim, inter)),
+                                  ("w2", f.experts.wo, (inter, dim))):
+            for e in range(n_exp):  # every expert's tensors count as read, whichever host reads them
+                used[f"{fp}experts.{e}.{w}.weight"] = True
+                if f"{fp}experts.{e}.{w}.scale" in index:
+                    used[f"{fp}experts.{e}.{w}.scale"] = True
+            block, shape = expert_block(fp, w, n_exp, tshape)
+            put(target, block, fp + f"experts.{w}", emesh, shape=shape)
+        if layer.engram is not None:
+            ep = pre + "engram."
+            g = layer.engram
+            if index[ep + "embed.weight"][1] != "F8_E4M3":
+                raise ValueError(f"{ep}embed.weight ships {index[ep + 'embed.weight'][1]}, not F8_E4M3")
+            if index[ep + "embed.weight"][2][0] != g.rows:
+                raise ValueError(f"{ep}embed.weight holds {index[ep + 'embed.weight'][2][0]} rows, "
+                                 f"the config {g.rows}")
+            # padding rows: zero values, and scale code 127 (a factor of 1), as convert.py pads
+            block, shape = rows_block(ep + "embed.weight", g.rows, g.padded_rows, 0)
+            put(g.table, block, ep + "embed.weight", shape=shape)
+            block, shape = rows_block(ep + "embed.scale", g.rows, g.padded_rows, 127)
+            put(g.table_scale, block, ep + "embed.scale", shape=shape)
+            put(g.wkv, dense(ep + "wkv").T, ep + "wkv")
+            put(g.q_weight, get(ep + "q_weight"), ep + "q_weight")
+            put(g.k_weight, get(ep + "k_weight"), ep + "k_weight")
+
+    unread = sorted(k for k in index if k not in used and not _is_skipped(k))
+    if unread:
+        raise ValueError(f"{len(unread)} checkpoint tensors have no parameter, first: {unread[:5]}")
+    missing = [
+        path for path, var in nnx.iter_graph(model)
+        if isinstance(var, nnx.Param) and id(var) not in written
+    ]
+    if missing:
+        raise ValueError(f"{len(missing)} parameters got no checkpoint tensor, first: {missing[:5]}")
+    logger.info("DeepSeek V4.1 loaded %d tensors from %s", len(used), path)
+    return used
+
+
+EntryClass = [DeepseekV41ForCausalLM]
