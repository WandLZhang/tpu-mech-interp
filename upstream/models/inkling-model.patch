+    running_sum = jnp.sum(acc, axis=-1)
+    running_max = running_sum + neg
+    _, running_sum, acc = jax.lax.fori_loop(0, num_blocks, step, (running_max, running_sum, acc))
+    safe_sum = jnp.where(running_sum > 0, running_sum, 1.0)
+    out = jnp.where(running_sum[..., None] > 0, acc / safe_sum[..., None], 0.0)
+    return out.astype(v_cache.dtype).reshape(num_tokens, num_heads * v_cache.shape[-1])
+
