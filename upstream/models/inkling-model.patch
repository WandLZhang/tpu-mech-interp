diff --git a/python/sgl_jax/srt/mem_cache/short_conv_state_pool.py b/python/sgl_jax/srt/mem_cache/short_conv_state_pool.py
new file mode 100644
index 00000000..8ca668b6
--- /dev/null
+++ b/python/sgl_jax/srt/mem_cache/short_conv_state_pool.py
@@ -0,0 +1,225 @@
+"""Per-request windows of a model's short causal convolutions.
+
+A short convolution with kernel K reads the K - 1 tokens before its input, so a
+sequence that continues across prefill chunks or decode steps needs the window
+its previous step left. `ShortConvStatePool` keeps one slot of windows per
+request. It takes its slots from `HybridReqToTokenPool`, so the scheduler's
+`recurrent_indices` address it the way they address a `RecurrentStatePool`.
+
+The model reports what it holds through `get_conv_state_spec()`, one
+`(name, channels, tokens)` list per layer. Each layer's windows live in a dict
+keyed by name, each one `[slots, channels, tokens]`. The channel axis shards
+over `tensor` when it splits evenly, because a depthwise convolution never mixes
+channels. Each data-parallel rank owns `size // dp_size` slots plus a dummy slot
+0, the layout `RecurrentStatePool` uses.
+"""
+
+from __future__ import annotations
+
+import jax
+import jax.numpy as jnp
+from jax.sharding import Mesh, NamedSharding
+from jax.sharding import PartitionSpec as P
+from jax.tree_util import register_pytree_node_class
+
+from sgl_jax.srt.mem_cache.recurrent_state_pool import _get_recurrent_zero_allocator
+
+ConvStateSpec = list[list[tuple[str, int, int]]]
+
+# The name the runner gives the pool inside `MemoryPools`.
+CONV_STATE_POOL_KEY = "conv_state_pool"
+
+
+def conv_state_serving_problems(server_args) -> list[str]:
+    """The flags a per-request window pool can't serve correctly, one line each.
+
+    A model that keeps windows checks them from its `check_server_args`, which
+    `ModelWorker` calls before it reads any weight. The runner checks them again
+    when it builds the pool.
+    """
+    problems = []
+    if not server_args.disable_radix_cache:
+        problems.append(
+            "the radix cache would hand a request another request's prefix with no "
+            "windows at its end; serve with --disable-radix-cache"
+        )
+    if server_args.speculative_algorithm is not None:
+        problems.append("speculative decoding would leave rejected draft tokens in the windows")
+    if server_args.enable_recurrent_extra_buffer:
+        problems.append("--enable-recurrent-extra-buffer snapshots recurrent state only")
+    # PD hands a request's KV to the decode side and leaves its windows behind, so
+    # every decode step would convolve over zeros.
+    if server_args.pd_disaggregation:
+        problems.append("--pd-disaggregation moves a request's KV to decode but not its windows")
+    if server_args.disaggregation_mode != "null":
+        problems.append(
+            f"--disaggregation-mode {server_args.disaggregation_mode} moves a request's KV "
+            "between servers but not its windows"
+        )
+    return problems
+
+
+def window_channel_axis(channels: int, mesh: Mesh) -> str | None:
+    """`tensor` when the channels split evenly over it, None when they don't."""
+    tensor = mesh.shape.get("tensor", 1)
+    return "tensor" if tensor > 1 and channels % tensor == 0 else None
+
+
+def window_spec(channels: int, mesh: Mesh) -> P:
+    """Sharding of one window buffer: slots over `data`, channels over `tensor`."""
+    return P("data", window_channel_axis(channels, mesh), None)
+
+
+def read_windows(buffer: jax.Array, indices: jax.Array, mesh: Mesh) -> jax.Array:
+    """The windows of the requests at `indices`, `[batch, channels, tokens]`.
+
+    `indices` are rank-local slots, so each data shard gathers from its own
+    slots.
+    """
+    spec = window_spec(buffer.shape[1], mesh)
+    return jax.shard_map(
+        lambda buf, idx: buf[idx],
+        mesh=mesh,
+        in_specs=(spec, P("data")),
+        out_specs=spec,
+        check_vma=False,
+    )(buffer, indices)
+
+
+def write_windows(
+    buffer: jax.Array, indices: jax.Array, windows: jax.Array, mesh: Mesh
+) -> jax.Array:
+    """`buffer` with each request's slot set to its new window.
+
+    Padding rows carry slot 0, the dummy slot. They write back what the slot
+    already holds, so it stays at zeros and never reaches a real request.
+    """
+    spec = window_spec(buffer.shape[1], mesh)
+
+    def scatter(buf, idx, val):
+        keep = (idx == 0).reshape(-1, 1, 1)
+        return buf.at[idx].set(jnp.where(keep, buf[idx], val.astype(buf.dtype)))
+
+    return jax.shard_map(
+        scatter,
+        mesh=mesh,
+        in_specs=(spec, P("data"), spec),
+        out_specs=spec,
+        check_vma=False,
+    )(buffer, indices, windows)
+
+
+def _zeros(shape: tuple[int, ...], dtype, sharding: NamedSharding) -> jax.Array:
+    """Zeros placed at `sharding`, from the allocator cache `RecurrentStatePool` keeps.
+
+    The cache holds one jit per shape, dtype and sharding. Inkling's 66 layers hold
+    264 windows in 3 shapes, so a fresh jit per window compiled 264 programs at
+    every create and every flush.
+    """
+    return _get_recurrent_zero_allocator(shape, dtype, sharding)()
+
+
+@register_pytree_node_class
+class ShortConvStatePool:
+    """One slot of short-convolution windows per request.
+
+    `size` counts the valid slots across every data-parallel rank, the way
+    `RecurrentStatePool.size` does.
+    """
+
+    def __init__(
+        self,
+        spec: ConvStateSpec,
+        size: int,
+        mesh: Mesh,
+        dp_size: int = 1,
+        dtype=jnp.float32,
+        *,
+        abstract: bool = False,
+    ):
+        if size % dp_size:
+            raise ValueError(f"ShortConvStatePool size {size} must divide by dp_size {dp_size}")
+        self.spec = tuple(
+            tuple((str(name), int(channels), int(tokens)) for name, channels, tokens in layer)
+            for layer in spec
+        )
+        self.size = size
+        self.dp_size = dp_size
+        self.total_slots = size + dp_size
+        self.mesh = mesh
+        self.dtype = jnp.dtype(dtype)
+        self.buffers = self._create_buffers(abstract)
+
+    def sharding(self, channels: int) -> NamedSharding:
+        return NamedSharding(self.mesh, window_spec(channels, self.mesh))
+
+    def _create_buffers(self, abstract: bool) -> list[dict[str, jax.Array]]:
+        layers = []
+        for layer in self.spec:
+            windows = {}
+            for name, channels, tokens in layer:
+                shape = (self.total_slots, channels, tokens)
+                sharding = self.sharding(channels)
+                if abstract:
+                    windows[name] = jax.ShapeDtypeStruct(shape, self.dtype, sharding=sharding)
+                else:
+                    windows[name] = _zeros(shape, self.dtype, sharding)
+            layers.append(windows)
+        return layers
+
+    def layer(self, layer_id: int) -> dict[str, jax.Array]:
+        return self.buffers[layer_id]
+
+    def replace_buffer(self, layers: list[dict[str, jax.Array]]) -> None:
+        if len(layers) != len(self.spec):
+            raise ValueError(
+                f"ShortConvStatePool holds {len(self.spec)} layers, and the update has "
+                f"{len(layers)}"
+            )
+        # A one-way tensor axis loses the output sharding after jit, the case
+        # MHATokenToKVPool.replace_buffer notes, so put each window back.
+        tp_degenerate = self.mesh.shape.get("tensor", 1) == 1
+        updated = []
+        for layer, layer_spec in zip(layers, self.spec):
+            names = sorted(name for name, _, _ in layer_spec)
+            if sorted(layer) != names:
+                raise ValueError(
+                    f"a layer update carries windows {sorted(layer)}, and the pool holds {names}"
+                )
+            windows = {}
+            for name, channels, _ in layer_spec:
+                array = layer[name]
+                if tp_degenerate:
+                    array = jax.device_put(array, self.sharding(channels))
+                windows[name] = array
+            updated.append(windows)
+        self.buffers = updated
+
+    def clear(self) -> None:
+        self.buffers = self._create_buffers(abstract=False)
+
+    @staticmethod
+    def bytes_per_device(
+        spec: ConvStateSpec, size: int, mesh: Mesh, dp_size: int = 1, dtype=jnp.float32
+    ) -> int:
+        """HBM one device spends on the pool."""
+        slots = (size + dp_size) // dp_size
+        tensor = mesh.shape.get("tensor", 1)
+        itemsize = jnp.dtype(dtype).itemsize
+        total = 0
+        for layer in spec:
+            for _, channels, tokens in layer:
+                local = channels // tensor if window_channel_axis(channels, mesh) else channels
+                total += slots * local * tokens * itemsize
+        return total
+
+    def tree_flatten(self):
+        return (self.buffers,), (self.spec, self.size, self.dp_size, self.mesh, self.dtype)
+
+    @classmethod
+    def tree_unflatten(cls, aux_data, children):
+        obj = object.__new__(cls)
+        obj.spec, obj.size, obj.dp_size, obj.mesh, obj.dtype = aux_data
+        obj.total_slots = obj.size + obj.dp_size
+        obj.buffers = [dict(layer) for layer in children[0]]
+        return obj
