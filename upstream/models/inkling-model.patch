@@ -0,0 +1,41 @@
+"""Serving config for `thinkingmachines/Inkling` and `Inkling-Small`.
+
+The published `config.json` writes two MLP widths into its `text_config`.
+`intermediate_size` is the width of one routed expert and
+`dense_intermediate_size` is the width of the dense MLP the layers below
+`dense_mlp_idx` run. The stock `InklingTextConfig.__post_init__` moves the
+dense width onto `intermediate_size` and leaves `moe_intermediate_size` at its
+class default of 3072, so the published expert width is gone by the time the
+model reads it. That default happens to be right for Inkling and wrong for
+Inkling-Small, whose experts are 2048 wide.
+
+`InklingServingConfig` reads the expert width off the raw text block before the
+base class rewrites the field.
+"""
+
+from __future__ import annotations
+
+from huggingface_hub.dataclasses import strict
+from transformers.models.inkling import InklingConfig as HFInklingConfig
+
+
+@strict
+class InklingServingConfig(HFInklingConfig):
+    """`InklingConfig` that keeps the published expert width."""
+
+    model_type = "inkling_mm_model"
+
+    def __post_init__(self, **kwargs):
+        text = self.text_config
+        # A checkpoint that carries `dense_intermediate_size` writes the expert
+        # width as `intermediate_size`. One that carries only
+        # `intermediate_size` means the dense width, which is what the base
+        # class already reads.
+        if isinstance(text, dict) and text.get("dense_intermediate_size") is not None:
+            expert_width = text.get("intermediate_size")
+            if expert_width is not None:
+                text.setdefault("moe_intermediate_size", expert_width)
+        super().__post_init__(**kwargs)
+
+
+__all__ = ["InklingServingConfig"]
