 from jax.sharding import PartitionSpec as P
 
 from sgl_jax.srt.layers import moe as _moe
+from sgl_jax.srt.layers import moe_probe
 from sgl_jax.srt.layers.embeddings import Embed, ParallelLMHead
 from sgl_jax.srt.layers.logits_processor import LogitsMetadata, LogitsProcessor
 from sgl_jax.srt.layers.moe import EPMoE
@@ -358,6 +359,32 @@ class Glm5NextEPMoE(EPMoE):
         return _moe.gmm(lhs=act, rhs=wo_kernel, rhs_scale=wo_kernel_scale, rhs_bias=wo_kernel_bias,
                         zero_initialize=True, **kwargs)
 
+    def _forward(self, *args, scatter_on_tensor=False):
+        # SGL_PROBE_MOE=dense (layers/moe_probe.py) swaps the dispatch, gmm and unpermute out.
+        if moe_probe.probe("MOE") != "dense":
+            return super()._forward(*args, scatter_on_tensor=scatter_on_tensor)
+        return self._probe_dense_forward(*args, scatter_on_tensor=scatter_on_tensor)
+
+    def _probe_dense_forward(self, hidden_states, topk_weights, topk_ids, w0, w1, wo,
+                             w0_scale=None, w1_scale=None, wo_scale=None, *biases,
+                             scatter_on_tensor=False):
+        """Every local expert over every token in float32 at HIGHEST with the clamped SwiGLU,
+        weighted by float32 top-k weights, then `EPMoE._forward`'s reduce, in float32."""
+        if any(s is not None for s in (w0_scale, w1_scale, wo_scale)):
+            raise ValueError("SGL_PROBE_MOE runs unquantized experts only")
+        first = (jnp.array(0, jnp.int32) if self.replicate_experts
+                 else jax.lax.axis_index("expert") * self.experts_per_device)
+        output = moe_probe.dense_experts(hidden_states, topk_weights, topk_ids, w0, w1, wo, first,
+                                         lambda h0, h1: swiglu(h0, h1, self.swiglu_limit))
+        if self.tp_size > 1:
+            if scatter_on_tensor:
+                output = jax.lax.psum_scatter(output, "tensor", scatter_dimension=0, tiled=True)
+            else:
+                output = jax.lax.psum(output, "tensor")
+        if self.ep_size > 1:
+            output = self._combine(output)
+        return output.astype(self.dtype)
+
 
 class Glm5NextMoE(nnx.Module):
     """`Glm5NextTextMoE`: sigmoid routing with a selection-only bias, normalized top-k weights
@@ -395,7 +422,10 @@ class Glm5NextMoE(nnx.Module):
 
     def __call__(self, x):
         weights, idx = self.route(x)
-        routed = self.experts(x, weights.astype(x.dtype), idx.astype(jnp.int32))
+        # SGL_PROBE_MOE=dense keeps the top-k weights float32 into the experts.
+        if moe_probe.probe("MOE") != "dense":
+            weights = weights.astype(x.dtype)
+        routed = self.experts(x, weights, idx.astype(jnp.int32))
         return (routed.astype(jnp.float32) + self.shared(x).astype(jnp.float32)).astype(x.dtype)
 
 
@@ -868,6 +898,8 @@ class Glm5NextForConditionalGeneration(nnx.Module):
         self.config = config
