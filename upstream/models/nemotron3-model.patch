diff --git a/python/sgl_jax/srt/layers/attention/mamba/mamba2.py b/python/sgl_jax/srt/layers/attention/mamba/mamba2.py
new file mode 100644
index 00000000..b4f4462b
--- /dev/null
+++ b/python/sgl_jax/srt/layers/attention/mamba/mamba2.py
@@ -0,0 +1,305 @@
+"""Chunked Mamba-2 selective scan, folded into one affine step per chunk.
+
+The Mamba-2 SSD recurrence is affine in the state. Per token, per head:
+
+    h_t = exp(dt_t * A_h) * h_{t-1} + B_t (dt_t x_t)^T
+
+`A_h` is one negative scalar per head, so the decay is a scalar. Fold a chunk
+of L tokens and the affine map falls out:
+
+    g_t     = dt_t * A_h                     log decay of one token
+    cum_t   = sum_{s <= t} g_s               running sum inside the chunk
+    A_chunk = exp(cum_{L-1})                 one scalar
+    B_chunk = sum_t exp(cum_{L-1} - cum_t) B_t (dt_t x_t)^T
+
+`exp(cum_{L-1} - cum_t)` is the decay that still applies to token `t` by the
+end of the chunk. The sum runs over `t` with no dependence between terms, so a
+chunk is one einsum. Only the chunk-to-chunk step is sequential, and
+`mamba2_backend.replay_scalar` runs that step.
+
+The state is `[..., K, V]` here, with heads leading, `K` = `ssm_state_size`
+and `V` = `mamba_head_dim`. Chunked arrays put the chunk axis first. The
+reference cache stores the same numbers as `[heads, mamba_head_dim,
+ssm_state_size]`, so it's the transpose; `as_cache_layout` and
+`from_cache_layout` convert.
+
+`chunk_outputs` turns the chunk boundary states into the per-token layer
+output. It adds the `C` projection against the state each chunk inherits, the
+causal intra-chunk block, and the `D` skip. `y_t` is what the gated norm and
+the output projection consume.
+
+`mamba_ssm_cache_dtype` is float32 even though the weights ship in BF16, so
+every function here that does arithmetic upcasts its inputs and returns
+float32. `state_dtype` overrides that, which is how a test measures what BF16
+accumulation costs. The two functions that only move data, `as_cache_layout`
+and `from_cache_layout`, pass the dtype through.
+
+Every matmul and einsum here asks for `Precision.HIGHEST`. A float32
+`dot_general` at the default precision rounds both operands to BF16 before the
+MXU multiplies them, which hands back the accuracy the float32 cache dtype
+pays for. CPU always runs true float32, so a CPU test can't see the difference.
+A test reads the jaxpr instead and fails on any `dot_general` that leaves the
+precision open.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import math
+
+import jax
+import jax.numpy as jnp
+from jax import lax
+
+__all__ = [
+    "Mamba2Config",
+    "PRECISION",
+    "STATE_DTYPE",
+    "as_cache_layout",
+    "chunk_outputs",
+    "chunk_terms",
+    "discretize",
+    "entering_states",
+    "from_cache_layout",
+]
+
+# `mamba_ssm_cache_dtype`. The state stays float32 in a BF16 model.
+STATE_DTYPE = jnp.float32
+
+# Keep float32 contractions in float32 on the MXU. See the module docstring.
+PRECISION = lax.Precision.HIGHEST
+
+
+@dataclasses.dataclass(frozen=True)
+class Mamba2Config:
+    """The fields of a Mamba-2 layer config that the chunked scan reads.
+
+    `time_step_limit` is the `(low, high)` clamp applied to `dt` after the
+    softplus. `config.json` calls the field `mamba_dt_limit`, and both
+    published Nemotron 3 checkpoints leave it at the `(0.0, inf)` default, the
+    pair Megatron-LM trains with.
+    """
+
+    ssm_state_size: int
+    mamba_num_heads: int
+    mamba_head_dim: int
+    n_groups: int
+    conv_kernel: int
+    chunk_size: int
+    time_step_limit: tuple[float, float] = (0.0, math.inf)
+
+    @property
+    def heads_per_group(self) -> int:
+        """Heads that share one `B` row. `B` is projected per group."""
+        return self.mamba_num_heads // self.n_groups
+
+    @property
+    def conv_dim(self) -> int:
+        """Channels the depthwise conv runs over.
+
+        The input projection hands the conv three concatenated pieces: the SSM
+        input at `mamba_num_heads * mamba_head_dim` channels, then `B` and `C`
+        at `n_groups * ssm_state_size` each.
+        """
+        return (
+            self.mamba_num_heads * self.mamba_head_dim
+            + 2 * self.n_groups * self.ssm_state_size
+        )
+
+
+def discretize(
+    dt_raw: jnp.ndarray,
+    dt_bias: jnp.ndarray,
+    a_log: jnp.ndarray,
+    time_step_limit: tuple[float, float] = (0.0, math.inf),
+) -> tuple[jnp.ndarray, jnp.ndarray]:
+    """Turn the raw `dt` projection and `A_log` into a step and a log decay.
+
+    Follows the Mamba-2 CUDA kernels: add the bias, softplus, clamp to
+    `time_step_limit`, then multiply by `A = -exp(A_log)`. Both ends of the
+    clamp apply, so a config with a finite upper limit gets it.
+
+    Args:
+      dt_raw: [T, H] the `dt` slice of the input projection.
+      dt_bias: [H]
+      a_log: [H] the stored log of `-A`.
+      time_step_limit: `(low, high)` clamp applied after the softplus, read
+        from `mamba_dt_limit` in `config.json`.
+
+    Returns:
+      dt: [T, H] float32 time step.
+      log_decay: [T, H] float32 `dt * A`, which is at most zero.
+    """
+    low, high = time_step_limit
+    dt = jax.nn.softplus(dt_raw.astype(STATE_DTYPE) + dt_bias.astype(STATE_DTYPE))
+    dt = jnp.clip(dt, low, high)
+    a = -jnp.exp(a_log.astype(STATE_DTYPE))
+    return dt, dt * a
+
+
+def _to_heads(b: jnp.ndarray, num_heads: int) -> jnp.ndarray:
+    """Expand a per-group `B` to per-head. [T, G, N] -> [T, H, N].
+
+    Head `h` reads group `h // heads_per_group`, so the repeat is contiguous.
+    """
+    groups = b.shape[-2]
+    if num_heads % groups:
+        raise ValueError(f"{num_heads} heads don't divide into {groups} groups")
+    return jnp.repeat(b, num_heads // groups, axis=-2)
+
+
+def chunk_terms(
+    x: jnp.ndarray,
+    b: jnp.ndarray,
+    dt: jnp.ndarray,
+    log_decay: jnp.ndarray,
+    chunk_size: int,
+    state_dtype: jnp.dtype = STATE_DTYPE,
+) -> tuple[jnp.ndarray, jnp.ndarray]:
+    """Fold each chunk into a log decay and a state increment.
+
+    Args:
+      x: [T, H, P] the SSM input, before the `dt` scaling.
+      b: [T, G, N] per group.
+      dt: [T, H]
+      log_decay: [T, H] `dt * A` from `discretize`.
+      chunk_size: `chunk_size` from the model config.
+      state_dtype: accumulation dtype.
+
+    Returns:
+      log_total: [C, H] the summed log decay of each chunk. `A_chunk` is
+        `exp(log_total)` times the identity.
+      b_chunks: [C, H, N, P] the state each chunk adds on its own.
+    """
+    tokens, heads, head_dim = x.shape
+    state_size = b.shape[-1]
+    if tokens % chunk_size:
+        raise ValueError(f"{tokens} tokens don't divide into chunks of {chunk_size}")
+    chunks = tokens // chunk_size
+
+    xd = x.astype(state_dtype) * dt.astype(state_dtype)[..., None]
+    xd = xd.reshape(chunks, chunk_size, heads, head_dim)
+    bh = _to_heads(b.astype(state_dtype), heads)
+    bh = bh.reshape(chunks, chunk_size, heads, state_size)
+
+    g = log_decay.astype(state_dtype).reshape(chunks, chunk_size, heads)
+    cum = jnp.cumsum(g, axis=1)
+    log_total = cum[:, -1, :]
+    # Decay still owed to token t when the chunk ends. The largest exponent is
+    # zero, at the last token, so this can't overflow.
+    decay = jnp.exp(log_total[:, None, :] - cum)
+
+    b_chunks = jnp.einsum(
+        "clhn,clhp->chnp", bh * decay[..., None], xd, precision=PRECISION
+    )
+    return log_total, b_chunks
+
+
+def entering_states(states: jnp.ndarray, h_in: jnp.ndarray) -> jnp.ndarray:
+    """Shift chunk boundary states so index `c` is the state entering chunk c.
+
+    `replay_scalar` returns the state after each chunk. `chunk_outputs` wants
+    the state before each chunk, which is the same list shifted right with the
+    incoming state in front.
+
+    Args:
+      states: [C, H, N, P] state after each chunk.
+      h_in: [H, N, P] state entering the first chunk.
+
+    Returns:
+      [C, H, N, P]
+
+    Concatenate first and drop the last row after: a slice of the tail would
+    drop the state the first chunk needs.
+    """
+    return jnp.concatenate([h_in[None].astype(states.dtype), states], axis=0)[:-1]
+
+
+def chunk_outputs(
+    x: jnp.ndarray,
+    b: jnp.ndarray,
+    c: jnp.ndarray,
+    dt: jnp.ndarray,
+    log_decay: jnp.ndarray,
+    h_entering: jnp.ndarray,
+    chunk_size: int,
+    d: jnp.ndarray | None = None,
+    state_dtype: jnp.dtype = STATE_DTYPE,
+) -> jnp.ndarray:
+    """Per-token layer output from each chunk's incoming state.
+
+    The scan carries the state from chunk to chunk. This turns that state into
+    `y_t`, the thing the gated norm and the output projection read. Three terms
+    add up, and the first two are the off-diagonal and diagonal blocks of the
+    SSD form:
+
+        y_t = C_t . h_t + D_h x_t
+            = exp(cum_t) C_t . h_in
+              + sum_{s <= t} exp(cum_t - cum_s) (C_t . B_s) dt_s x_s
+              + D_h x_t
+
+    `h_in` is the state entering the chunk that holds token `t`, so a chunk
+    needs nothing from the chunks around it beyond that one state. Inside a
+    chunk the sum over `s` is one masked einsum.
+
+    Args:
+      x: [T, H, P] the SSM input, before the `dt` scaling. `D` skips this, and
+        the second term scales it by `dt`.
+      b: [T, G, N] per group.
+      c: [T, G, N] per group, the same projection layout as `b`.
+      dt: [T, H]
+      log_decay: [T, H] `dt * A` from `discretize`.
+      h_entering: [C, H, N, P] state entering each chunk, from
+        `entering_states`.
+      chunk_size: `chunk_size` from the model config.
+      d: [H] the skip weight. `None` drops the skip.
+      state_dtype: accumulation dtype.
+
+    Returns:
+      [T, H, P] the mixer output before the gated norm.
+    """
+    tokens, heads, head_dim = x.shape
+    state_size = b.shape[-1]
+    if tokens % chunk_size:
+        raise ValueError(f"{tokens} tokens don't divide into chunks of {chunk_size}")
+    chunks = tokens // chunk_size
+
+    xd = x.astype(state_dtype) * dt.astype(state_dtype)[..., None]
+    xd = xd.reshape(chunks, chunk_size, heads, head_dim)
+    bh = _to_heads(b.astype(state_dtype), heads)
+    bh = bh.reshape(chunks, chunk_size, heads, state_size)
+    ch = _to_heads(c.astype(state_dtype), heads)
+    ch = ch.reshape(chunks, chunk_size, heads, state_size)
+
+    g = log_decay.astype(state_dtype).reshape(chunks, chunk_size, heads)
+    cum = jnp.cumsum(g, axis=1)
+
+    # Decay from source token s to target token t, zero where s is after t.
+    # Mask the exponent rather than the result, because cum_t - cum_s is
+    # positive above the diagonal and exp would overflow.
+    gap = cum[:, :, None, :] - cum[:, None, :, :]
+    causal = jnp.tril(jnp.ones((chunk_size, chunk_size), bool))[None, :, :, None]
+    decay = jnp.exp(jnp.where(causal, gap, -jnp.inf))
+
+    score = jnp.einsum("clhn,cshn->clsh", ch, bh, precision=PRECISION)
+    y = jnp.einsum("clsh,cshp->clhp", score * decay, xd, precision=PRECISION)
+
+    inherited = ch * jnp.exp(cum)[..., None]
+    y += jnp.einsum(
+        "clhn,chnp->clhp", inherited, h_entering.astype(state_dtype), precision=PRECISION
+    )
+
+    y = y.reshape(tokens, heads, head_dim)
+    if d is not None:
+        y += d.astype(state_dtype)[None, :, None] * x.astype(state_dtype)
+    return y
+
+
+def as_cache_layout(h: jnp.ndarray) -> jnp.ndarray:
+    """[..., N, P] -> [..., P, N], the layout the reference cache stores."""
+    return jnp.swapaxes(h, -1, -2)
+
+
+def from_cache_layout(h: jnp.ndarray) -> jnp.ndarray:
+    """[..., P, N] -> [..., N, P], the layout the affine scan wants."""
+    return jnp.swapaxes(h, -1, -2)
diff --git a/python/sgl_jax/srt/layers/attention/mamba/mamba2_backend.py b/python/sgl_jax/srt/layers/attention/mamba/mamba2_backend.py
new file mode 100644
index 00000000..e4c63ebd
--- /dev/null
+++ b/python/sgl_jax/srt/layers/attention/mamba/mamba2_backend.py
@@ -0,0 +1,583 @@
+"""Mamba-2 attention backend: packed prefill and single-token decode.
+
+The mixer in ``models/nemotron_h.py`` hands over the fused conv stream and the
+raw ``dt`` projection. This backend owns everything that touches the cache: the
+depthwise conv state, the SSM state, and the chunked scan between them.
+
+**Prefill.** The engine packs several requests into one flat token axis, so the
+chunk grid has to cut at every request start. ``chunk_grid`` builds that grid
+from ``cu_q_lens``: chunk ``c`` holds up to ``chunk_size`` tokens and they all
+belong to one request, so a request whose length isn't a multiple of
+``chunk_size`` closes on a partial chunk. Padding slots carry ``dt = 0``, so
+they add nothing to the chunk's state increment and multiply its decay by one.
+
+With that grid the recurrence is affine:
+
+    h_c = A_c h_{c-1} + B_c
+
+``mamba2.chunk_terms`` returns ``A_c`` as one scalar per chunk per head and
+``B_c`` as the increment. ``open_requests`` folds each request's cached state
+into its first ``B_c``, and ``replay_scalar`` selects that ``B_c`` alone at a
+request start, so one scan carries every request in the batch. The boundary is
+a select rather than a multiply by a zero decay, because ``0 * inf`` is NaN: a
+multiply would carry one request's non-finite state into every request after
+it.
+
+**Decode.** One token per request, so the recurrence is one step and no chunk
+grid is needed.
+
+**Track slots.** With ``--enable-recurrent-extra-buffer`` the scheduler hands
+the backend a track slot for every request that ends a forward on a track
+boundary, and the radix tree later adopts that slot as the state of the prefix.
+The scheduler cuts a forward so it ends on the boundary, which makes the state
+the forward leaves the snapshot, so it goes to the track slot as well as the
+running slot.
+
+The conv runs through ``short_convolution``, the same packed varlen conv the KDA
+and GDN backends use.
+
+Both state slots are float32, because ``mamba_ssm_cache_dtype`` is float32 while
+the weights ship BF16.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import jax
+import jax.numpy as jnp
+from jax import lax
+from jax.sharding import PartitionSpec as P
+
+from sgl_jax.srt.layers.attention.hybrid_linear_attn_backend import (
+    LinearRecurrentAttnBackend,
+)
+from sgl_jax.srt.layers.attention.linear.short_convolution import short_convolution
+from sgl_jax.srt.layers.attention.mamba.mamba2 import (
+    PRECISION,
+    STATE_DTYPE,
+    as_cache_layout,
+    chunk_outputs,
+    chunk_terms,
+    discretize,
+    entering_states,
+    from_cache_layout,
+)
+from sgl_jax.srt.model_executor.forward_batch_info import ForwardMode
+from sgl_jax.srt.utils.profiling_utils import named_scope
+
+if TYPE_CHECKING:
+    from sgl_jax.srt.model_executor.forward_batch_info import ForwardBatch
+
+__all__ = ["Mamba2AttnBackend", "chunk_grid", "open_requests", "replay_scalar"]
+
+
+def chunk_grid(cu_q_lens: jax.Array, num_tokens: int, chunk_size: int):
+    """Cut the packed token axis into chunks that never span two requests.
+
+    Args:
+      cu_q_lens: [B + 1] cumulative token counts, one entry per request plus a
+        leading zero. This is the metadata the hybrid recurrent path already
+        computes.
+      num_tokens: length of the packed token axis. Static.
+      chunk_size: `chunk_size` from the model config.
+
+    Returns:
+      token_index: [C, L] the token each grid slot reads. Out-of-range slots
+        clamp to a real index and are masked by `valid`.
+      valid: [C, L] bool. False on a padding slot.
+      request: [C] which request owns the chunk.
+      first: [C] bool. True on a request's first chunk, which is where the
+        cached state enters.
+      last_chunk: [B] the grid index each request closes on, so the final state
+        scatters back to the right cache slot.
+
+    The grid holds `num_tokens // chunk_size + B` chunks. Every request wastes
+    at most one partial chunk, so that bound is tight and static.
+    """
+    batch = cu_q_lens.shape[0] - 1
+    num_chunks = num_tokens // chunk_size + batch
+
+    starts = cu_q_lens[:-1]
+    ends = cu_q_lens[1:]
+    lengths = ends - starts
+    # Chunks each request needs, and where its first one lands in the grid.
+    per_request = (lengths + chunk_size - 1) // chunk_size
+    offsets = jnp.concatenate(
+        [jnp.zeros((1,), per_request.dtype), jnp.cumsum(per_request)[:-1]]
+    )
+
+    grid = jnp.arange(num_chunks, dtype=cu_q_lens.dtype)
+    # searchsorted on the exclusive prefix: chunk g belongs to the last request
+    # whose first chunk is at or before g. Requests with no chunks are skipped
+    # because their offset repeats the next one.
+    request = jnp.searchsorted(offsets + per_request, grid, side="right")
+    request = jnp.clip(request, 0, batch - 1)
+
+    within = grid - offsets[request]
+    chunk_start = starts[request] + within * chunk_size
+    token_index = chunk_start[:, None] + jnp.arange(chunk_size, dtype=cu_q_lens.dtype)[None, :]
+    valid = (token_index < ends[request][:, None]) & (within < per_request[request])[:, None]
+    token_index = jnp.clip(token_index, 0, max(num_tokens - 1, 0))
+
+    first = (within == 0) & (per_request[request] > 0)
+    last_chunk = jnp.clip(offsets + per_request - 1, 0, num_chunks - 1)
+    return token_index, valid, request, first, last_chunk
+
+
+def open_requests(
+    log_total: jax.Array, b_chunks: jax.Array, first: jax.Array, entering: jax.Array
+) -> jax.Array:
+    """Fold each request's cached state into its first chunk's increment.
+
+    One scan runs the whole packed batch. At a request's first chunk
+    `replay_scalar` drops the carry, which holds what the request before it
+    left, and restarts from `B_c`. So `B_c` there has to hold the request's own
+    cached state, decayed across the chunk, as well as what the chunk adds.
+
+    Args:
+      log_total: [C, H] summed log decay of each chunk.
+      b_chunks: [C, H, N, P] state each chunk adds on its own.
+      first: [C] bool. True on a request's first chunk.
+      entering: [C, H, N, P] the cached state of the request that owns each
+        chunk.
+
+    Returns:
+      [C, H, N, P] `b_chunks` with every first chunk rewritten.
+    """
+    decay = jnp.exp(log_total)[..., None, None]
+    return jnp.where(first[:, None, None, None], decay * entering + b_chunks, b_chunks)
+
+
+def replay_scalar(
+    log_total: jax.Array,
+    b_chunks: jax.Array,
+    h_in: jax.Array,
+    first: jax.Array | None = None,
+) -> jax.Array:
+    """Apply the chunk pairs in order, with a scalar decay per chunk.
+
+    `A_c` is a scalar times the identity, so the scan carries one number per
+    chunk per head where a dense `[K, K]` form would carry `K` squared: 16,384
+    times as many at `ssm_state_size=128`.
+
+    Args:
+      log_total: [C, H] summed log decay of each chunk. Zero means the chunk
+        keeps the state it inherits.
+      b_chunks: [C, H, N, P] state each chunk adds on its own.
+      h_in: [H, N, P] state entering the first chunk.
+      first: [C] bool, True on a request's first chunk, or None when every
+        chunk belongs to one sequence. The state there is `B_c` alone. It's a
+        select rather than a multiply by a zero decay: `0 * inf` is NaN, so a
+        multiply would carry one request's non-finite state into every request
+        after it.
+
+    Returns:
+      [C, H, N, P] state after each chunk.
+    """
+
+    @jax.checkpoint
+    def body(h, step):
+        decay, b, start = step
+        h_next = jnp.where(start, b, decay[:, None, None] * h + b)
+        return h_next, h_next
+
+    if first is None:
+        first = jnp.zeros(log_total.shape[:1], bool)
+    _, states = lax.scan(body, h_in, (jnp.exp(log_total), b_chunks, first))
+    return states
+
+
+def _reshard(value, spec: P):
+    """Put an operand on the layout the manual region declares.
+
+    A mesh axis of size one normalizes away, so a parameter built with
+    `kernel_axes=("tensor", None)` arrives replicated and `shard_map` rejects
+    it against `P("tensor", None)`. Resharding first states the layout.
+    """
+    if value is None:
+        return None
+    return jax.sharding.reshard(value, spec)
+
+
+class Mamba2AttnBackend(LinearRecurrentAttnBackend):
+    """Serving backend for the Nemotron 3 Mamba-2 mixer."""
+
+    def __init__(
+        self,
+        mamba_config=None,
+        mesh: jax.sharding.Mesh = None,
+        activation: str = "silu",
+    ):
+        # `mamba_config` defaults to None so the base class can rebuild the
+        # backend from its pytree, which calls `cls()` with no arguments.
+        super().__init__(mesh=mesh)
+        self.mamba_config = mamba_config
+        self.activation = activation
+
+    # ------------------------------------------------------------------
+    # Cache access. Same shape contract as the KDA backend, one axis wider:
+    # the SSM state is [slots, heads, mamba_head_dim, ssm_state_size], which
+    # is 64 by 128 rather than square.
+    # ------------------------------------------------------------------
+
+    def get_state(self, recurrent_state_pool, layer_id, recurrent_indices):
+        recurrent_buffer, conv_buffer_list = self.get_layer_cache(recurrent_state_pool, layer_id)
+        if len(conv_buffer_list) != 1:
+            raise ValueError(
+                f"Mamba-2 expects one conv buffer per layer, got {len(conv_buffer_list)}"
+            )
+
+        ssm = jax.shard_map(
+            lambda buf, idx: buf[idx],
+            mesh=self.mesh,
+            in_specs=(P("data", "tensor", None, None), P("data")),
+            out_specs=P("data", "tensor", None, None),
+            check_vma=False,
+        )(
+            _reshard(recurrent_buffer, P("data", "tensor", None, None)),
+            _reshard(recurrent_indices, P("data")),
+        )
+
+        conv = jax.shard_map(
+            lambda buf, idx: buf[idx],
+            mesh=self.mesh,
+            in_specs=(P("data", "tensor", None), P("data")),
+            out_specs=P("data", "tensor", None),
+            check_vma=False,
+        )(
+            _reshard(conv_buffer_list[0], P("data", "tensor", None)),
+            _reshard(recurrent_indices, P("data")),
+        )
+
+        has_initial_state = self.forward_metadata.has_initial_state
+        if has_initial_state is not None:
+            ssm = jnp.where(has_initial_state[:, None, None, None], ssm, 0.0)
+            conv = jnp.where(has_initial_state[:, None, None], conv, 0.0)
+        return ssm, conv
+
+    def set_ssm_state(self, recurrent_state_pool, layer_id, recurrent_indices, new_ssm):
+        full_recurrent, _ = self.get_layer_cache(recurrent_state_pool, layer_id)
+
+        def _scatter(buf, idx, val):
+            # Padding rows carry idx 0. Writing them pollutes the dummy slot,
+            # which comes back as another request's initial state.
+            keep = (idx == 0).reshape(-1, 1, 1, 1)
+            return buf.at[idx].set(jnp.where(keep, buf[idx], val))
+
+        return jax.shard_map(
+            _scatter,
+            mesh=self.mesh,
+            in_specs=(
+                P("data", "tensor", None, None),
+                P("data"),
+                P("data", "tensor", None, None),
+            ),
+            out_specs=P("data", "tensor", None, None),
+            check_vma=False,
+        )(
+            _reshard(full_recurrent, P("data", "tensor", None, None)),
+            _reshard(recurrent_indices, P("data")),
+            _reshard(new_ssm, P("data", "tensor", None, None)),
+        )
+
+    def set_conv_state(self, recurrent_state_pool, layer_id, recurrent_indices, new_conv):
+        _, conv_buffer_list = self.get_layer_cache(recurrent_state_pool, layer_id)
+
+        def _scatter(buf, idx, val):
+            keep = (idx == 0).reshape(-1, 1, 1)
+            return buf.at[idx].set(jnp.where(keep, buf[idx], val))
+
+        return [
+            jax.shard_map(
+                _scatter,
+                mesh=self.mesh,
+                in_specs=(P("data", "tensor", None), P("data"), P("data", "tensor", None)),
+                out_specs=P("data", "tensor", None),
+                check_vma=False,
+            )(
+                _reshard(conv_buffer_list[0], P("data", "tensor", None)),
+                _reshard(recurrent_indices, P("data")),
+                _reshard(new_conv, P("data", "tensor", None)),
+            )
+        ]
+
+    def _set_track_state(self, full_buffer, track_indices, track_mask, new_state):
+        """Write `new_state` into each boundary request's track slot as well.
+
+        Takes the buffer `set_ssm_state` or `set_conv_state` returned, so the
+        running slot and the track slot both keep this forward's state. A row
+        keeps what its slot held when the track index is 0, the padding dummy,
+        or the mask is 0, a request that crossed no boundary this forward. The
+        result goes through the same `optimization_barrier` the KDA backend
+        puts on its track write to the donated pool buffer.
+        """
+        spec = P("data", "tensor", *([None] * (full_buffer.ndim - 2)))
+
+        def _scatter(buf, tidx, tmask, val):
+            keep = ((tidx == 0) | (tmask == 0)).reshape(-1, *([1] * (val.ndim - 1)))
+            return buf.at[tidx].set(jnp.where(keep, buf[tidx], val))
+
+        new_full = jax.shard_map(
+            _scatter,
+            mesh=self.mesh,
+            in_specs=(spec, P("data"), P("data"), spec),
+            out_specs=spec,
+            check_vma=False,
+        )(
+            _reshard(full_buffer, spec),
+            _reshard(track_indices, P("data")),
+            _reshard(track_mask, P("data")),
+            _reshard(new_state, spec),
+        )
+        return jax.lax.optimization_barrier(new_full)
+
+    # ------------------------------------------------------------------
+    # Forward
+    # ------------------------------------------------------------------
+
+    @named_scope
+    def __call__(
+        self,
+        q: jax.Array,
+        k: jax.Array,
+        v: jax.Array,
+        a: jax.Array,
+        b: jax.Array,
+        layer,
+        forward_batch: ForwardBatch,
+        recurrent_state_pool,
+        **kwargs,
+    ):
+        """Run the mixer's state path.
+
+        Args:
+          q: [T, conv_dim] the fused conv stream, before the conv. It carries
+            the SSM input, then `B`, then `C`.
+          k, v, b: unused. The signature is the one `HybridLinearAttnBackend`
+            calls every linear backend with.
+          a: [T, H] the raw `dt` projection.
+          layer: the mixer, which holds the conv weight, `A_log`, `dt_bias`
+            and `D`.
+
+        Returns:
+          y: [T, H * mamba_head_dim] the mixer output, before the gated norm.
+          state: `(ssm_buffers, conv_buffers)` for the cache writeback.
+        """
+        del k, v, b
+        cfg = self.mamba_config
+        recurrent_indices = self.forward_metadata.recurrent_indices
+        cu_q_lens = self.forward_metadata.cu_q_lens
+
+        ssm_cache, conv_cache = self.get_state(
+            recurrent_state_pool, layer.layer_id, recurrent_indices
+        )
+
+        xbc, new_conv = self._conv(
+            q, layer.conv1d_weight.value, layer.conv1d_bias, conv_cache, cu_q_lens, forward_batch
+        )
+
+        # The conv stream is one `conv_dim` axis sharded over the tensor mesh,
+        # and the three pieces inside it don't start on a shard edge, so every
+        # reshape below states the layout it wants rather than inferring one.
+        inner = cfg.mamba_num_heads * cfg.mamba_head_dim
+        state_width = cfg.n_groups * cfg.ssm_state_size
+        by_head = jax.sharding.NamedSharding(self.mesh, P("data", "tensor", None))
+        by_group = jax.sharding.NamedSharding(self.mesh, P("data", None, None))
+        x, b_proj, c_proj = jnp.split(xbc, [inner, inner + state_width], axis=-1)
+        x = x.reshape(-1, cfg.mamba_num_heads, cfg.mamba_head_dim, out_sharding=by_head)
+        b_proj = b_proj.reshape(
+            -1, cfg.n_groups, cfg.ssm_state_size, out_sharding=by_group
+        )
+        c_proj = c_proj.reshape(
+            -1, cfg.n_groups, cfg.ssm_state_size, out_sharding=by_group
+        )
+
+        dt, log_decay = discretize(
+            a, layer.dt_bias.value, layer.a_log.value, cfg.time_step_limit
+        )
+
+        # The cache stores [heads, mamba_head_dim, ssm_state_size]; the scan
+        # wants [heads, ssm_state_size, mamba_head_dim].
+        h_in = from_cache_layout(ssm_cache.astype(STATE_DTYPE))
+
+        decode = forward_batch.forward_mode == ForwardMode.DECODE
+        heads_per_group = cfg.heads_per_group
+
+        def _state_path(x, b_proj, c_proj, dt, log_decay, h_in, d, cu):
+            b_local = self._local_groups(b_proj, x.shape[1], heads_per_group)
+            c_local = self._local_groups(c_proj, x.shape[1], heads_per_group)
+            if decode:
+                return self._decode(x, b_local, c_local, dt, log_decay, h_in, d)
+            return self._extend(x, b_local, c_local, dt, log_decay, h_in, d, cu)
+
+        # `B` and `C` stay replicated across the tensor axis. They hold
+        # `n_groups * ssm_state_size` numbers per token against the head
+        # path's `mamba_num_heads * mamba_head_dim`, so replicating them is
+        # cheaper than resharding the group axis.
+        y, new_ssm = jax.shard_map(
+            _state_path,
+            mesh=self.mesh,
+            in_specs=(
+                P("data", "tensor", None),  # x [T, H, P]
+                P("data", None, None),  # B [T, G, N]
+                P("data", None, None),  # C [T, G, N]
+                P("data", "tensor"),  # dt [T, H]
+                P("data", "tensor"),  # log decay [T, H]
+                P("data", "tensor", None, None),  # state [B, H, N, P]
+                P("tensor"),  # D [H]
+                P("data"),  # cu_q_lens [B + 1]
+            ),
+            out_specs=(P("data", "tensor", None), P("data", "tensor", None, None)),
+            check_vma=False,
+        )(
+            _reshard(x, P("data", "tensor", None)),
+            _reshard(b_proj, P("data", None, None)),
+            _reshard(c_proj, P("data", None, None)),
+            _reshard(dt, P("data", "tensor")),
+            _reshard(log_decay, P("data", "tensor")),
+            _reshard(h_in, P("data", "tensor", None, None)),
+            _reshard(layer.d.value, P("tensor")),
+            _reshard(cu_q_lens, P("data")),
+        )
+
+        new_ssm_full = self.set_ssm_state(
+            recurrent_state_pool, layer.layer_id, recurrent_indices, new_ssm
+        )
+        new_conv_full = self.set_conv_state(
+            recurrent_state_pool, layer.layer_id, recurrent_indices, new_conv
+        )
+
+        # The extra buffer's snapshot. The metadata is None when the flag is
+        # off or no request crosses a boundary, and that path compiles as
+        # before.
+        track_indices = self.forward_metadata.recurrent_track_indices
+        if track_indices is not None:
+            track_mask = self.forward_metadata.recurrent_track_mask
+            new_ssm_full = self._set_track_state(
+                new_ssm_full, track_indices, track_mask, new_ssm
+            )
+            new_conv_full = [
+                self._set_track_state(new_conv_full[0], track_indices, track_mask, new_conv)
+            ]
+        return y.reshape(y.shape[0], -1), (new_ssm_full, new_conv_full)
+
+    def _conv(self, xbc, weight, bias, conv_cache, cu_q_lens, forward_batch):
+        """Depthwise causal conv over the fused stream, then the activation.
+
+        The conv is per channel, so a device's stripe of `conv_dim` is
+        self-contained and the manual region needs no collective.
+        """
+        mode = forward_batch.forward_mode
+        bias_value = bias.value if bias is not None else None
+
+        def _call(x, w, cache, cu, b):
+            return short_convolution(x, w, cache, cu, mode, bias=b, activation=self.activation)
+
+        sharded = jax.shard_map(
+            _call,
+            mesh=self.mesh,
+            in_specs=(
+                P("data", "tensor"),  # x [T, conv_dim]
+                P("tensor", None),  # weight [conv_dim, K]
+                P("data", "tensor", None),  # cache [B, conv_dim, K-1]
+                P("data"),  # cu_q_lens [B+1]
+                P("tensor") if bias_value is not None else None,  # bias [conv_dim]
+            ),
+            out_specs=(P("data", "tensor"), P("data", "tensor", None)),
+            check_vma=False,
+        )
+        y, new_cache = sharded(
+            _reshard(xbc, P("data", "tensor")),
+            _reshard(weight, P("tensor", None)),
+            _reshard(conv_cache, P("data", "tensor", None)),
+            _reshard(cu_q_lens, P("data")),
+            _reshard(bias_value, P("tensor")),
+        )
+        return y.astype(STATE_DTYPE), new_cache
+
+    def _local_groups(self, b_proj, heads_local: int, heads_per_group: int):
+        """The `B` or `C` rows this device's heads read.
+
+        `B` and `C` are projected per group and the state path shards by head,
+        so a device holds a slice of the group axis. `n_groups` is 8 at every
+        published size, which is below the tensor axis of a large mesh, so
+        several devices read the same group.
+        """
+        if heads_local % heads_per_group and heads_per_group % heads_local:
+            raise ValueError(
+                f"{heads_local} heads per device don't line up with "
+                f"{heads_per_group} heads per group"
+            )
+        span = max(1, heads_local // heads_per_group)
+        first_head = lax.axis_index("tensor") * heads_local
+        return lax.dynamic_slice_in_dim(b_proj, first_head // heads_per_group, span, axis=1)
+
+    def _decode(self, x, b_proj, c_proj, dt, log_decay, h_in, d):
+        """One token per request.
+
+        h = exp(dt A) h + B (dt x)^T, then y = C . h + D x.
+        """
+        heads = x.shape[1]
+        groups = b_proj.shape[1]
+        repeat = heads // groups
+        bh = jnp.repeat(b_proj.astype(STATE_DTYPE), repeat, axis=1)
+        ch = jnp.repeat(c_proj.astype(STATE_DTYPE), repeat, axis=1)
+        xd = x.astype(STATE_DTYPE) * dt[..., None]
+
+        decay = jnp.exp(log_decay)[..., None, None]
+        h = decay * h_in + bh[..., None] * xd[:, :, None, :]
+        y = jnp.einsum("bhn,bhnp->bhp", ch, h, precision=PRECISION)
+        y = y + d.astype(STATE_DTYPE)[None, :, None] * x.astype(STATE_DTYPE)
+        return y, as_cache_layout(h)
+
+    def _extend(self, x, b_proj, c_proj, dt, log_decay, h_in, d, cu_q_lens):
+        """Packed prefill over a chunk grid that cuts at every request start."""
+        cfg = self.mamba_config
+        tokens = x.shape[0]
+        chunk = cfg.chunk_size
+        token_index, valid, request, first, last_chunk = chunk_grid(cu_q_lens, tokens, chunk)
+        grid_shape = token_index.shape
+
+        def gather(arr):
+            return arr[token_index.reshape(-1)].reshape(*grid_shape, *arr.shape[1:])
+
+        # A padding slot takes dt = 0, so it adds nothing and decays by one.
+        # Its `x` and `B` read zero as well. The gather clamps a padding slot
+        # onto a token of the next request, and a zero weight on that token's
+        # `B` still gives NaN when the value isn't finite. `C` only reaches the
+        # padding slot's own output row, which the scatter below drops.
+        keep = valid[..., None]
+        x_g = jnp.where(keep[..., None], gather(x), 0.0)
+        b_g = jnp.where(keep[..., None], gather(b_proj), 0.0)
+        c_g = gather(c_proj)
+        dt_g = jnp.where(keep, gather(dt), 0.0)
+        g_g = jnp.where(keep, gather(log_decay), 0.0)
+
+        x_flat = x_g.reshape(-1, *x_g.shape[2:])
+        b_flat = b_g.reshape(-1, *b_g.shape[2:])
+        c_flat = c_g.reshape(-1, *c_g.shape[2:])
+        dt_flat = dt_g.reshape(-1, dt_g.shape[-1])
+        g_flat = g_g.reshape(-1, g_g.shape[-1])
+
