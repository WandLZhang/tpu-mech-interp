new file mode 100644
index 00000000..253fe621
--- /dev/null
+++ b/python/sgl_jax/srt/models/nemotron_h.py
@@ -0,0 +1,931 @@
+"""Nemotron 3: Mamba-2, attention and LatentMoE on one irregular stack.
+
+Covers `nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16` and
+`nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-BF16`. Both ship
+`NemotronHForCausalLM` and `model_type: nemotron_h`.
+
+**One sublayer per block.** A block is one norm, one mixer, one residual add.
+The mixer is a Mamba-2 state space layer, a GQA attention layer, a LatentMoE
+layer or a dense MLP, and `configs/nemotron_h.py` reads which from
+`layers_block_type` or `hybrid_override_pattern`. That's why the stack can't be
+one `lax.scan` over layers: neither the weight shapes nor the body repeat.
+
+**Mamba-2.** The mixer projects, then hands the conv stream and `dt` to
+`Mamba2AttnBackend`, which owns the conv state, the SSM state and the chunked
+scan. `layers/attention/mamba/mamba2.py` folds a chunk of tokens into one
+affine step and the backend scans those steps.
+
+**LatentMoE.** The experts don't run at `hidden_size`. The router reads the
+full-width token, `fc1_latent_proj` drops it to `moe_latent_size`, 1,024 on
+Super and 2,048 on Ultra, the experts run there, and `fc2_latent_proj` lifts
+the result back. The reference does the same thing in the same order. Routing
+is top-22 of 512 on both sizes, so the dispatch carries 22 copies of a latent
+token rather than 22 copies of a full one. One shared expert runs at
+`hidden_size` on every token, in parallel with the routed path.
+
+The experts aren't gated: one `up_proj`, `mlp_hidden_act`, one `down_proj`.
+`EPMoE(gated=False)` runs them, which is one grouped matmul per expert GEMM
+rather than two.
+
+**Tensor parallelism.** The gated norm runs `n_groups` RMS groups, 8 at both
+published sizes. A tensor axis wider than 8 splits a group across shards, and
+`GroupRMSNorm` then sums each group with one all-reduce of a `[tokens, 8]`
+array. `num_heads`, `conv_dim`, the latent and the expert count all divide by
+32, so a 32-chip slice shards the whole model.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import jax
+import jax.numpy as jnp
+from flax import nnx
+from jax.sharding import NamedSharding
+from jax.sharding import PartitionSpec as P
+
+from sgl_jax.srt.configs.model_config import ModelConfig
+from sgl_jax.srt.configs.nemotron_h import NemotronHConfig
+from sgl_jax.srt.configs.quantization_config import QuantizationConfig
+from sgl_jax.srt.eplb.expert_location import get_global_server_args
+from sgl_jax.srt.layers.attention.fla.group_rmsnorm import GroupRMSNorm
+from sgl_jax.srt.layers.embeddings import Embed, ParallelLMHead
+from sgl_jax.srt.layers.gate import GateLogit, TopK
+from sgl_jax.srt.layers.layernorm import RMSNorm
+from sgl_jax.srt.layers.linear import LinearBase
+from sgl_jax.srt.layers.logits_processor import LogitsMetadata, LogitsProcessor
+from sgl_jax.srt.layers.moe import EPMoE, create_moe_weights_mapping
+from sgl_jax.srt.layers.radix_attention import RadixAttention
+from sgl_jax.srt.model_executor.forward_batch_info import ForwardBatch
+from sgl_jax.srt.utils.profiling_utils import named_scope
+from sgl_jax.srt.utils.weight_utils import WeightLoader, WeightMapping
+
+logger = logging.getLogger(__name__)
+
+__all__ = [
+    "NemotronHAttention",
+    "NemotronHBlock",
+    "NemotronHForCausalLM",
+    "NemotronHLatentMoE",
+    "NemotronHMLP",
+    "NemotronHMamba2Mixer",
+    "NemotronHModel",
+]
+
+
+def relu2(x: jax.Array) -> jax.Array:
+    """The squared ReLU both published Nemotron 3 feed-forwards use."""
+    return jnp.square(jax.nn.relu(x))
+
+
+# `mlp_hidden_act`, and the two names `EPMoE` runs under the same semantics as
+# the reference `ACT2FN` table. A checkpoint that ships anything else is
+# rejected at build time rather than run as squared ReLU.
+MLP_ACTIVATIONS = {"relu2": relu2, "silu": jax.nn.silu}
+
+
+def mlp_activation(name: str):
+    """The feed-forward activation `mlp_hidden_act` names."""
+    try:
+        return MLP_ACTIVATIONS[name]
+    except KeyError:
+        raise ValueError(
+            f"mlp_hidden_act is {name!r}; this model file runs "
+            f"{sorted(MLP_ACTIVATIONS)}"
+        ) from None
+
+
+def _epmoe_activation(name: str) -> str:
+    """Validate `mlp_hidden_act` and hand the name to `EPMoE`."""
+    mlp_activation(name)
+    return name
+
+
+def _quantization_config(config) -> QuantizationConfig | None:
+    """The quantization `ModelConfig` resolved for this run, or None.
+
+    `ModelConfig` puts a `QuantizationConfig` on the config when the user
+    passes `--quantization-config-path` or the checkpoint ships a format it
+    converts. A `quantization_config` it doesn't convert stays the dict
+    `config.json` carries, and `EPMoE` calls methods on what it gets, so only
+    the object goes through.
+    """
+    quant = getattr(config, "quantization_config", None)
+    return quant if isinstance(quant, QuantizationConfig) else None
+
+
+class NemotronHMamba2Mixer(nnx.Module):
+    """Mamba-2 state space mixer.
+
+    The fused `in_proj` emits three pieces in one GEMM: the gate, the conv
+    stream, and `dt`. The conv stream holds the SSM input, then `B`, then `C`,
+    which is why the depthwise conv runs over `conv_dim` channels rather than
+    the SSM width alone.
+
+    Everything with a cache in it lives in `Mamba2AttnBackend`: the conv state,
+    the SSM state, the chunk grid and the scan. This class holds the weights
+    the backend reads and does the projections around it.
+
+    `in_proj` shards its 18,560 output columns over the tensor axis as one
+    block, and the split into gate, conv stream and `dt` falls at 8,192 and
+    18,432. Neither offset is a multiple of the 2,320 columns a shard owns at
+    a tensor parallel size of 8, so the three slices arrive on the wrong
+    layout and XLA emits a collective-permute per slice to fix it. Compiling
+    the mixer alone on a four-way tensor axis gives 14 of them, against 2
+    all-gathers that replicate `B` and `C` and 2 all-reduces that close
+    `out_proj` and the gated norm's group sum. This runs in 40 of Super's 88
+    layers and 48 of Ultra's 108.
+    """
+
+    def __init__(
+        self,
+        config: NemotronHConfig,
+        mesh: jax.sharding.Mesh,
+        layer_id: int = 0,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.layer_id = layer_id
+        self.config = config
+        self.dtype = dtype
+        self.mesh = mesh
+        self.num_heads = config.mamba_num_heads
+        self.head_dim = config.mamba_head_dim
+        self.intermediate_size = config.mamba_intermediate_size
+        self.conv_dim = config.conv_dim
+        self.activation = config.mamba_hidden_act
+
+        self.in_proj = LinearBase(
+            input_size=config.hidden_size,
+            output_size=config.mamba_in_proj_size,
+            mesh=mesh,
+            use_bias=config.use_bias,
+            kernel_axes=(None, "tensor"),
+            params_dtype=dtype,
+            scope_name="in_proj",
+        )
+
+        # The depthwise kernel is stored [conv_dim, conv_kernel], which is the
+        # layout `short_convolution` consumes. It's a bare parameter because
+        # nothing multiplies by it as a matrix: a `LinearBase` here would match
+        # the linear rules of a quantization config and come back as a
+        # `QuantizedLinear` with no `weight` for the backend to read.
+        self.conv1d_weight = nnx.Param(
+            jnp.zeros(
+                (self.conv_dim, config.conv_kernel), dtype=dtype, out_sharding=P("tensor", None)
+            )
+        )
+        if config.use_conv_bias:
+            self.conv1d_bias = nnx.Param(
+                jnp.zeros((self.conv_dim,), dtype=dtype, out_sharding=P("tensor"))
+            )
+        else:
+            self.conv1d_bias = None
+
+        # `A_log`, `dt_bias` and `D` are one number per head and stay float32:
+        # `A = -exp(A_log)` sets the decay and BF16 there moves the time scale.
+        self.a_log = nnx.Param(
+            jnp.zeros((self.num_heads,), dtype=jnp.float32, out_sharding=P("tensor"))
+        )
+        self.dt_bias = nnx.Param(
+            jnp.zeros((self.num_heads,), dtype=jnp.float32, out_sharding=P("tensor"))
+        )
+        self.d = nnx.Param(
+            jnp.ones((self.num_heads,), dtype=jnp.float32, out_sharding=P("tensor"))
+        )
+
+        # Grouped RMSNorm over the SSM output, gated by the first slice of the
+        # input projection. The gate multiplies before the norm, so the norm
+        # sees the gated value.
+        self.norm = GroupRMSNorm(
+            hidden_size=self.intermediate_size,
+            num_groups=config.n_groups,
+            epsilon=config.layer_norm_epsilon,
+            kernel_axes=("tensor",),
+            mesh=mesh,
+            scope_name="mixer_norm",
+        )
+
+        self.out_proj = LinearBase(
+            input_size=self.intermediate_size,
+            output_size=config.hidden_size,
+            mesh=mesh,
+            use_bias=config.use_bias,
+            kernel_axes=("tensor", None),
+            params_dtype=dtype,
+            scope_name="out_proj",
+        )
+
+    @named_scope
+    def __call__(
+        self,
+        hidden_states: jax.Array,
+        forward_batch: ForwardBatch,
+        recurrent_state_pool,
+    ):
+        projected, _ = self.in_proj(hidden_states)
+        gate, conv_stream, dt = jnp.split(
+            projected, [self.intermediate_size, self.intermediate_size + self.conv_dim], axis=-1
+        )
+
+        y, state = forward_batch.attn_backend(
+            conv_stream,
+            None,
+            None,
+            layer=self,
+            forward_batch=forward_batch,
+            pool=recurrent_state_pool,
+            a=dt,
+            b=None,
+        )
+
+        y = self.norm(y.astype(jnp.float32) * jax.nn.silu(gate.astype(jnp.float32)))
+        out, _ = self.out_proj(y.astype(self.dtype))
+        return out, state
+
+
+class NemotronHAttention(nnx.Module):
+    """GQA with no position encoding. Two KV heads at every published size.
+
+    There's no rotary table and no learned position bias. The attention
+    layers read order from the Mamba-2 layers below them, which is why eight
+    of them are enough for a 262,144 token context. Both published
+    `config.json` files carry `rope_theta` and `partial_rotary_factor`, the
+    reference declares neither and reads neither, and this file does the same.
+    """
+
+    def __init__(
+        self,
+        config: NemotronHConfig,
+        mesh: jax.sharding.Mesh,
+        layer_id: int = 0,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.layer_id = layer_id
+        self.mesh = mesh
+        self.head_dim = config.head_dim
+        self.q_head_num = config.num_attention_heads
+        self.kv_head_num = config.num_key_value_heads
+        self.scaling = self.head_dim**-0.5
+
+        self.q_proj = LinearBase(
+            input_size=config.hidden_size,
+            output_size=self.q_head_num * self.head_dim,
+            mesh=mesh,
+            use_bias=config.attention_bias,
+            kernel_axes=(None, "tensor"),
+            params_dtype=dtype,
+            scope_name="q_proj",
+        )
+        self.k_proj = LinearBase(
+            input_size=config.hidden_size,
+            output_size=self.kv_head_num * self.head_dim,
+            mesh=mesh,
+            use_bias=config.attention_bias,
+            kernel_axes=(None, "tensor"),
+            params_dtype=dtype,
+            scope_name="k_proj",
+        )
+        self.v_proj = LinearBase(
+            input_size=config.hidden_size,
+            output_size=self.kv_head_num * self.head_dim,
+            mesh=mesh,
+            use_bias=config.attention_bias,
+            kernel_axes=(None, "tensor"),
+            params_dtype=dtype,
+            scope_name="v_proj",
+        )
+        self.o_proj = LinearBase(
+            input_size=self.q_head_num * self.head_dim,
+            output_size=config.hidden_size,
+            mesh=mesh,
+            use_bias=config.attention_bias,
+            kernel_axes=("tensor", None),
+            params_dtype=dtype,
+            scope_name="o_proj",
+        )
+
+        self.attn = RadixAttention(
+            num_heads=self.q_head_num,
+            head_dim=self.head_dim,
+            scaling=self.scaling,
+            num_kv_heads=self.kv_head_num,
+            layer_id=layer_id,
+        )
+
+    @named_scope
+    def __call__(
+        self,
+        hidden_states: jax.Array,
+        forward_batch: ForwardBatch,
+        token_to_kv_pool,
+    ):
+        q, _ = self.q_proj(hidden_states)
+        k, _ = self.k_proj(hidden_states)
+        v, _ = self.v_proj(hidden_states)
+
+        shape = NamedSharding(self.mesh, P("data", "tensor", None))
+        q = q.reshape(-1, self.q_head_num, self.head_dim, out_sharding=shape)
+        k = k.reshape(-1, self.kv_head_num, self.head_dim, out_sharding=shape)
+        v = v.reshape(-1, self.kv_head_num, self.head_dim, out_sharding=shape)
+
+        attn_output, kv_fused = self.attn(q, k, v, forward_batch, token_to_kv_pool)
+        out, _ = self.o_proj(attn_output)
+        return out, kv_fused
+
+
+class NemotronHMLP(nnx.Module):
+    """Feed-forward with no gate: up, `mlp_hidden_act`, down."""
+
+    def __init__(
+        self,
+        hidden_size: int,
+        intermediate_size: int,
+        mesh: jax.sharding.Mesh,
+        use_bias: bool = False,
+        activation: str = "relu2",
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.activation = mlp_activation(activation)
+        self.up_proj = LinearBase(
+            input_size=hidden_size,
+            output_size=intermediate_size,
+            mesh=mesh,
+            use_bias=use_bias,
+            kernel_axes=(None, "tensor"),
+            params_dtype=dtype,
+            scope_name="up_proj",
+        )
+        self.down_proj = LinearBase(
+            input_size=intermediate_size,
+            output_size=hidden_size,
+            mesh=mesh,
+            use_bias=use_bias,
+            kernel_axes=("tensor", None),
+            params_dtype=dtype,
+            scope_name="down_proj",
+        )
+
+    @named_scope
+    def __call__(self, hidden_states: jax.Array) -> jax.Array:
+        up, _ = self.up_proj(hidden_states)
+        out, _ = self.down_proj(self.activation(up))
+        return out
+
+
+class NemotronHLatentMoE(nnx.Module):
+    """Top-22 of 512 routed experts in a shared latent, plus one shared expert.
+
+    The routed path is: project the token to `moe_latent_size`, route, run the
+    experts there, project back. The shared expert reads the block input at
+    `hidden_size` and adds to the result.
+
+    The router scores with a sigmoid, adds a per-expert correction bias before
+    the top-k, and takes the weights from the unbiased scores. Group routing is
+    on the config (`n_group`, `topk_group`) and both published sizes set it to
+    one group, which selects every expert.
+    """
+
+    def __init__(
+        self,
+        config: NemotronHConfig,
+        mesh: jax.sharding.Mesh,
+        layer_id: int = 0,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.layer_id = layer_id
+        self.mesh = mesh
+        self.latent_size = config.expert_input_size
+        self.use_latent = config.moe_latent_size is not None
+        if config.mlp_bias:
+            # The reference gives every routed expert a bias under this flag.
+            # `EPMoE` holds one grouped kernel per GEMM and no bias beside it,
+            # so those numbers would load nowhere.
+            raise ValueError(
+                "mlp_bias is set, and EPMoE carries no bias for the routed "
+                "experts, so their bias would be dropped"
+            )
+
+        if self.use_latent:
+            self.fc1_latent_proj = LinearBase(
+                input_size=config.hidden_size,
+                output_size=config.moe_latent_size,
+                mesh=mesh,
+                use_bias=config.mlp_bias,
+                kernel_axes=(None, "tensor"),
+                params_dtype=dtype,
+                scope_name="fc1_latent_proj",
+            )
+            self.fc2_latent_proj = LinearBase(
+                input_size=config.moe_latent_size,
+                output_size=config.hidden_size,
+                mesh=mesh,
+                use_bias=config.mlp_bias,
+                kernel_axes=("tensor", None),
+                params_dtype=dtype,
+                scope_name="fc2_latent_proj",
+            )
+        else:
+            self.fc1_latent_proj = None
+            self.fc2_latent_proj = None
+
+        self.moe_gate = GateLogit(
+            input_size=config.hidden_size,
+            num_experts=config.n_routed_experts,
+            enable_expert_bias=True,
+            weight_dtype=jnp.float32,
+            kernel_dtype=jnp.float32,
+            compute_dtype=jnp.float32,
+            bias_dtype=jnp.float32,
+            score_func="sigmoid",
+        )
+        self.topk = TopK(
+            topk=config.num_experts_per_tok,
+            renormalize=config.norm_topk_prob,
+            num_expert_group=config.n_group,
+            topk_group=config.topk_group,
+            routed_scaling_factor=config.routed_scaling_factor,
+            layer_id=layer_id,
+            mesh=mesh,
+        )
+        self.experts = EPMoE(
+            hidden_size=self.latent_size,
+            num_experts=config.n_routed_experts,
+            num_experts_per_tok=config.num_experts_per_tok,
+            intermediate_dim=config.moe_intermediate_size,
+            ep_size=getattr(config, "ep_size", 1),
+            mesh=mesh,
+            weight_dtype=dtype,
+            dtype=dtype,
+            activation=_epmoe_activation(config.mlp_hidden_act),
+            gated=False,
+            layer_id=layer_id,
+            quantization_config=_quantization_config(config),
+        )
+        self.shared_experts = (
+            NemotronHMLP(
+                hidden_size=config.hidden_size,
+                intermediate_size=config.moe_shared_expert_intermediate_size,
+                mesh=mesh,
+                use_bias=config.mlp_bias,
+                activation=config.mlp_hidden_act,
+                dtype=dtype,
+            )
+            if config.n_shared_experts
+            else None
+        )
+
+    @named_scope
+    def __call__(self, hidden_states: jax.Array, dispatch_info=None) -> jax.Array:
+        router_logits = self.moe_gate(hidden_states)
+        correction_bias = self.moe_gate.bias.value if self.moe_gate.bias is not None else None
+        topk_weights, topk_ids = self.topk(
+            router_logits, correction_bias, dispatch_info=dispatch_info
+        )
+
+        latent = hidden_states
+        if self.use_latent:
+            latent, _ = self.fc1_latent_proj(hidden_states)
+        routed = self.experts(latent, topk_weights, topk_ids)
+        if self.use_latent:
+            # The experts hand back a replicated latent and `fc2_latent_proj`
+            # is row parallel. A `QuantizedLinear`, which a quantization config
+            # swaps in, takes its input only on the layout it contracts over.
+            routed = jax.sharding.reshard(routed, NamedSharding(self.mesh, P("data", "tensor")))
+            routed, _ = self.fc2_latent_proj(routed)
+
+        if self.shared_experts is not None:
+            routed = routed + self.shared_experts(hidden_states)
+        return routed, topk_ids
+
+
+class NemotronHBlock(nnx.Module):
+    """One norm, one mixer, one residual add.
+
+    `hidden_states` and `residual` travel as a pair so the add of the previous
+    block folds into this block's norm, which is the form every sglang-jax
+    model uses. `residual` is None on layer 0.
+    """
+
+    def __init__(
+        self,
+        config: NemotronHConfig,
+        mesh: jax.sharding.Mesh,
+        layer_id: int,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.layer_id = layer_id
+        self.block_type = config.layers_block_type[layer_id]
+        self.norm = RMSNorm(
+            config.hidden_size,
+            epsilon=config.layer_norm_epsilon,
+            param_dtype=dtype,
+            scope_name="norm",
+        )
+        if self.block_type == "mamba":
+            self.mixer = NemotronHMamba2Mixer(config, mesh=mesh, layer_id=layer_id, dtype=dtype)
+        elif self.block_type == "attention":
+            self.mixer = NemotronHAttention(config, mesh=mesh, layer_id=layer_id, dtype=dtype)
+        elif self.block_type == "moe":
+            self.mixer = NemotronHLatentMoE(config, mesh=mesh, layer_id=layer_id, dtype=dtype)
+        elif self.block_type == "mlp":
+            self.mixer = NemotronHMLP(
+                hidden_size=config.hidden_size,
+                intermediate_size=config.intermediate_size,
+                mesh=mesh,
+                use_bias=config.mlp_bias,
+                activation=config.mlp_hidden_act,
+                dtype=dtype,
+            )
+        else:
+            raise ValueError(f"layer {layer_id} has block type {self.block_type!r}")
+
+    def __call__(
+        self,
+        hidden_states: jax.Array,
+        forward_batch: ForwardBatch,
+        memory_pools,
+        residual: jax.Array | None = None,
+        dispatch_info=None,
+    ):
+        if residual is not None:
+            hidden_states += residual
+        residual = hidden_states
+        hidden_states = self.norm(hidden_states)
+
+        state = None
+        topk_ids = None
+        if self.block_type == "mamba":
+            hidden_states, state = self.mixer(
+                hidden_states, forward_batch, memory_pools.recurrent_state_pool
+            )
+        elif self.block_type == "attention":
+            hidden_states, state = self.mixer(
+                hidden_states, forward_batch, memory_pools.token_to_kv_pool
+            )
+        elif self.block_type == "moe":
+            hidden_states, topk_ids = self.mixer(hidden_states, dispatch_info=dispatch_info)
+        else:
+            hidden_states = self.mixer(hidden_states)
+
+        return hidden_states, residual, state, topk_ids
+
+
+class NemotronHModel(nnx.Module):
+    """The backbone: embeddings, the block stack, the final norm."""
+
+    def __init__(
+        self,
+        config: NemotronHConfig,
+        mesh: jax.sharding.Mesh,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        self.config = config
+        self.embed_tokens = Embed(
+            num_embeddings=config.vocab_size,
+            features=config.hidden_size,
+            dtype=dtype,
+            param_dtype=dtype,
+            kernel_axes=("tensor", None),
+            mesh=mesh,
+        )
+        # One block per entry of the block list. No two adjacent layers share a
+        # type on either published size, so nothing stacks into a scan and the
+        # loop stays flat.
+        self.layers = nnx.data(
+            [
+                NemotronHBlock(config, mesh=mesh, layer_id=layer_id, dtype=dtype)
+                for layer_id in range(config.num_hidden_layers)
+            ]
+        )
+        self.norm = RMSNorm(
+            config.hidden_size,
+            epsilon=config.layer_norm_epsilon,
+            param_dtype=dtype,
+            scope_name="norm",
+        )
+
+    def __call__(self, forward_batch: ForwardBatch, memory_pools):
+        hidden_states = (
+            self.embed_tokens(forward_batch.input_ids)
+            if forward_batch.input_embedding is None
+            else forward_batch.input_embedding
+        )
+        residual = None
+        layers_kv_fused = []
+        layers_recurrent = []
+        layers_conv = []
+        layers_topk_ids = []
+
+        for layer in self.layers:
+            hidden_states, residual, state, topk_ids = layer(
+                hidden_states,
+                forward_batch,
+                memory_pools,
+                residual,
+                dispatch_info=forward_batch.expert_location_metadata,
+            )
+            if layer.block_type == "mamba":
+                recurrent_buffer, conv_buffers = state
+                layers_recurrent.append(recurrent_buffer)
+                layers_conv.append(conv_buffers)
+            elif layer.block_type == "attention":
+                layers_kv_fused.append(state)
+            # One entry per layer, `None` on a layer that routes nothing.
+            # `RoutedExpertsCapturer` indexes this list by layer id.
+            layers_topk_ids.append(topk_ids)
+
+        if residual is not None:
+            hidden_states += residual
+        hidden_states = self.norm(hidden_states)
+        return (
+            hidden_states,
+            layers_kv_fused,
+            (layers_recurrent, layers_conv),
+            layers_topk_ids,
+        )
+
+
+class NemotronHForCausalLM(nnx.Module):
+    """Entry class. `NemotronHForCausalLM` in both checkpoints."""
+
+    @classmethod
+    def check_server_args(cls, server_args, model_config=None) -> None:
+        """Refuse the expert-placement flags before any weight loads.
+
+        `--ep-dispatch-algorithm`, `--init-expert-location` and
+        `--ep-num-redundant-experts` place the routed experts through
+        expert-location metadata. The engine builds that metadata only for a
+        config that sets `num_experts`, and this config names the count
+        `n_routed_experts`. The weight mapping loads every expert in checkpoint
+        order and the router routes in that order, so the flags would change
+        nothing. `__init__` runs this on the server args the runner publishes
+        before it builds the model. `model_config` isn't read; it keeps the
+        two-argument form of a worker hook that checks a model class.
+        """
+        flags = []
+        algorithm = getattr(server_args, "ep_dispatch_algorithm", None)
+        if algorithm is not None:
+            flags.append(f"--ep-dispatch-algorithm {algorithm}")
+        redundant = getattr(server_args, "ep_num_redundant_experts", 0)
+        if redundant:
+            flags.append(f"--ep-num-redundant-experts {redundant}")
+        location = getattr(server_args, "init_expert_location", None)
+        if location not in (None, "trivial"):
+            flags.append(f"--init-expert-location {location}")
+        if flags:
+            raise ValueError(
+                f"{cls.__name__} can't serve with {', '.join(flags)}. It loads every routed "
+                "expert in checkpoint order and builds no expert-location metadata, so these "
+                "flags would change nothing; drop them."
+            )
+
+    def __init__(
+        self,
+        config: NemotronHConfig,
+        mesh: jax.sharding.Mesh,
+        dtype: jnp.dtype = jnp.bfloat16,
+    ):
+        server_args = get_global_server_args()
+        if server_args is not None:
+            self.check_server_args(server_args)
+        quant = _quantization_config(config)
+        if quant is not None and quant.is_static_checkpoint:
+            # The mapping below names weights and no scale tensors, so a
+            # pre-quantized checkpoint can't load through it. Refuse it here,
+            # before any weight moves.
+            raise NotImplementedError(
+                "this checkpoint ships pre-quantized weights, and the Nemotron 3 weight "
+                "mapping reads no scale tensors; serve the BF16 checkpoint and quantize "
+                "it at load with --quantization-config-path"
+            )
+        self.config = config
+        self.mesh = mesh
+        self.dtype = dtype
+        self.model = NemotronHModel(config, mesh=mesh, dtype=dtype)
+        if not getattr(config, "tie_word_embeddings", False):
+            self.lm_head = ParallelLMHead(
+                config.vocab_size,
+                config.hidden_size,
+                dtype=dtype,
+                param_dtype=dtype,
+                mesh=mesh,
+                enable_dp_lm_head=getattr(config, "enable_dp_lm_head", False),
+            )
+        self.logits_processor = LogitsProcessor(
+            config.vocab_size,
+            mesh=mesh,
+            enable_dp_lm_head=getattr(config, "enable_dp_lm_head", False),
+        )
+
+    def __call__(
+        self,
+        forward_batch: ForwardBatch,
+        memory_pools,
+        logits_metadata: LogitsMetadata,
+    ):
+        hidden_states, layers_kv_fused, layers_recurrent_state, layers_topk_ids = self.model(
+            forward_batch, memory_pools
+        )
+        if not getattr(self.config, "tie_word_embeddings", False):
+            output = self.logits_processor(hidden_states, self.lm_head, logits_metadata)
+        else:
+            output = self.logits_processor(
+                hidden_states, self.model.embed_tokens, logits_metadata
+            )
+        return (
+            output,
+            {
+                "token_to_kv_pool": layers_kv_fused,
+                "recurrent_state_pool": layers_recurrent_state,
+            },
+            True,
+            layers_topk_ids,
+        )
+
+    # ------------------------------------------------------------------
+    # Weights
+    # ------------------------------------------------------------------
+
+    def load_weights(self, model_config: ModelConfig):
+        loader = WeightLoader(
+            model=self,
+            model_config=model_config,
+            mesh=self.mesh,
+            dtype=self.dtype,
+        )
+        loader.load_weights_from_safetensors(self._create_weight_mappings())
+        logger.info("Nemotron 3 weights loaded successfully!")
+
+    def _create_weight_mappings(self) -> dict:
+        """Checkpoint key to parameter path.
+
+        The checkpoint calls the backbone `backbone`, the embedding
+        `embeddings` and the final norm `norm_f`.
+        """
+        mappings = {
+            "backbone.embeddings.weight": WeightMapping(
+                target_path="model.embed_tokens.embedding",
+                sharding=("tensor", None),
+                transpose=False,
+            ),
+            "backbone.norm_f.weight": WeightMapping(
+                target_path="model.norm.scale", sharding=(None,), transpose=False
+            ),
+        }
+        if not getattr(self.config, "tie_word_embeddings", False):
+            mappings["lm_head.weight"] = WeightMapping(
+                target_path="lm_head.embedding", sharding=("tensor", None), transpose=False
+            )
+        for layer_id, block_type in enumerate(self.config.layers_block_type):
+            mappings.update(self._create_layer_mappings(layer_id, block_type))
+        return mappings
+
+    def _create_layer_mappings(self, layer_id: int, block_type: str) -> dict:
+        config = self.config
+        prefix = f"backbone.layers.{layer_id}"
+        target = f"model.layers.{layer_id}"
+
+        mappings = {
+            f"{prefix}.norm.weight": WeightMapping(
+                target_path=f"{target}.norm.scale", sharding=(None,), transpose=False
+            ),
+        }
+
+        def projection(name: str, sharding, bias: bool, **kwargs):
+            """A `LinearBase` weight, and its bias when the config asks for one.
+
+            `LinearBase` shards a bias over the last axis of its kernel, so a
+            column-parallel projection shards the bias and a row-parallel one
+            replicates it.
+            """
+            out = {
+                f"{prefix}.mixer.{name}.weight": WeightMapping(
