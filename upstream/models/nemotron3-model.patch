--- /dev/null
+++ b/python/sgl_jax/srt/configs/nemotron_h.py
@@ -0,0 +1,436 @@
+"""Config and layer plan for the Nemotron 3 hybrid stack.
+
+Nemotron 3 doesn't repeat one layer shape, so the engine can't wrap the whole
+stack in a single `lax.scan` over layers. Each layer is a Mamba-2 mixer, an
+attention mixer, or a feed-forward, and the types interleave on a cycle whose
+period changes down the stack. The MoE sizes spell the feed-forward `moe`;
+Nano spells it `mlp`.
+
+Two spellings of the same field exist. Super and Nano ship
+`hybrid_override_pattern`, a string over `M`, `E`, `*` and `-`. Ultra ships
+`layers_block_type`, a list over `"mamba"`, `"moe"`, `"attention"` and
+`"mlp"`. `block_types` reads either spelling and returns the list form, and
+`num_hidden_layers` comes from its length. A config `transformers` saved
+names the two mixers `"linear_attention"` and `"full_attention"`, and
+`block_types` reads those as `"mamba"` and `"attention"`.
+
+`cache_plan` splits the layer indices the two cache managers own. Mamba-2
+layers need an SSM state slot and a conv state slot, neither of which depends
+on sequence length. Attention layers need KV pages that grow with it.
+
+`NemotronHConfig` exposes those lists to the runner under the names the
+hybrid recurrent path already reads: `linear_layer_ids`,
+`full_attention_layer_ids` and `linear_state_params`.
+"""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Iterable, Sequence
+
+from transformers.configuration_utils import PretrainedConfig
+
+__all__ = [
+    "BLOCK_TYPES",
+    "NemotronHConfig",
+    "RECURRENT_BLOCK_TYPES",
+    "block_types",
+    "cache_plan",
+    "mtp_block_types",
+    "pattern",
+]
+
+
+BLOCK_TYPES = ("mamba", "moe", "attention", "mlp")
+
+# Types that carry a recurrent state across chunks, so `mamba2.py` folds a
+# chunk into one affine step and `mamba2_backend.py` scans those steps.
+RECURRENT_BLOCK_TYPES = ("mamba",)
+
+_PATTERN_TO_TYPE = {"M": "mamba", "E": "moe", "*": "attention", "-": "mlp"}
+_TYPE_TO_PATTERN = {v: k for k, v in _PATTERN_TO_TYPE.items()}
+
+# The names `transformers` 5.17 writes. Its `NemotronHConfig` renames the
+# mixers when it loads a config and saves them under the new names, so a
+# re-saved checkpoint carries these in place of the published ones.
+_TRANSFORMERS_TYPES = {"linear_attention": "mamba", "full_attention": "attention"}
+
+
+def _from_pattern(text: str) -> list[str]:
+    """Expand the `M`/`E`/`*` string into the list form."""
+    unknown = sorted(set(text) - set(_PATTERN_TO_TYPE))
+    if unknown:
+        raise ValueError(
+            f"hybrid_override_pattern holds unknown symbols {unknown}; "
+            f"allowed: {sorted(_PATTERN_TO_TYPE)}"
+        )
+    return [_PATTERN_TO_TYPE[char] for char in text]
+
+
+def _validate(types: Sequence[str], field: str) -> list[str]:
+    """Return the list form, or raise naming the bad entries."""
+    if isinstance(types, str):
+        raise ValueError(f"{field} must be a list of strings, not a string")
+    out = [_TRANSFORMERS_TYPES.get(t, t) for t in types]
+    if not out:
+        raise ValueError(f"{field} is empty, so the stack has no layers")
+    unknown = sorted(set(out) - set(BLOCK_TYPES))
+    if unknown:
+        raise ValueError(
+            f"{field} holds unknown block types {unknown}; allowed: {list(BLOCK_TYPES)}"
+        )
+    return out
+
+
+def block_types(config: dict) -> list[str]:
+    """Per-layer block types, read from either spelling of the field.
+
+    Args:
+      config: a parsed `config.json`, or any dict holding
+        `layers_block_type` or `hybrid_override_pattern`.
+
+    Returns:
+      One entry per layer, each one of `BLOCK_TYPES`.
+
+    Raises:
+      ValueError: neither field is present, an entry is unknown, or
+        `num_hidden_layers` disagrees with the length. The reference config
+        class only warns on that last one and trusts the list. An engine that
+        sizes its stack from the count builds the wrong model, so reject it.
+    """
+    if "layers_block_type" in config:
+        found = _validate(config["layers_block_type"], "layers_block_type")
+    elif "hybrid_override_pattern" in config:
+        found = _validate(
+            _from_pattern(config["hybrid_override_pattern"]), "hybrid_override_pattern"
+        )
+    else:
+        raise ValueError(
+            "config holds neither layers_block_type nor hybrid_override_pattern, "
+            "so the layer stack is undefined"
+        )
+
+    declared = config.get("num_hidden_layers")
+    if declared is not None and declared != len(found):
+        raise ValueError(
+            f"num_hidden_layers is {declared} but the block list holds {len(found)} layers"
+        )
+    return found
+
+
+def mtp_block_types(config: dict) -> list[str]:
+    """Block types of the multi-token prediction head.
+
+    Returns an empty list when `num_nextn_predict_layers` is 0 or absent. The
+    head repeats for each predicted token, so the returned list covers one
+    repeat.
+    """
+    if not config.get("num_nextn_predict_layers"):
+        return []
+    if "mtp_layers_block_type" in config:
+        return _validate(config["mtp_layers_block_type"], "mtp_layers_block_type")
+    if "mtp_hybrid_override_pattern" in config:
+        return _validate(
+            _from_pattern(config["mtp_hybrid_override_pattern"]),
+            "mtp_hybrid_override_pattern",
+        )
+    raise ValueError(
+        "num_nextn_predict_layers is set but no MTP block list is present"
+    )
+
+
+def pattern(types: Iterable[str]) -> str:
+    """Pack the list form back into the `M`/`E`/`*`/`-` string.
+
+    Raises:
+      ValueError: an entry isn't one of `BLOCK_TYPES`.
+    """
+    out = []
+    for t in types:
+        if t not in _TYPE_TO_PATTERN:
+            raise ValueError(
+                f"{t!r} is not a block type; allowed: {list(BLOCK_TYPES)}"
+            )
+        out.append(_TYPE_TO_PATTERN[t])
+    return "".join(out)
+
+
+def cache_plan(types: Sequence[str]) -> dict[str, list[int]]:
+    """Which layers each cache manager owns.
+
+    Args:
+      types: the resolved block type list of the stack the engine builds.
+
+    Returns:
+      `recurrent`: layers holding an SSM state and a conv state. Both sizes
+        are fixed per sequence, so neither pages.
+      `paged`: layers holding KV, which grows with the sequence.
+      `stateless`: the rest, which hold nothing between tokens.
+    """
+    plan: dict[str, list[int]] = {"recurrent": [], "paged": [], "stateless": []}
+    for i, block in enumerate(_validate(types, "block types")):
+        if block in RECURRENT_BLOCK_TYPES:
+            plan["recurrent"].append(i)
+        elif block == "attention":
+            plan["paged"].append(i)
+        else:
+            plan["stateless"].append(i)
+    return plan
+
+
+class NemotronHConfig(PretrainedConfig):
+    """Nemotron 3 config, in either spelling of the layer field.
+
+    The checkpoint ships `configuration_nemotron_h.py` beside the weights and
+    the engine refuses remote code, so the fields it reads live here.
+
+    `num_hidden_layers` is derived from the block list. A config that ships
+    both and disagrees is rejected: an engine that sizes its stack from the
+    count builds the wrong model. Setting `num_hidden_layers` on a built config
+    cuts the stack to its first blocks, which is how `--model-layer-nums` and a
+    `num_hidden_layers` override reach it.
+
+    The layer field has no default, so `NemotronHConfig()` raises.
+    `has_no_defaults_at_init` tells `PretrainedConfig.to_diff_dict` to skip
+    the default instance it otherwise builds to diff against. Without it every
+    `repr`, every `to_json_string` and every `save_pretrained` raises, and
+    `from_dict` logs the config it just built, so `AutoConfig` can't load the
+    published `config.json` at all.
+    """
+
+    model_type = "nemotron_h"
+    keys_to_ignore_at_inference = ["past_key_values"]
+    has_no_defaults_at_init = True
+
+    def __init__(
+        self,
+        vocab_size: int = 131072,
+        hidden_size: int = 4096,
+        intermediate_size: int = 2688,
+        layers_block_type: Sequence[str] | None = None,
+        hybrid_override_pattern: str | None = None,
+        num_hidden_layers: int | None = None,
+        # Attention.
+        num_attention_heads: int = 32,
+        num_key_value_heads: int = 2,
+        head_dim: int = 128,
+        attention_bias: bool = False,
+        max_position_embeddings: int = 262144,
+        # Mamba-2.
+        mamba_num_heads: int = 128,
+        mamba_head_dim: int = 64,
+        ssm_state_size: int = 128,
+        n_groups: int = 8,
+        conv_kernel: int = 4,
+        chunk_size: int = 128,
+        use_conv_bias: bool = True,
+        mamba_hidden_act: str = "silu",
+        mamba_ssm_cache_dtype: str = "float32",
+        time_step_min: float = 1e-3,
+        time_step_max: float = 0.1,
+        mamba_dt_limit: Sequence[float] = (0.0, math.inf),
+        # Feed-forward and LatentMoE.
+        mlp_hidden_act: str = "relu2",
+        mlp_bias: bool = False,
+        use_bias: bool = False,
+        n_routed_experts: int = 512,
+        num_experts_per_tok: int = 22,
+        n_shared_experts: int = 1,
+        moe_intermediate_size: int = 2688,
+        moe_latent_size: int | None = 1024,
+        moe_shared_expert_intermediate_size: int = 5376,
+        n_group: int = 1,
+        topk_group: int = 1,
+        norm_topk_prob: bool = True,
+        routed_scaling_factor: float = 5.0,
+        # Norms and heads.
+        layer_norm_epsilon: float = 1e-5,
+        tie_word_embeddings: bool = False,
+        num_nextn_predict_layers: int = 0,
+        mtp_layers_block_type: Sequence[str] | None = None,
+        mtp_hybrid_override_pattern: str | None = None,
+        pad_token_id: int = 0,
+        bos_token_id: int = 1,
+        eos_token_id: int = 2,
+        **kwargs,
+    ):
+        source = {}
+        if layers_block_type is not None:
+            source["layers_block_type"] = layers_block_type
+        if hybrid_override_pattern is not None:
+            source["hybrid_override_pattern"] = hybrid_override_pattern
+        if num_hidden_layers is not None:
+            source["num_hidden_layers"] = num_hidden_layers
+        self.layers_block_type = block_types(source)
+        self.hybrid_override_pattern = pattern(self.layers_block_type)
+
+        self.vocab_size = vocab_size
+        self.hidden_size = hidden_size
+        self.intermediate_size = intermediate_size
+
+        self.num_attention_heads = num_attention_heads
+        self.num_key_value_heads = num_key_value_heads
+        self.head_dim = head_dim
+        self.attention_bias = attention_bias
+        # `rope_theta` and `partial_rotary_factor` ride in on `**kwargs`.
+        # Attention carries no position encoding, so nothing reads them, and
+        # the reference config class doesn't declare them either.
+        self.max_position_embeddings = max_position_embeddings
+
+        self.mamba_num_heads = mamba_num_heads
+        self.mamba_head_dim = mamba_head_dim
+        self.ssm_state_size = ssm_state_size
+        self.n_groups = n_groups
+        self.conv_kernel = conv_kernel
+        self.chunk_size = chunk_size
+        self.use_conv_bias = use_conv_bias
+        self.mamba_hidden_act = mamba_hidden_act
+        self.mamba_ssm_cache_dtype = mamba_ssm_cache_dtype
+        # `time_step_min` and `time_step_max` bound the range the `dt_bias`
+        # initializer draws over. The runtime clamp is `mamba_dt_limit`, which
+        # the config class exposes as `time_step_limit`, and neither published
+        # `config.json` overrides its (0.0, inf) default. Megatron-LM trains
+        # with that pair, and NVIDIA's CUDA kernels and vLLM serve with it.
+        # The torch paths floor `dt` at `time_step_min` instead: transformers
+        # 5.17 in prefill, and NVIDIA's `torch_forward` in prefill and decode.
+        self.time_step_min = time_step_min
+        self.time_step_max = time_step_max
+        # A config this class wrote back out carries the resolved spelling.
+        low, high = kwargs.pop("time_step_limit", None) or mamba_dt_limit
+        if not 0.0 <= low <= high:
+            raise ValueError(
+                f"mamba_dt_limit is {(low, high)}; it has to be a "
+                "non-negative (low, high) pair"
+            )
+        self.time_step_limit = (float(low), float(high))
+
+        self.mlp_hidden_act = mlp_hidden_act
+        self.mlp_bias = mlp_bias
+        self.use_bias = use_bias
+        self.n_routed_experts = n_routed_experts
+        self.num_experts_per_tok = num_experts_per_tok
+        self.n_shared_experts = n_shared_experts
+        self.moe_intermediate_size = moe_intermediate_size
+        self.moe_latent_size = moe_latent_size
+        self.moe_shared_expert_intermediate_size = moe_shared_expert_intermediate_size
+        self.n_group = n_group
+        self.topk_group = topk_group
+        self.norm_topk_prob = norm_topk_prob
+        self.routed_scaling_factor = routed_scaling_factor
+
+        self.layer_norm_epsilon = layer_norm_epsilon
+        self.rms_norm_eps = layer_norm_epsilon
+        self.num_nextn_predict_layers = num_nextn_predict_layers
+        mtp_source = {"num_nextn_predict_layers": num_nextn_predict_layers}
+        if mtp_layers_block_type is not None:
+            mtp_source["mtp_layers_block_type"] = mtp_layers_block_type
+        if mtp_hybrid_override_pattern is not None:
+            mtp_source["mtp_hybrid_override_pattern"] = mtp_hybrid_override_pattern
+        self.mtp_layers_block_type = mtp_block_types(mtp_source)
+
+        super().__init__(
+            pad_token_id=pad_token_id,
+            bos_token_id=bos_token_id,
+            eos_token_id=eos_token_id,
+            tie_word_embeddings=tie_word_embeddings,
+            **kwargs,
+        )
+
+    # `num_hidden_layers` is a length, not a field: the block list decides it.
+    # A write after construction cuts the stack to its first `value` blocks.
+    # `ModelConfig` writes it for `--model-layer-nums`, and `get_config` writes
+    # it for a `num_hidden_layers` entry in `--json-model-override-args`.
+    @property
+    def num_hidden_layers(self) -> int:
+        return len(self.layers_block_type)
+
+    @num_hidden_layers.setter
+    def num_hidden_layers(self, value) -> None:
+        count = len(self.layers_block_type)
+        if value is None or value == count:
+            return
+        if not 0 < value < count:
+            raise ValueError(
+                f"num_hidden_layers is {value}, and the block list holds {count} layers; "
+                f"a write can cut the stack to between 1 and {count} layers"
+            )
+        self.layers_block_type = self.layers_block_type[:value]
+        self.hybrid_override_pattern = pattern(self.layers_block_type)
+
+    @property
+    def mamba_intermediate_size(self) -> int:
+        """Channels the SSM runs over. The conv carries `B` and `C` on top."""
+        return self.mamba_num_heads * self.mamba_head_dim
+
+    @property
+    def conv_dim(self) -> int:
+        """Channels the depthwise conv runs over: the SSM input, then B and C."""
+        return self.mamba_intermediate_size + 2 * self.n_groups * self.ssm_state_size
+
+    @property
+    def mamba_in_proj_size(self) -> int:
+        """The fused input projection: gate, then the conv stream, then `dt`."""
+        return self.mamba_intermediate_size + self.conv_dim + self.mamba_num_heads
+
+    @property
+    def expert_input_size(self) -> int:
+        """Width the routed experts run at. The latent, when there's one."""
+        return self.moe_latent_size or self.hidden_size
+
+    @property
+    def linear_layer_ids(self) -> list[int]:
+        """Layers holding a recurrent state. The runner sizes the state pool."""
+        return cache_plan(self.layers_block_type)["recurrent"]
+
+    @property
+    def full_attention_layer_ids(self) -> list[int]:
+        """Layers holding KV. The runner sizes the paged pool from these."""
+        return cache_plan(self.layers_block_type)["paged"]
+
+    @property
+    def linear_state_params(self):
+        """What `RecurrentStatePool` allocates per Mamba-2 layer.
+
+        The SSM state is `[mamba_num_heads, mamba_head_dim, ssm_state_size]`,
+        which isn't square: 64 by 128 at every published size. The pool reads
+        the second dim from `head_dim` and the third from `head_k_dim`.
+
+        The conv state is `[conv_dim, conv_kernel - 1]`. The pool builds that
+        width as `num_heads * head_dim + 2 * num_k_heads * head_k_dim`, so
+        `num_k_heads` carries the group count and `head_k_dim` the state size.
+
+        `mamba_ssm_cache_dtype` is float32 while the weights ship BF16, so the
+        SSM slot costs twice what the weight dtype suggests. The conv state
+        feeds the same float32 accumulation, so it takes the same dtype.
+        """
+        import jax.numpy as jnp
+
+        from sgl_jax.srt.mem_cache.recurrent_state_pool import (
+            LinearRecurrentStateParams,
+            RecurrentStateDType,
+        )
+
+        cache_dtype = jnp.dtype(self.mamba_ssm_cache_dtype)
+        return LinearRecurrentStateParams(
+            layers=self.linear_layer_ids,
+            num_heads=self.mamba_num_heads,
+            head_dim=self.mamba_head_dim,
+            conv_kernel_size=self.conv_kernel,
+            dtype=RecurrentStateDType(conv=cache_dtype, temporal=cache_dtype),
+            num_k_heads=self.n_groups,
+            head_k_dim=self.ssm_state_size,
+        )
+
+    def mamba_config(self):
+        """The `Mamba2Config` the chunked scan reads."""
+        from sgl_jax.srt.layers.attention.mamba.mamba2 import Mamba2Config
+
+        return Mamba2Config(
+            ssm_state_size=self.ssm_state_size,
+            mamba_num_heads=self.mamba_num_heads,
+            mamba_head_dim=self.mamba_head_dim,
+            n_groups=self.n_groups,
+            conv_kernel=self.conv_kernel,
+            chunk_size=self.chunk_size,
+            time_step_limit=tuple(self.time_step_limit),
+        )
