+                    target_path=f"{target}.mixer.{name}.bias",
+                    sharding=sharding[-1:],
+                    transpose=False,
+                    **kwargs,
+                )
+            return out
+
+        if block_type == "mamba":
+            mappings.update(projection("in_proj", (None, "tensor"), config.use_bias))
+            mappings.update(projection("out_proj", ("tensor", None), config.use_bias))
+            mappings.update(
+                {
+                    # HF ships the depthwise kernel as [conv_dim, 1, K].
+                    f"{prefix}.mixer.conv1d.weight": WeightMapping(
+                        target_path=f"{target}.mixer.conv1d_weight",
+                        sharding=("tensor", None),
+                        transpose=False,
+                        reshape=(config.conv_dim, config.conv_kernel),
+                    ),
+                    f"{prefix}.mixer.A_log": WeightMapping(
+                        target_path=f"{target}.mixer.a_log",
+                        sharding=("tensor",),
+                        transpose=False,
+                    ),
+                    f"{prefix}.mixer.dt_bias": WeightMapping(
+                        target_path=f"{target}.mixer.dt_bias",
+                        sharding=("tensor",),
+                        transpose=False,
+                    ),
+                    f"{prefix}.mixer.D": WeightMapping(
+                        target_path=f"{target}.mixer.d",
+                        sharding=("tensor",),
+                        transpose=False,
+                    ),
+                    f"{prefix}.mixer.norm.weight": WeightMapping(
+                        target_path=f"{target}.mixer.norm.weight",
+                        sharding=("tensor",),
+                        transpose=False,
+                    ),
+                }
+            )
+            if config.use_conv_bias:
+                mappings[f"{prefix}.mixer.conv1d.bias"] = WeightMapping(
+                    target_path=f"{target}.mixer.conv1d_bias",
+                    sharding=("tensor",),
+                    transpose=False,
+                )
+        elif block_type == "attention":
+            for name, sharding in (
+                ("q_proj", (None, "tensor")),
+                ("k_proj", (None, "tensor")),
+                ("v_proj", (None, "tensor")),
+                ("o_proj", ("tensor", None)),
+            ):
+                mappings.update(
+                    projection(
+                        name,
+                        sharding,
+                        config.attention_bias,
+                        kv_head_padding=name in ("k_proj", "v_proj"),
+                    )
+                )
+        elif block_type == "moe":
+            mappings.update(
+                {
+                    f"{prefix}.mixer.gate.weight": WeightMapping(
+                        target_path=f"{target}.mixer.moe_gate.kernel",
+                        sharding=(None, None),
+                        transpose=True,
+                    ),
+                    f"{prefix}.mixer.gate.e_score_correction_bias": WeightMapping(
+                        target_path=f"{target}.mixer.moe_gate.bias",
+                        sharding=(None,),
+                    ),
+                }
+            )
+            mappings.update(
+                projection(
+                    "shared_experts.up_proj", (None, "tensor"), config.mlp_bias
+                )
+            )
+            mappings.update(
+                projection(
+                    "shared_experts.down_proj", ("tensor", None), config.mlp_bias
+                )
+            )
+            if config.moe_latent_size is not None:
+                mappings.update(
+                    projection("fc1_latent_proj", (None, "tensor"), config.mlp_bias)
+                )
+                mappings.update(
+                    projection("fc2_latent_proj", ("tensor", None), config.mlp_bias)
+                )
+            mappings.update(
+                create_moe_weights_mapping(
+                    prefix=prefix,
+                    target_prefix=target,
+                    num_experts=config.n_routed_experts,
+                    expert_type_names=("up_proj", None, "down_proj"),
+                    moe_backend="epmoe",
+                    moe_path="mixer.experts",
+                    source_expert_pattern="{i}",
+                    gated=False,
+                )
+            )
+        elif block_type == "mlp":
+            mappings.update(projection("up_proj", (None, "tensor"), config.mlp_bias))
+            mappings.update(projection("down_proj", ("tensor", None), config.mlp_bias))
+        return mappings
+
+    def get_embed_and_head(self):
+        return (self.model.embed_tokens.embedding.value, self.lm_head.embedding.value)
+
+    def set_embed_and_head(self, embed_weight=None, head_weight=None) -> None:
+        if embed_weight is not None:
+            self.model.embed_tokens.embedding.value = embed_weight
+        if head_weight is not None:
+            self.lm_head.embedding.value = head_weight
+
+
+EntryClass = NemotronHForCausalLM
