@@ -0,0 +1,125 @@
+"""Config for GLM-5.3-Flash (`model_type: glm5_next`).
+
+The published `config.json` nests the language model under `text_config`. `transformers` ships
+`Glm5NextConfig` from 5.16, and `sglang-jax` pins 5.12, so the engine registers this class for
+`glm5_next` instead. It flattens `text_config` onto itself, so `get_hf_text_config` returns the
+config itself and every text field sits at the top, and it fills the defaults
+`Glm5NextTextConfig.__post_init__` fills.
+
+Four fields move so the engine sizes nothing from them:
+
+- `quantization_config` goes to `checkpoint_quantization_config`. The engine reads
+  `quant_method: fp8` as a request to serve FP8 linears, and this model widens its FP8 weights to
+  the serving dtype in its own loader.
+- `layer_types` goes to `attn_layer_types`. `ModelConfig.get_hybrid_layer_counts` reads
+  `layer_types` for sliding-window layers.
+- `num_key_value_heads` is 1 and `head_dim` 256. The model keeps every cache in its own pool, and
+  the runner's paged KV pool, which nothing reads, then costs 1 KiB a token.
+- `vision_config` stays aside. Only the text backbone loads.
+"""
+
+from __future__ import annotations
+
+from transformers import PretrainedConfig
+
+# Glm5NextTextConfig's defaults for fields a config may leave out.
+_DEFAULTS = {
+    "vocab_size": 154880,
+    "hidden_size": 4096,
+    "intermediate_size": 12288,
+    "moe_intermediate_size": 2048,
+    "num_hidden_layers": 45,
+    "num_attention_heads": 64,
+    "n_shared_experts": 1,
+    "n_routed_experts": 288,
+    "routed_scaling_factor": 2.5,
+    "kv_lora_rank": 512,
+    "q_lora_rank": 1536,
+    "qk_rope_head_dim": 0,
+    "v_head_dim": 256,
+    "qk_nope_head_dim": 256,
+    "n_group": 1,
+    "topk_group": 1,
+    "num_experts_per_tok": 8,
+    "norm_topk_prob": True,
+    "hidden_act": "silu",
+    "max_position_embeddings": 1048576,
+    "rms_norm_eps": 1e-5,
+    "index_topk": 2048,
+    "index_head_dim": 128,
+    "index_n_heads": 32,
+    "swiglu_limit": 10.0,
+    "linear_head_dim": 128,
+    "linear_num_heads": 64,
+    "linear_conv_kernel_dim": 4,
+    "linear_lower_bound": -5.0,
+    "hc_mult": 4,
+    "hc_eps": 1e-6,
+    "hc_sinkhorn_iters": 20,
+    "index_kpool": 16,
+    "index_kpool_always_select_tail": True,
+    "tie_word_embeddings": False,
+}
+
+
+class Glm5NextServingConfig(PretrainedConfig):
+    model_type = "glm5_next"
+
+    def __init__(self, text_config=None, vision_config=None, **kwargs):
+        quant = kwargs.pop("quantization_config", None)
+        if quant is not None:
+            kwargs.setdefault("checkpoint_quantization_config", quant)
+        if hasattr(text_config, "to_dict"):
+            text_config = text_config.to_dict()
+        text = dict(text_config or {})
+        text.pop("model_type", None)
+        text.update({k: v for k, v in kwargs.items() if k != "architectures"})
+        for key, value in _DEFAULTS.items():
+            text.setdefault(key, value)
+        linear = text.get("linear_attn_config")
+        if linear is not None:
+            text["linear_head_dim"] = linear.get("head_dim", text["linear_head_dim"])
+            text["linear_num_heads"] = linear.get("num_heads", text["linear_num_heads"])
+            text["linear_conv_kernel_dim"] = linear.get(
+                "short_conv_kernel_size", text["linear_conv_kernel_dim"]
+            )
+            text["linear_lower_bound"] = linear.get("gate_lower_bound", text["linear_lower_bound"])
+            if linear.get("safe_gate", True) and text["linear_lower_bound"] is None:
+                text["linear_lower_bound"] = -5.0
+        n = int(text["num_hidden_layers"])
+        layer_types = text.pop("layer_types", None)
+        if layer_types is None:
+            layer_types = [
+                "linear_attention" if i % 4 != 3 else "deepseek_sparse_attention" for i in range(n)
+            ]
+        text["attn_layer_types"] = [
+            "deepseek_sparse_attention" if t == "full_attention" else t for t in layer_types
+        ]
+        if text.get("mlp_layer_types") is None:
+            text["mlp_layer_types"] = ["dense"] * min(3, n) + ["sparse"] * max(n - 3, 0)
+        if text.get("indexer_types") is None:
+            text["indexer_types"] = ["full"] * n
+        text["qk_head_dim"] = int(text["qk_nope_head_dim"]) + int(text["qk_rope_head_dim"])
+        text["published_num_key_value_heads"] = text.get("num_key_value_heads")
+        text["num_key_value_heads"] = 1
+        text["head_dim"] = text["qk_head_dim"]
+        self.vision_config = vision_config
+        if "architectures" in kwargs:
+            text["architectures"] = kwargs["architectures"]
+        super().__init__(**text)
+        for key, value in text.items():
+            if not hasattr(self, key):
+                setattr(self, key, value)
+        self.head_dim = int(text["head_dim"])
+        self.v_head_dim = int(text["v_head_dim"])
+        self.num_key_value_heads = 1
+
+    def __setattr__(self, key, value):
+        # `--model-layer-nums` and a `num_hidden_layers` override write the count; the per-layer
+        # lists follow it, so a cut stack keeps a consistent plan.
+        super().__setattr__(key, value)
+        if key == "num_hidden_layers" and isinstance(value, int):
+            for name in ("attn_layer_types", "mlp_layer_types", "indexer_types"):
+                current = self.__dict__.get(name)
+                if isinstance(current, list) and len(current) > value:
+                    super().__setattr__(name, current[:value])
